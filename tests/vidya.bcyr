# vidya.bcyr — vidya benchmarks
# Benchmarks: loader, registry lookup, search, compare
#
# Run: cyrius bench tests/vidya.bcyr
#   or: cyrius build tests/vidya.bcyr /tmp/vidya_bench && /tmp/vidya_bench

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"   # cyrius 6.1.x: json + toml + base64 bundled here
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/regex.cyr"
include "lib/syscalls.cyr"

# 2.8.1: to_cstr and cstr_contains used to be inlined here as copies of
# the main.cyr originals. They now come from src/vidya_core.cyr along
# with the JSON builders benchmarked below — same source as the binary
# serves and the test suite asserts on.
include "src/vidya_core.cyr"

# ================================================================
# Globals for benchmark callbacks
# ================================================================

var _b_reg = 0;
var _b_sections = 0;
var _b_desc = 0;      # a real corpus description Str, for the field benches

# ================================================================
# Benchmark functions
# ================================================================

# Load a single concept TOML
fn bench_load_concept() {
    var s = toml_parse_file("content/strings/concept.toml");
    return 0;
}

# Load all concept.toml files from content/
fn bench_load_all() {
    var dirs = dir_list(str_from("content"));
    var count = 0;
    var i = 0;
    while (i < vec_len(dirs)) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                toml_parse_file(str_data(tpath));
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

# Registry lookup (hit)
fn bench_reg_get_hit() {
    map_get(_b_reg, "strings");
    return 0;
}

# Registry lookup (miss)
fn bench_reg_get_miss() {
    map_get(_b_reg, "nonexistent_xyzzy");
    return 0;
}

# Search: scan 35 topics for substring
fn bench_search() {
    var entries = map_keys(_b_reg);
    var count = vec_len(entries);
    var found = 0;
    var i = 0;
    while (i < count) {
        var key = vec_get(entries, i);
        if (cstr_contains(key, "string") == 1) { found = found + 1; }
        i = i + 1;
    }
    return found;
}

# TOML section extraction
fn bench_toml_sections() {
    var bps = toml_get_sections(_b_sections, str_from("best_practices"));
    var gs = toml_get_sections(_b_sections, str_from("gotchas"));
    var ps = toml_get_sections(_b_sections, str_from("performance_notes"));
    return vec_len(bps) + vec_len(gs) + vec_len(ps);
}

# ================================================================
# JSON response builders (added 2.8.1)
# ================================================================
# These call the real builders in src/vidya_core.cyr against the real
# corpus registry, so the per-field escaping the injection fix added
# is measured here rather than only observed on the wire.

fn bench_json_info() {
    json_info_response("strings");
    return 0;
}

fn bench_json_search() {
    json_search_response("string");
    return 0;
}

fn bench_json_list() {
    json_list_response();
    return 0;
}

# Escaping overhead in isolation: the same description Str emitted with
# the escape path and with the old bare-quote splice. The delta is what
# JSON-safety costs per field.
fn bench_field_escaped() {
    var sb = str_builder_new();
    json_add_str(sb, _b_desc);
    str_builder_build(sb);
    return 0;
}

fn bench_field_raw() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\"");
    str_builder_add(sb, _b_desc);
    str_builder_add_cstr(sb, "\"");
    str_builder_build(sb);
    return 0;
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();

    # Setup: build a registry with all topic IDs
    _b_reg = map_new();
    var dirs = dir_list(str_from("content"));
    var i = 0;
    while (i < vec_len(dirs)) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                var sections = toml_parse_file(str_data(tpath));
                if (vec_len(sections) > 0) {
                    var top = vec_get(sections, 0);
                    var pairs = toml_section_pairs(top);
                    var id_str = toml_get(pairs, str_from("id"));
                    if (id_str != 0) {
                        var cid = to_cstr(id_str);
                        map_set(_b_reg, cid, 1);
                    }
                }
            }
        }
        i = i + 1;
    }

    # Setup: load strings sections for TOML bench
    _b_sections = toml_parse_file("content/strings/concept.toml");

    # Setup: a real registry for the JSON builder benches
    reg_init();
    load_all();
    var strings_c = reg_get("strings");
    if (strings_c != 0) { _b_desc = concept_desc(strings_c); }

    # Run benchmarks
    var benches = vec_new();

    var b1 = bench_new("load_concept");
    bench_run(b1, &bench_load_concept, 100);
    vec_push(benches, b1);

    var b2 = bench_new("load_all");
    bench_run(b2, &bench_load_all, 10);
    vec_push(benches, b2);

    var b3 = bench_new("reg_get_hit");
    bench_run(b3, &bench_reg_get_hit, 10000);
    vec_push(benches, b3);

    var b4 = bench_new("reg_get_miss");
    bench_run(b4, &bench_reg_get_miss, 10000);
    vec_push(benches, b4);

    var b5 = bench_new("search_text");
    bench_run(b5, &bench_search, 1000);
    vec_push(benches, b5);

    var b6 = bench_new("toml_sections");
    bench_run(b6, &bench_toml_sections, 1000);
    vec_push(benches, b6);

    var b7 = bench_new("json_info_response");
    bench_run(b7, &bench_json_info, 1000);
    vec_push(benches, b7);

    var b8 = bench_new("json_search_response");
    bench_run(b8, &bench_json_search, 200);
    vec_push(benches, b8);

    var b9 = bench_new("json_list_response");
    bench_run(b9, &bench_json_list, 100);
    vec_push(benches, b9);

    var b10 = bench_new("field_escaped");
    bench_run(b10, &bench_field_escaped, 10000);
    vec_push(benches, b10);

    var b11 = bench_new("field_raw_splice");
    bench_run(b11, &bench_field_raw, 10000);
    vec_push(benches, b11);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
