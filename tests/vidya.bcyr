# vidya.bcyr — vidya benchmarks
# Benchmarks: loader, registry lookup, search, compare
#
# Run: cyrius bench tests/vidya.bcyr
#   or: cyrius build tests/vidya.bcyr /tmp/vidya_bench && /tmp/vidya_bench

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"   # cyrius 6.1.x: json + toml + base64 bundled here
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/regex.cyr"
include "lib/syscalls.cyr"

# ================================================================
# Helpers — inline from main.cyr
# ================================================================

fn to_cstr(s) {
    if (s == 0) { return ""; }
    var len = str_len(s);
    var buf = alloc(len + 1);
    memcpy(buf, str_data(s), len);
    store8(buf + len, 0);
    return buf;
}

fn cstr_contains(haystack, needle) {
    if (haystack == 0 || needle == 0) { return 0; }
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var i = 0;
    while (i <= hlen - nlen) {
        if (memeq(haystack + i, needle, nlen) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ascii_fold(b) {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

fn cstr_lower(c) {
    if (c == 0) { return ""; }
    var len = strlen(c);
    var buf = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(buf + i, ascii_fold(load8(c + i)));
        i = i + 1;
    }
    store8(buf + len, 0);
    return buf;
}

# Current production path — folded scan straight over str_data, no copy
fn str_has_ci(s, folded) {
    if (s == 0) { return 0; }
    var hd = str_data(s);
    var hlen = str_len(s);
    var nlen = strlen(folded);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var f0 = load8(folded);
    var last = hlen - nlen;
    var i = 0;
    while (i <= last) {
        if (ascii_fold(load8(hd + i)) == f0) {
            var j = 1;
            while (j < nlen && ascii_fold(load8(hd + i + j)) == load8(folded + j)) {
                j = j + 1;
            }
            if (j == nlen) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Former production path — null-terminated copy per field, then a
# byte-exact memeq scan. Kept as a comparator so the case-folding
# delta is measured against what search() actually cost, not against
# the cheaper no-copy shape the 2.8.1 bench happened to time.
fn str_has_exact(s, query) {
    if (s == 0) { return 0; }
    return cstr_contains(to_cstr(s), query);
}

# ================================================================
# Globals for benchmark callbacks
# ================================================================

var _b_reg = 0;
var _b_sections = 0;
var _b_ids = 0;      # vec of Str topic ids — the shape search() scans

# ================================================================
# Benchmark functions
# ================================================================

# Load a single concept TOML
fn bench_load_concept() {
    var s = toml_parse_file("content/strings/concept.toml");
    return 0;
}

# Load all concept.toml files from content/
fn bench_load_all() {
    var dirs = dir_list(str_from("content"));
    var count = 0;
    var i = 0;
    while (i < vec_len(dirs)) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                toml_parse_file(str_data(tpath));
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

# Registry lookup (hit)
fn bench_reg_get_hit() {
    map_get(_b_reg, "strings");
    return 0;
}

# Registry lookup (miss)
fn bench_reg_get_miss() {
    map_get(_b_reg, "nonexistent_xyzzy");
    return 0;
}

# Search: one substring probe per topic id (77), through the current
# production path — query ASCII-folded once, then a folded scan over
# each field's raw bytes.
#
# NB: through 2.8.1 this bench probed the already-null-terminated
# hashmap keys, so it never paid the to_cstr copy that search() made
# for every field. Its 9.5us therefore timed a shape production did
# not have. bench_search_exact below restores that copy so the two
# numbers are comparable; see BENCHMARKS.md.
fn bench_search() {
    var count = vec_len(_b_ids);
    var folded = cstr_lower("string");
    var found = 0;
    var i = 0;
    while (i < count) {
        if (str_has_ci(vec_get(_b_ids, i), folded) == 1) { found = found + 1; }
        i = i + 1;
    }
    return found;
}

# Same scope, former path: copy each field to a C string, then scan
# byte-exact. This is what search() cost before case folding landed.
fn bench_search_exact() {
    var count = vec_len(_b_ids);
    var found = 0;
    var i = 0;
    while (i < count) {
        if (str_has_exact(vec_get(_b_ids, i), "string") == 1) { found = found + 1; }
        i = i + 1;
    }
    return found;
}

# TOML section extraction
# NB: toml_get / toml_get_sections take **cstr** keys, not Str. Passing
# str_from("...") silently returns 0 / an empty vec — it does not error.
# Through 2.8.0 every key here was str_from(), so this bench (and the
# _b_reg setup below, hence reg_get_hit / reg_get_miss / search_text)
# measured an empty input. Same trap the .tcyr flags at its toml_loader
# group; see field-note stdlib_str_to_cstr_key_migration.
fn bench_toml_sections() {
    var bps = toml_get_sections(_b_sections, "best_practices");
    var gs = toml_get_sections(_b_sections, "gotchas");
    var ps = toml_get_sections(_b_sections, "performance_notes");
    return vec_len(bps) + vec_len(gs) + vec_len(ps);
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();

    # Setup: build a registry with all topic IDs
    _b_reg = map_new();
    _b_ids = vec_new();
    var dirs = dir_list(str_from("content"));
    var i = 0;
    while (i < vec_len(dirs)) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                var sections = toml_parse_file(str_data(tpath));
                if (vec_len(sections) > 0) {
                    var top = vec_get(sections, 0);
                    var pairs = toml_section_pairs(top);
                    var id_str = toml_get(pairs, "id");
                    if (id_str != 0) {
                        var cid = to_cstr(id_str);
                        map_set(_b_reg, cid, 1);
                        vec_push(_b_ids, id_str);
                    }
                }
            }
        }
        i = i + 1;
    }

    # Setup: load strings sections for TOML bench
    _b_sections = toml_parse_file("content/strings/concept.toml");

    # Run benchmarks
    var benches = vec_new();

    var b1 = bench_new("load_concept");
    bench_run(b1, &bench_load_concept, 100);
    vec_push(benches, b1);

    var b2 = bench_new("load_all");
    bench_run(b2, &bench_load_all, 10);
    vec_push(benches, b2);

    var b3 = bench_new("reg_get_hit");
    bench_run(b3, &bench_reg_get_hit, 10000);
    vec_push(benches, b3);

    var b4 = bench_new("reg_get_miss");
    bench_run(b4, &bench_reg_get_miss, 10000);
    vec_push(benches, b4);

    var b5 = bench_new("search_text");
    bench_run(b5, &bench_search, 1000);
    vec_push(benches, b5);

    var b6 = bench_new("search_text_exact");
    bench_run(b6, &bench_search_exact, 1000);
    vec_push(benches, b6);

    var b7 = bench_new("toml_sections");
    bench_run(b7, &bench_toml_sections, 1000);
    vec_push(benches, b7);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
