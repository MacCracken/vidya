# vidya.tcyr — vidya library tests
# Tests: loader, registry, search, compare, language enum
#
# Run: cyrius test tests/vidya.tcyr
#   or: cyrius build tests/vidya.tcyr /tmp/vidya_test && /tmp/vidya_test

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"   # cyrius 6.1.x: json + toml + base64 bundled here
include "lib/regex.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"

# Pull in vidya types + functions from main (we re-include the core parts)
# For now, inline the helpers we need since main.cyr is a full CLI binary.

# ================================================================
# Language helpers (subset from main.cyr)
# ================================================================

fn lang_stem(lang) {
    if (lang == 0) { return "rust"; }
    if (lang == 1) { return "python"; }
    if (lang == 2) { return "c"; }
    if (lang == 3) { return "go"; }
    if (lang == 4) { return "typescript"; }
    if (lang == 5) { return "shell"; }
    if (lang == 6) { return "zig"; }
    if (lang == 7) { return "asm_x86_64"; }
    if (lang == 8) { return "asm_aarch64"; }
    if (lang == 9) { return "openqasm"; }
    if (lang == 10) { return "cyrius"; }
    return "";
}

fn lang_extension(lang) {
    if (lang == 0) { return "rs"; }
    if (lang == 1) { return "py"; }
    if (lang == 2) { return "c"; }
    if (lang == 3) { return "go"; }
    if (lang == 4) { return "ts"; }
    if (lang == 5) { return "sh"; }
    if (lang == 6) { return "zig"; }
    if (lang == 7) { return "s"; }
    if (lang == 8) { return "s"; }
    if (lang == 9) { return "qasm"; }
    if (lang == 10) { return "cyr"; }
    return "";
}

fn lang_parse(s) {
    if (streq(s, "rust") == 1 || streq(s, "rs") == 1) { return 0; }
    if (streq(s, "python") == 1 || streq(s, "py") == 1) { return 1; }
    if (streq(s, "c") == 1) { return 2; }
    if (streq(s, "go") == 1) { return 3; }
    if (streq(s, "cyrius") == 1 || streq(s, "cyr") == 1) { return 10; }
    return 0 - 1;
}

# ================================================================
# Search helpers (subset from main.cyr — kept byte-identical)
# ================================================================

fn ascii_fold(b) {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

fn cstr_lower(c) {
    if (c == 0) { return ""; }
    var len = strlen(c);
    var buf = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(buf + i, ascii_fold(load8(c + i)));
        i = i + 1;
    }
    store8(buf + len, 0);
    return buf;
}

fn str_has_ci(s, folded) {
    if (s == 0) { return 0; }
    var hd = str_data(s);
    var hlen = str_len(s);
    var nlen = strlen(folded);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var f0 = load8(folded);
    var last = hlen - nlen;
    var i = 0;
    while (i <= last) {
        if (ascii_fold(load8(hd + i)) == f0) {
            var j = 1;
            while (j < nlen && ascii_fold(load8(hd + i + j)) == load8(folded + j)) {
                j = j + 1;
            }
            if (j == nlen) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Tag-array parser (subset from main.cyr load path) — ["a", "b"] -> vec of Str.
# NB: each Str points into the raw TOML buffer and is NOT null-terminated;
# that is what the removed "pending Str null-termination fix" comment feared.
fn parse_tags(tags_raw) {
    var tags = vec_new();
    if (tags_raw == 0) { return tags; }
    var td = str_data(tags_raw);
    var tl = str_len(tags_raw);
    var ti = 0;
    while (ti < tl) {
        if (load8(td + ti) == 34) {
            ti = ti + 1;
            var ts = ti;
            while (ti < tl && load8(td + ti) != 34) { ti = ti + 1; }
            vec_push(tags, str_new(td + ts, ti - ts));
            if (ti < tl) { ti = ti + 1; }
        } else {
            ti = ti + 1;
        }
    }
    return tags;
}

# Case-insensitive match of `query` against a tag vec
fn tags_have_ci(tags, query) {
    var folded = cstr_lower(query);
    var n = vec_len(tags);
    var i = 0;
    while (i < n) {
        if (str_has_ci(vec_get(tags, i), folded) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Tests
# ================================================================

fn main() {
    alloc_init();

    # --- Language enum ---
    test_group("language");
    assert(streq(lang_stem(0), "rust") == 1, "rust stem");
    assert(streq(lang_extension(0), "rs") == 1, "rust ext");
    assert(streq(lang_stem(10), "cyrius") == 1, "cyrius stem");
    assert(streq(lang_extension(10), "cyr") == 1, "cyrius ext");
    assert_eq(lang_parse("rust"), 0, "parse rust");
    assert_eq(lang_parse("rs"), 0, "parse rs");
    assert_eq(lang_parse("cyrius"), 10, "parse cyrius");
    assert_eq(lang_parse("cyr"), 10, "parse cyr");
    assert_eq(lang_parse("unknown"), 0 - 1, "parse unknown");

    # --- TOML loading ---
    test_group("toml_loader");
    var sections = toml_parse_file("content/strings/concept.toml");
    assert(vec_len(sections) > 0, "toml has sections");
    var top = vec_get(sections, 0);
    var pairs = toml_section_pairs(top);
    # NB: cyrius 5.x toml_get takes cstr keys, not Str — using
    # str_from("id") silently returns 0 (see field-note
    # stdlib_str_to_cstr_key_migration).
    var id = toml_get(pairs, "id");
    assert(id != 0, "id exists");
    assert(str_eq_cstr(id, "strings") == 1, "id is strings");
    var title = toml_get(pairs, "title");
    assert(title != 0, "title exists");
    assert(str_eq_cstr(title, "Strings") == 1, "title is Strings");
    var topic = toml_get(pairs, "topic");
    assert(topic != 0, "topic exists");
    var desc = toml_get(pairs, "description");
    assert(desc != 0, "description exists");
    assert(str_len(desc) > 0, "description non-empty");

    # --- TOML sections ---
    test_group("toml_sections");
    var bps = toml_get_sections(sections, "best_practices");
    assert(vec_len(bps) >= 5, "at least 5 best_practices");
    var gotchas = toml_get_sections(sections, "gotchas");
    assert(vec_len(gotchas) >= 3, "at least 3 gotchas");
    var pnotes = toml_get_sections(sections, "performance_notes");
    assert(vec_len(pnotes) >= 1, "at least 1 performance_note");

    # --- Gotcha fields ---
    test_group("gotcha_fields");
    var g0 = vec_get(gotchas, 0);
    var gpairs = toml_section_pairs(g0);
    var gt = toml_get(gpairs, "title");
    assert(gt != 0, "gotcha has title");
    var gb = toml_get(gpairs, "bad_example");
    assert(gb != 0, "gotcha has bad_example");
    var gg = toml_get(gpairs, "good_example");
    assert(gg != 0, "gotcha has good_example");

    # --- Registry (hashmap) ---
    test_group("registry");
    var reg = map_new();
    map_set(reg, "strings", 42);
    map_set(reg, "concurrency", 99);
    assert_eq(map_get(reg, "strings"), 42, "get strings");
    assert_eq(map_get(reg, "concurrency"), 99, "get concurrency");
    assert_eq(map_get(reg, "missing"), 0, "get missing returns 0");
    assert(map_has(reg, "strings") == 1, "has strings");
    assert(map_has(reg, "missing") == 0, "has missing");
    assert_eq(map_count(reg), 2, "count is 2");

    # --- File discovery ---
    test_group("file_discovery");
    assert(file_exists("content/strings/rust.rs") == 1, "rust.rs exists");
    assert(file_exists("content/strings/python.py") == 1, "python.py exists");
    assert(file_exists("content/strings/cyrius.cyr") == 1, "cyrius.cyr exists");
    assert(file_exists("content/strings/nonexistent.xyz") == 0, "nonexistent absent");

    # --- Content directory scan ---
    test_group("content_scan");
    var dirs = dir_list(str_from("content"));
    var ndirs = vec_len(dirs);
    assert(ndirs >= 35, "at least 35 content dirs");

    # --- Load all topics ---
    test_group("load_all");
    var topic_count = 0;
    var i = 0;
    while (i < ndirs) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                topic_count = topic_count + 1;
            }
        }
        i = i + 1;
    }
    assert(topic_count >= 35, "at least 35 topics with concept.toml");

    # --- Search (substring matching) ---
    test_group("search");
    # Use cstr_contains for simple substring search
    assert(memeq("strings", "string", 6) == 1, "substring match");
    assert(memeq("concurrency", "concur", 6) == 1, "concur match");
    assert(str_has_ci(str_from("strings"), "ring") == 1, "substring hit");
    assert(str_has_ci(str_from("strings"), "zebra") == 0, "substring miss");
    assert(str_has_ci(str_from("strings"), "") == 1, "empty query matches");
    assert(str_has_ci(str_from("ab"), "abc") == 0, "query longer than field");
    assert(str_has_ci(str_from("strings"), "strings") == 1, "whole-field match");
    assert(str_has_ci(str_from("strings"), "s") == 1, "single-byte query");
    assert(str_has_ci(str_from(""), "s") == 0, "empty field, non-empty query");
    # Leading-byte fast path must not stop at the first candidate start:
    # "aab" has a false start at index 0 before the real match at 1.
    assert(str_has_ci(str_from("aab"), "ab") == 1, "match after false start");
    assert(str_has_ci(str_from("abcabd"), "abd") == 1, "second candidate wins");

    # --- Search: ASCII case folding (regression) ---
    # Search used to be a byte-exact scan: `vidya search tcp` found
    # nothing while `vidya search TCP` found 2 topics.
    test_group("search_case_fold");
    assert_eq(ascii_fold(65), 97, "fold A -> a");
    assert_eq(ascii_fold(90), 122, "fold Z -> z");
    assert_eq(ascii_fold(97), 97, "fold a stays a");
    assert_eq(ascii_fold(64), 64, "fold @ untouched (below A)");
    assert_eq(ascii_fold(91), 91, "fold [ untouched (above Z)");
    assert_eq(ascii_fold(53), 53, "fold digit untouched");
    assert_eq(ascii_fold(226), 226, "fold UTF-8 lead byte untouched");
    assert(streq(cstr_lower("TCP"), "tcp") == 1, "cstr_lower TCP");
    assert(streq(cstr_lower("HashMap"), "hashmap") == 1, "cstr_lower HashMap");
    assert(streq(cstr_lower("already"), "already") == 1, "cstr_lower idempotent");
    assert(streq(cstr_lower(""), "") == 1, "cstr_lower empty");
    # The reported repro, both directions
    assert(str_has_ci(str_from("TCP and UDP socket lifecycle"), cstr_lower("tcp")) == 1,
      "lowercase query hits uppercase text");
    assert(str_has_ci(str_from("tcp and udp"), cstr_lower("TCP")) == 1,
      "uppercase query hits lowercase text");
    assert(str_has_ci(str_from("Vec vs HashMap"), cstr_lower("hashmap")) == 1,
      "hashmap hits HashMap");
    assert(str_has_ci(str_from("Strings"), cstr_lower("zebra")) == 0,
      "case fold does not invent matches");
    assert(str_has_ci(0, cstr_lower("tcp")) == 0, "null Str is a miss");

    # --- Search: tags are searched (regression) ---
    # content-format.md documents `tags` as "Search tags", but the tag
    # branch was commented out "pending Str null-termination fix". The
    # tag Strs point into the raw TOML buffer with no terminator; the
    # to_cstr_lower copy is what makes them safe to scan.
    test_group("search_tags");
    var stags = parse_tags(toml_get(pairs, "tags"));
    assert(vec_len(stags) >= 5, "strings has at least 5 tags");
    assert(tags_have_ci(stags, "interpolation") == 1, "tag interpolation found");
    assert(tags_have_ci(stags, "INTERPOLATION") == 1, "tag match is case-insensitive");
    assert(tags_have_ci(stags, "unicode") == 1, "tag unicode found");
    assert(tags_have_ci(stags, "nosuchtag") == 0, "absent tag is a miss");
    # `interpolation` appears in no id/title/description — tags are the only route
    assert(str_has_ci(id, cstr_lower("interpolation")) == 0, "not in id");
    assert(str_has_ci(title, cstr_lower("interpolation")) == 0, "not in title");
    assert(str_has_ci(desc, cstr_lower("interpolation")) == 0, "not in description");

    # --- HTTP path routing shape ---
    # tcyr can't bind a port, so we just sanity-check the path-prefix
    # matches that http_route uses. The actual end-to-end smoke test
    # for /compare and /gaps lives in scripts (see CHANGELOG 2.3.4).
    test_group("http_routes");
    assert(memeq("/compare?topic=x&left=rust&right=python", "/compare", 8) == 1, "/compare prefix");
    assert(streq("/gaps", "/gaps") == 1, "/gaps exact match");
    assert(memeq("/info/algorithms", "/info/", 6) == 1, "/info/ prefix");
    assert(memeq("/search?q=x", "/search", 7) == 1, "/search prefix");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
