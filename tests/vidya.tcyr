# vidya.tcyr — vidya library tests
# Tests: loader, registry, search, compare, language enum, JSON builders
#
# Run: cyrius test tests/vidya.tcyr
#   or: cyrius build tests/vidya.tcyr /tmp/vidya_test && /tmp/vidya_test
#
# 2.8.1: this file used to re-implement lang_stem/lang_extension/lang_parse
# locally and exercised ZERO functions from src/main.cyr — which is exactly
# how two shipped bugs in the HTTP surface survived to release (/info
# reporting boolean 1 instead of real counts, and /search splicing the raw
# query into the response body). The testable half of main.cyr now lives in
# src/vidya_core.cyr and is included here, so the assertions below run the
# same code the binary serves. DCE strips whatever this file's main() never
# reaches.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"   # cyrius 6.1.x: json + toml + base64 bundled here
include "lib/regex.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/fnptr.cyr"
include "lib/sandhi.cyr"
include "lib/vyakarana.cyr"
include "lib/sakshi.cyr"
include "lib/assert.cyr"
include "lib/process.cyr"   # exec_cmd — subprocess contract behind `vidya validate`

include "src/vidya_core.cyr"

# ================================================================
# Test helpers
# ================================================================

# Structure-level JSON check: every string terminated, brackets
# balanced, no raw control byte inside a string. NOT a full parser —
# it cannot tell a legitimate document from an injected-but-balanced
# one, which is why the escaping tests below also assert exact bytes
# and round-trips. What it does buy is a cheap net that can be swept
# across the whole corpus.
fn json_wellformed(s) {
    if (s == 0) { return 0; }
    var depth = 0;
    var in_str = 0;
    var esc = 0;
    var i = 0;
    var ok = 1;
    while (load8(s + i) != 0 && ok == 1) {
        var c = load8(s + i);
        if (in_str == 1) {
            if (esc == 1) { esc = 0; }
            elif (c == 92) { esc = 1; }
            elif (c == 34) { in_str = 0; }
            elif (c < 32) { ok = 0; }
        } else {
            if (c == 34) { in_str = 1; }
            elif (c == 123 || c == 91) { depth = depth + 1; }
            elif (c == 125 || c == 93) {
                depth = depth - 1;
                if (depth < 0) { ok = 0; }
            }
        }
        i = i + 1;
    }
    if (in_str == 1) { ok = 0; }
    if (depth != 0) { ok = 0; }
    return ok;
}

# Index of needle in haystack, or -1. (cstr_contains in vidya_core
# answers yes/no; the decoder below needs the position.)
fn cstr_find(h, n) {
    var hl = strlen(h);
    var nl = strlen(n);
    var i = 0;
    var at = 0 - 1;
    while (i + nl <= hl && at < 0) {
        if (memeq(h + i, n, nl) == 1) { at = i; }
        i = i + 1;
    }
    return at;
}

fn hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

# Decode the JSON string value that follows "<key>": in `json`, undoing
# the escapes sandhi_json_escape emits (\" \\ \b \t \n \f \r \u00XX).
# Returns 0 if the key is absent. This is the consumer's-eye view: what
# agnoshi or hoosh would actually read back out of the field.
fn json_value_of(json, key) {
    var kb = str_builder_new();
    str_builder_add_cstr(kb, "\"");
    str_builder_add_cstr(kb, key);
    str_builder_add_cstr(kb, "\":\"");
    var needle = str_data(str_builder_build(kb));
    var at = cstr_find(json, needle);
    if (at < 0) { return 0; }

    var i = at + strlen(needle);
    var out = str_builder_new();
    var done = 0;
    while (done == 0) {
        var c = load8(json + i);
        if (c == 0) { done = 1; }
        elif (c == 34) { done = 1; }
        elif (c == 92) {
            var e = load8(json + i + 1);
            if (e == 110) { str_builder_add_byte(out, 10); i = i + 2; }
            elif (e == 116) { str_builder_add_byte(out, 9); i = i + 2; }
            elif (e == 114) { str_builder_add_byte(out, 13); i = i + 2; }
            elif (e == 98) { str_builder_add_byte(out, 8); i = i + 2; }
            elif (e == 102) { str_builder_add_byte(out, 12); i = i + 2; }
            elif (e == 117) {
                # \u00XX — vidya only ever emits control bytes this way,
                # so the two low hex digits carry the whole value.
                var hi = hexval(load8(json + i + 4));
                var lo = hexval(load8(json + i + 5));
                str_builder_add_byte(out, hi * 16 + lo);
                i = i + 6;
            }
            else { str_builder_add_byte(out, e); i = i + 2; }
        }
        else { str_builder_add_byte(out, c); i = i + 1; }
    }
    return str_data(str_builder_build(out));
}

# Finish a str_builder and hand back its bytes. Goldens below are
# assembled across several calls: cyrius string literals cannot wrap,
# and a one-line golden blows the 120-column lint budget.
fn built(sb) {
    return str_data(str_builder_build(sb));
}

# Escape a cstr the way the JSON builders do, and hand back the bytes.
fn escaped_cstr(c) {
    var sb = str_builder_new();
    json_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

fn escaped_str(s) {
    var sb = str_builder_new();
    json_add_str(sb, s);
    return str_data(str_builder_build(sb));
}

# ================================================================
# Search helpers now come from src/vidya_core.cyr (included above).
# They were inlined copies here until the extraction landed; the
# suite asserts on the same code the binary runs.
# ================================================================

# Tag-array parser (subset from main.cyr load path) — ["a", "b"] -> vec of Str.
# NB: each Str points into the raw TOML buffer and is NOT null-terminated;
# that is what the removed "pending Str null-termination fix" comment feared.
fn parse_tags(tags_raw) {
    var tags = vec_new();
    if (tags_raw == 0) { return tags; }
    var td = str_data(tags_raw);
    var tl = str_len(tags_raw);
    var ti = 0;
    while (ti < tl) {
        if (load8(td + ti) == 34) {
            ti = ti + 1;
            var ts = ti;
            while (ti < tl && load8(td + ti) != 34) { ti = ti + 1; }
            vec_push(tags, str_new(td + ts, ti - ts));
            if (ti < tl) { ti = ti + 1; }
        } else {
            ti = ti + 1;
        }
    }
    return tags;
}

# Case-insensitive match of `query` against a tag vec
fn tags_have_ci(tags, query) {
    var folded = cstr_lower(query);
    var n = vec_len(tags);
    var i = 0;
    while (i < n) {
        if (str_has_ci(vec_get(tags, i), folded) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Tests
# ================================================================

fn main() {
    alloc_init();

    # --- Language enum (now the real functions from vidya_core) ---
    test_group("language");
    assert(streq(lang_stem(0), "rust") == 1, "rust stem");
    assert(streq(lang_extension(0), "rs") == 1, "rust ext");
    assert(streq(lang_stem(10), "cyrius") == 1, "cyrius stem");
    assert(streq(lang_extension(10), "cyr") == 1, "cyrius ext");
    assert(streq(lang_name(7), "x86_64 Assembly") == 1, "x86_64 display name");
    assert_eq(lang_parse("rust"), 0, "parse rust");
    assert_eq(lang_parse("rs"), 0, "parse rs");
    assert_eq(lang_parse("cyrius"), 10, "parse cyrius");
    assert_eq(lang_parse("cyr"), 10, "parse cyr");
    assert_eq(lang_parse("unknown"), 0 - 1, "parse unknown");
    assert(str_eq_cstr(lang_filename(1), "python.py") == 1, "python filename");

    # --- TOML loading ---
    test_group("toml_loader");
    var sections = toml_parse_file("content/strings/concept.toml");
    assert(vec_len(sections) > 0, "toml has sections");
    var top = vec_get(sections, 0);
    var pairs = toml_section_pairs(top);
    # NB: cyrius 5.x toml_get takes cstr keys, not Str — using
    # str_from("id") silently returns 0 (see field-note
    # stdlib_str_to_cstr_key_migration).
    var id = toml_get(pairs, "id");
    assert(id != 0, "id exists");
    assert(str_eq_cstr(id, "strings") == 1, "id is strings");
    var title = toml_get(pairs, "title");
    assert(title != 0, "title exists");
    assert(str_eq_cstr(title, "Strings") == 1, "title is Strings");
    var topic = toml_get(pairs, "topic");
    assert(topic != 0, "topic exists");
    var desc = toml_get(pairs, "description");
    assert(desc != 0, "description exists");
    assert(str_len(desc) > 0, "description non-empty");

    # --- TOML sections ---
    test_group("toml_sections");
    var bps = toml_get_sections(sections, "best_practices");
    assert(vec_len(bps) >= 5, "at least 5 best_practices");
    var gotchas = toml_get_sections(sections, "gotchas");
    assert(vec_len(gotchas) >= 3, "at least 3 gotchas");
    var pnotes = toml_get_sections(sections, "performance_notes");
    assert(vec_len(pnotes) >= 1, "at least 1 performance_note");

    # --- Gotcha fields ---
    test_group("gotcha_fields");
    var g0 = vec_get(gotchas, 0);
    var gpairs = toml_section_pairs(g0);
    var gt = toml_get(gpairs, "title");
    assert(gt != 0, "gotcha has title");
    var gb = toml_get(gpairs, "bad_example");
    assert(gb != 0, "gotcha has bad_example");
    var gg = toml_get(gpairs, "good_example");
    assert(gg != 0, "gotcha has good_example");

    # --- Registry (hashmap) ---
    test_group("registry");
    var reg = map_new();
    map_set(reg, "strings", 42);
    map_set(reg, "concurrency", 99);
    assert_eq(map_get(reg, "strings"), 42, "get strings");
    assert_eq(map_get(reg, "concurrency"), 99, "get concurrency");
    assert_eq(map_get(reg, "missing"), 0, "get missing returns 0");
    assert(map_has(reg, "strings") == 1, "has strings");
    assert(map_has(reg, "missing") == 0, "has missing");
    assert_eq(map_count(reg), 2, "count is 2");

    # --- File discovery ---
    test_group("file_discovery");
    assert(file_exists("content/strings/rust.rs") == 1, "rust.rs exists");
    assert(file_exists("content/strings/python.py") == 1, "python.py exists");
    assert(file_exists("content/strings/cyrius.cyr") == 1, "cyrius.cyr exists");
    assert(file_exists("content/strings/nonexistent.xyz") == 0, "nonexistent absent");

    # --- Content directory scan ---
    test_group("content_scan");
    var dirs = dir_list(str_from("content"));
    var ndirs = vec_len(dirs);
    assert(ndirs >= 35, "at least 35 content dirs");

    # --- Load all topics ---
    test_group("load_all");
    var topic_count = 0;
    var i = 0;
    while (i < ndirs) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(str_from("content"), dname);
        if (is_dir(dpath) == 1) {
            var tpath = path_join(dpath, str_from("concept.toml"));
            if (file_exists(str_data(tpath)) == 1) {
                topic_count = topic_count + 1;
            }
        }
        i = i + 1;
    }
    assert(topic_count >= 35, "at least 35 topics with concept.toml");

    # --- Search (substring matching) ---
    test_group("search");
    # Use cstr_contains for simple substring search
    assert(memeq("strings", "string", 6) == 1, "substring match");
    assert(memeq("concurrency", "concur", 6) == 1, "concur match");
    assert(str_has_ci(str_from("strings"), "ring") == 1, "substring hit");
    assert(str_has_ci(str_from("strings"), "zebra") == 0, "substring miss");
    assert(str_has_ci(str_from("strings"), "") == 1, "empty query matches");
    assert(str_has_ci(str_from("ab"), "abc") == 0, "query longer than field");
    assert(str_has_ci(str_from("strings"), "strings") == 1, "whole-field match");
    assert(str_has_ci(str_from("strings"), "s") == 1, "single-byte query");
    assert(str_has_ci(str_from(""), "s") == 0, "empty field, non-empty query");
    # Leading-byte fast path must not stop at the first candidate start:
    # "aab" has a false start at index 0 before the real match at 1.
    assert(str_has_ci(str_from("aab"), "ab") == 1, "match after false start");
    assert(str_has_ci(str_from("abcabd"), "abd") == 1, "second candidate wins");

    # --- Search: ASCII case folding (regression) ---
    # Search used to be a byte-exact scan: `vidya search tcp` found
    # nothing while `vidya search TCP` found 2 topics.
    test_group("search_case_fold");
    assert_eq(ascii_fold(65), 97, "fold A -> a");
    assert_eq(ascii_fold(90), 122, "fold Z -> z");
    assert_eq(ascii_fold(97), 97, "fold a stays a");
    assert_eq(ascii_fold(64), 64, "fold @ untouched (below A)");
    assert_eq(ascii_fold(91), 91, "fold [ untouched (above Z)");
    assert_eq(ascii_fold(53), 53, "fold digit untouched");
    assert_eq(ascii_fold(226), 226, "fold UTF-8 lead byte untouched");
    assert(streq(cstr_lower("TCP"), "tcp") == 1, "cstr_lower TCP");
    assert(streq(cstr_lower("HashMap"), "hashmap") == 1, "cstr_lower HashMap");
    assert(streq(cstr_lower("already"), "already") == 1, "cstr_lower idempotent");
    assert(streq(cstr_lower(""), "") == 1, "cstr_lower empty");
    # The reported repro, both directions
    assert(str_has_ci(str_from("TCP and UDP socket lifecycle"), cstr_lower("tcp")) == 1,
      "lowercase query hits uppercase text");
    assert(str_has_ci(str_from("tcp and udp"), cstr_lower("TCP")) == 1,
      "uppercase query hits lowercase text");
    assert(str_has_ci(str_from("Vec vs HashMap"), cstr_lower("hashmap")) == 1,
      "hashmap hits HashMap");
    assert(str_has_ci(str_from("Strings"), cstr_lower("zebra")) == 0,
      "case fold does not invent matches");
    assert(str_has_ci(0, cstr_lower("tcp")) == 0, "null Str is a miss");

    # --- Search: tags are searched (regression) ---
    # content-format.md documents `tags` as "Search tags", but the tag
    # branch was commented out "pending Str null-termination fix". The
    # tag Strs point into the raw TOML buffer with no terminator; the
    # to_cstr_lower copy is what makes them safe to scan.
    test_group("search_tags");
    var stags = parse_tags(toml_get(pairs, "tags"));
    assert(vec_len(stags) >= 5, "strings has at least 5 tags");
    assert(tags_have_ci(stags, "interpolation") == 1, "tag interpolation found");
    assert(tags_have_ci(stags, "INTERPOLATION") == 1, "tag match is case-insensitive");
    assert(tags_have_ci(stags, "unicode") == 1, "tag unicode found");
    assert(tags_have_ci(stags, "nosuchtag") == 0, "absent tag is a miss");
    # `interpolation` appears in no id/title/description — tags are the only route
    assert(str_has_ci(id, cstr_lower("interpolation")) == 0, "not in id");
    assert(str_has_ci(title, cstr_lower("interpolation")) == 0, "not in title");
    assert(str_has_ci(desc, cstr_lower("interpolation")) == 0, "not in description");

    # --- HTTP path routing shape ---
    # tcyr can't bind a port, so we just sanity-check the path-prefix
    # matches that http_route uses. The actual end-to-end smoke test
    # for /compare and /gaps lives in scripts (see CHANGELOG 2.3.4).
    test_group("http_routes");
    assert(memeq("/compare?topic=x&left=rust&right=python", "/compare", 8) == 1, "/compare prefix");
    assert(streq("/gaps", "/gaps") == 1, "/gaps exact match");
    assert(memeq("/info/algorithms", "/info/", 6) == 1, "/info/ prefix");
    assert(memeq("/search?q=x", "/search", 7) == 1, "/search prefix");

    # --- vec_count: the root cause of the /info count bug ---
    test_group("vec_count");
    assert_eq(vec_count(0), 0, "null vec counts 0");
    var v5 = vec_new();
    vec_push(v5, 10);
    vec_push(v5, 20);
    vec_push(v5, 30);
    vec_push(v5, 40);
    vec_push(v5, 50);
    assert_eq(vec_count(v5), 5, "vec_count returns the real length");
    # Executable field-note. This is the expression that shipped in
    # json_info_response: cyrius `&&` is a logical operator yielding
    # 0/1, so it can guard a count but never carry one.
    assert_eq((v5 != 0 && vec_len(v5)), 1, "cyrius && collapses a count to a boolean");

    # --- JSON escaping primitives ---
    test_group("json_escape");
    assert_streq(escaped_cstr("plain"), "\"plain\"", "plain string is quoted");
    assert_streq(escaped_cstr(""), "\"\"", "empty string");
    assert_streq(escaped_cstr(0), "\"\"", "null cstr renders as empty string");
    assert_streq(escaped_cstr("a\"b"), "\"a\\\"b\"", "double quote escaped");
    assert_streq(escaped_cstr("a\\b"), "\"a\\\\b\"", "backslash escaped");
    assert_streq(escaped_cstr("a\nb"), "\"a\\nb\"", "newline escaped");
    assert_streq(escaped_str(0), "\"\"", "null Str renders as empty string");
    assert_streq(escaped_str(str_from("a\"b")), "\"a\\\"b\"", "Str quote escaped");
    # A Str is a borrowed (data, len) pair with no NUL — the escaper has
    # to go through to_cstr or it walks off the end of the file buffer.
    var borrowed = str_new(str_data(str_from("abcdef")), 3);
    assert_streq(escaped_str(borrowed), "\"abc\"", "un-terminated Str stops at its length");
    # Raw control bytes must not reach the wire unescaped.
    var ctl = str_builder_new();
    str_builder_add_cstr(ctl, "a");
    str_builder_add_byte(ctl, 1);
    str_builder_add_cstr(ctl, "b");
    assert_streq(escaped_cstr(str_data(str_builder_build(ctl))), "\"a\\u0001b\"", "control byte escaped");
    var tabbed = str_builder_new();
    str_builder_add_cstr(tabbed, "a");
    str_builder_add_byte(tabbed, 9);
    str_builder_add_cstr(tabbed, "b");
    assert_streq(escaped_cstr(str_data(str_builder_build(tabbed))), "\"a\\tb\"", "tab escaped");

    # --- Golden bodies for every JSON builder ---
    # Registry holds exactly one concept here (the fixture), so /stats,
    # /list and /gaps are deterministic. The hostile fixture is added
    # afterwards on purpose — adding it earlier would move these goldens.
    test_group("json_golden");
    reg_init();
    var gold = load_concept(str_from("tests/fixtures/json_golden"));
    assert(gold != 0, "golden fixture loads");
    reg_add(gold);
    assert_eq(reg_count(), 1, "registry holds only the fixture");

    var g_info = json_info_response("json_golden");
    assert(g_info != 0, "info body built");
    var want_info = str_builder_new();
    str_builder_add_cstr(want_info, "{\"id\":\"json_golden\",\"title\":\"JSON Golden\",");
    str_builder_add_cstr(want_info, "\"topic\":\"Testing\",");
    str_builder_add_cstr(want_info, "\"description\":\"Fixture concept for the JSON response builders.\",");
    str_builder_add_cstr(want_info, "\"tags\":[\"golden\",\"json\"],\"languages\":[\"Python\"],");
    str_builder_add_cstr(want_info, "\"best_practices\":3,\"gotchas\":2,\"performance_notes\":4}");
    assert_streq(str_data(g_info), built(want_info),
      "/info golden — counts are 3/2/4, not 1/1/1");

    var g_stats = json_stats_response();
    assert_streq(str_data(g_stats),
      "{\"topics\":1,\"complete\":0,\"examples\":1,\"languages\":11}",
      "/stats golden");

    var g_list = json_list_response();
    assert_streq(str_data(g_list),
      "[{\"id\":\"json_golden\",\"topic\":\"Testing\",\"languages\":1}]",
      "/list golden");

    var g_cmp = json_compare_response("json_golden", "python", "rust");
    var want_cmp = str_builder_new();
    str_builder_add_cstr(want_cmp, "{\"topic\":\"json_golden\",\"title\":\"JSON Golden\",");
    str_builder_add_cstr(want_cmp, "\"left\":{\"language\":\"Python\",\"present\":true,");
    str_builder_add_cstr(want_cmp, "\"path\":\"json_golden/python.py\"},");
    str_builder_add_cstr(want_cmp, "\"right\":{\"language\":\"Rust\",\"present\":false}}");
    assert_streq(str_data(g_cmp), built(want_cmp), "/compare golden");
    assert_eq(json_compare_response("json_golden", "python", "klingon"), 0 - 1, "/compare unknown language sentinel");
    assert_eq(json_compare_response("no_such_topic", "python", "rust"), 0, "/compare unknown topic sentinel");

    var g_gaps = json_gaps_response();
    var want_gaps = str_builder_new();
    str_builder_add_cstr(want_gaps, "{\"topics\":1,\"languages\":11,\"gaps\":[");
    str_builder_add_cstr(want_gaps, "{\"id\":\"json_golden\",\"covered\":1,\"of\":11,\"missing\":[");
    str_builder_add_cstr(want_gaps, "\"Rust\",\"C\",\"Go\",\"TypeScript\",\"Shell\",\"Zig\",");
    str_builder_add_cstr(want_gaps, "\"x86_64 Assembly\",\"AArch64 Assembly\",\"OpenQASM\",\"Cyrius\"");
    str_builder_add_cstr(want_gaps, "]}],\"total_missing\":10}");
    assert_streq(str_data(g_gaps), built(want_gaps), "/gaps golden");

    var g_langs = json_languages_response();
    assert(json_wellformed(str_data(g_langs)) == 1, "/languages well-formed");
    assert(cstr_contains(str_data(g_langs), "{\"name\":\"Cyrius\",\"extension\":\"cyr\"}") == 1,
      "/languages lists cyrius");

    var g_code = json_code_response("json_golden", "python");
    assert(g_code != 0, "code body built");
    assert(json_wellformed(str_data(g_code)) == 1, "/code well-formed with quotes in the source");
    assert(cstr_contains(str_data(g_code), "\"path\":\"json_golden/python.py\"") == 1,
      "/code reports the example path");
    # The fixture source contains `print("json golden fixture")` — the
    # quotes must arrive escaped, never raw.
    assert(cstr_contains(str_data(g_code), "print(\\\"json golden fixture\\\")") == 1,
      "/code escapes quotes in source");

    # --- Query-string injection (/search) ---
    test_group("json_search_injection");
    var s_plain = json_search_response("json");
    var want_search = str_builder_new();
    str_builder_add_cstr(want_search, "{\"query\":\"json\",\"count\":1,\"results\":[");
    str_builder_add_cstr(want_search, "{\"id\":\"json_golden\",");
    str_builder_add_cstr(want_search, "\"description\":\"Fixture concept for the JSON response builders.\"}]}");
    assert_streq(str_data(s_plain), built(want_search), "/search golden");

    var s_quote = json_search_response("a\"b");
    assert_streq(str_data(s_quote),
      "{\"query\":\"a\\\"b\",\"count\":0,\"results\":[]}",
      "/search escapes a bare quote in the query");

    # sandhi percent-decodes params before the builder sees them, so this
    # is exactly what arrives from ?q=x%22%2C%22count%22%3A42...
    var inj = "x\",\"count\":42,\"injected\":\"yes";
    var s_inj = json_search_response(inj);
    assert(json_wellformed(str_data(s_inj)) == 1, "injected query keeps the body well-formed");
    assert_streq(json_value_of(str_data(s_inj), "query"), inj, "injected query round-trips verbatim as a value");
    assert(cstr_contains(str_data(s_inj), "\"injected\":\"yes\"") == 0,
      "no attacker-controlled key at structure level");
    assert(cstr_contains(str_data(s_inj), "\"count\":0") == 1, "real count survives the injection attempt");

    var s_nl = json_search_response("nl\nhere");
    assert(json_wellformed(str_data(s_nl)) == 1, "newline in query stays escaped");
    assert_streq(json_value_of(str_data(s_nl), "query"), "nl\nhere", "newline round-trips");

    # --- Content-derived hostile bytes ---
    test_group("json_hostile_content");
    var hostile = load_concept(str_from("tests/fixtures/json_hostile"));
    assert(hostile != 0, "hostile fixture loads");
    # bayan's TOML reader does not expand escapes in ''' literals, so the
    # description really is `q:" b:\ end` on the way in.
    assert(str_eq_cstr(concept_desc(hostile), "q:\" b:\\ end") == 1, "hostile description arrives raw");
    reg_add(hostile);

    var h_info = json_info_response("json_hostile");
    assert(h_info != 0, "hostile info body built");
    assert(json_wellformed(str_data(h_info)) == 1, "hostile /info stays well-formed");
    assert_streq(json_value_of(str_data(h_info), "description"), "q:\" b:\\ end", "hostile description round-trips");
    assert_streq(json_value_of(str_data(h_info), "title"), "hostile \"title\"", "hostile title round-trips");
    assert(cstr_contains(str_data(h_info), "\"back\\\\slash\"") == 1, "hostile tag escapes its backslash");
    assert(json_wellformed(str_data(json_list_response())) == 1, "hostile /list stays well-formed");

    # --- Corpus sweep: every real topic, every /info body ---
    test_group("json_corpus_sweep");
    reg_init();
    var loaded = load_all();
    assert(loaded >= 35, "corpus loaded");
    var entries = reg_list();
    var bad_shape = 0;
    var bad_counts = 0;
    var multi = 0;
    var ci = 0;
    while (ci < vec_len(entries)) {
        var c = vec_get(entries, ci);
        var nbp = vec_count(concept_best_practices(c));
        if (nbp > 1) { multi = multi + 1; }
        var body = json_info_response(to_cstr(concept_id(c)));
        if (body == 0) {
            bad_shape = bad_shape + 1;
        } else {
            if (json_wellformed(str_data(body)) == 0) { bad_shape = bad_shape + 1; }
            # The counts in the body must equal the registry's real
            # vector lengths — drift-proof, unlike a hard-coded number.
            var want = str_builder_new();
            str_builder_add_cstr(want, "\"best_practices\":");
            str_builder_add_int(want, nbp);
            str_builder_add_cstr(want, ",\"gotchas\":");
            str_builder_add_int(want, vec_count(concept_gotchas(c)));
            str_builder_add_cstr(want, ",\"performance_notes\":");
            str_builder_add_int(want, vec_count(concept_perf_notes(c)));
            if (cstr_contains(str_data(body), str_data(str_builder_build(want))) == 0) {
                bad_counts = bad_counts + 1;
            }
        }
        ci = ci + 1;
    }
    assert_eq(bad_shape, 0, "every /info body is structurally sound");
    assert_eq(bad_counts, 0, "every /info body reports real section counts");
    assert(multi > 1, "corpus has multi-item topics (else the count check is vacuous)");
    assert(json_wellformed(str_data(json_stats_response())) == 1, "corpus /stats well-formed");
    assert(json_wellformed(str_data(json_list_response())) == 1, "corpus /list well-formed");
    assert(json_wellformed(str_data(json_gaps_response())) == 1, "corpus /gaps well-formed");

    # --- Subprocess contract behind `vidya validate` ---
    # validate_one shells out through exec_cmd; every false-FAIL bug it
    # had was in this layer, not in content. Pin the three properties it
    # got wrong.
    test_group("validate_exec");

    # 1. Exit status is the CHILD's exit code, not a raw wait status.
    assert_eq(exec_cmd("exit 0"), 0, "exec_cmd: exit 0");
    assert_eq(exec_cmd("exit 1"), 1, "exec_cmd: exit 1");
    assert_eq(exec_cmd("exit 42"), 42, "exec_cmd: exit 42");

    # 2. The child inherits the parent's environment. Before this fix the
    # exec passed envp=0: sh still resolved its own default PATH, so a
    # naive `command -v` probe looked fine while every toolchain needing
    # HOME (go's build cache, zig's cache dir, npx) or a PATH entry
    # outside /usr/bin (rustup's rustc) failed. HOME is the discriminator
    # — no shell synthesises it. Asserted only when the parent actually
    # has one, so a HOME-less CI runner cannot fail this spuriously.
    if (getenv("HOME") != 0) {
        assert_eq(exec_cmd("[ -n \"$HOME\" ]"), 0, "exec_cmd: child inherits env");
    }

    # 3. A trailing cleanup verb swallows the real exit status — this is
    # why validate_command templates end at the example and validate_one
    # does the unlinking. The first form is the old asm template
    # shape: a failing example reported PASS.
    assert_eq(exec_cmd("false ; rm -f /tmp/vidya_no_such_file"), 0, "trailing rm masks failure");
    assert_eq(exec_cmd("false"), 1, "no trailing verb keeps the status");

    # 4. A signal-killed child (SIGSEGV/SIGABRT — ordinary outcomes for a
    # broken C or asm example) is not WIFEXITED, and exec_cmd reports it
    # as -1. That collides with validate_one's VALIDATE_SKIP sentinel, so
    # validate_one maps rc < 0 to a FAIL: a crashing example must never
    # be silently counted as skipped.
    assert_eq(exec_cmd("kill -SEGV $$"), 0 - 1, "exec_cmd: signal death is -1");

    # Toolchain probes: present → 0, absent → non-zero (a SKIP, not a FAIL).
    assert_eq(exec_cmd("command -v sh >/dev/null 2>&1"), 0, "probe: sh present");
    assert(exec_cmd("command -v vidya_no_such_tool >/dev/null 2>&1") != 0, "probe: absent tool");

    # Template substitution: {out} appears more than once in the compile
    # -> run templates, so the replace must be all-occurrences.
    var tmpl = str_from("cc {file} -o {out} && {out}");
    var subbed = str_replace_all(tmpl, str_from("{file}"), str_from("a.c"));
    subbed = str_replace_all(subbed, str_from("{out}"), str_from("/tmp/b"));
    assert(str_eq_cstr(subbed, "cc a.c -o /tmp/b && /tmp/b") == 1, "template substitution");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
