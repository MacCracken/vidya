# vidya_core.cyr — domain + JSON layer.
#
# Everything vidya knows how to *compute*: the language enum, the
# concept/example types, the registry + TOML loader, hot-reload,
# search, compare, code rendering, validation, and the JSON response
# builders behind the HTTP API.
#
# Split out of src/main.cyr at 2.8.1 so tests/vidya.tcyr can exercise
# the real functions instead of re-implementing them locally (which is
# how the /info count bug and the /search JSON-injection bug both
# survived to release). src/main.cyr keeps CLI presentation, HTTP
# plumbing, the route table, and main(); this file keeps the rest.
#
# No includes here — stdlib + deps are auto-included via cyrius.cyml,
# and cyrius compiles in two passes so include order never affects
# function resolution (same convention as sit/src/*.cyr).

# ================================================================
# Language enum (constants)
# ================================================================

enum Lang {
    RUST = 0;
    PYTHON = 1;
    C_LANG = 2;
    GO = 3;
    TYPESCRIPT = 4;
    SHELL = 5;
    ZIG = 6;
    ASM_X86_64 = 7;
    ASM_AARCH64 = 8;
    OPENQASM = 9;
    CYRIUS = 10;
    LANG_COUNT = 11;
}

fn lang_extension(lang) {
    if (lang == RUST) { return "rs"; }
    if (lang == PYTHON) { return "py"; }
    if (lang == C_LANG) { return "c"; }
    if (lang == GO) { return "go"; }
    if (lang == TYPESCRIPT) { return "ts"; }
    if (lang == SHELL) { return "sh"; }
    if (lang == ZIG) { return "zig"; }
    if (lang == ASM_X86_64) { return "s"; }
    if (lang == ASM_AARCH64) { return "s"; }
    if (lang == OPENQASM) { return "qasm"; }
    if (lang == CYRIUS) { return "cyr"; }
    return "";
}

fn lang_stem(lang) {
    if (lang == RUST) { return "rust"; }
    if (lang == PYTHON) { return "python"; }
    if (lang == C_LANG) { return "c"; }
    if (lang == GO) { return "go"; }
    if (lang == TYPESCRIPT) { return "typescript"; }
    if (lang == SHELL) { return "shell"; }
    if (lang == ZIG) { return "zig"; }
    if (lang == ASM_X86_64) { return "asm_x86_64"; }
    if (lang == ASM_AARCH64) { return "asm_aarch64"; }
    if (lang == OPENQASM) { return "openqasm"; }
    if (lang == CYRIUS) { return "cyrius"; }
    return "";
}

fn lang_name(lang) {
    if (lang == RUST) { return "Rust"; }
    if (lang == PYTHON) { return "Python"; }
    if (lang == C_LANG) { return "C"; }
    if (lang == GO) { return "Go"; }
    if (lang == TYPESCRIPT) { return "TypeScript"; }
    if (lang == SHELL) { return "Shell"; }
    if (lang == ZIG) { return "Zig"; }
    if (lang == ASM_X86_64) { return "x86_64 Assembly"; }
    if (lang == ASM_AARCH64) { return "AArch64 Assembly"; }
    if (lang == OPENQASM) { return "OpenQASM"; }
    if (lang == CYRIUS) { return "Cyrius"; }
    return "Unknown";
}

fn lang_comment(lang) {
    if (lang == RUST) { return "//"; }
    if (lang == PYTHON) { return "#"; }
    if (lang == C_LANG) { return "//"; }
    if (lang == GO) { return "//"; }
    if (lang == TYPESCRIPT) { return "//"; }
    if (lang == SHELL) { return "#"; }
    if (lang == ZIG) { return "//"; }
    if (lang == ASM_X86_64) { return "#"; }
    if (lang == ASM_AARCH64) { return "#"; }
    if (lang == OPENQASM) { return "//"; }
    if (lang == CYRIUS) { return "#"; }
    return "#";
}

# Parse language from string (case-insensitive match on name/ext/alias)
fn lang_parse(s) {
    if (streq(s, "rust") == 1 || streq(s, "rs") == 1) { return RUST; }
    if (streq(s, "python") == 1 || streq(s, "py") == 1) { return PYTHON; }
    if (streq(s, "c") == 1) { return C_LANG; }
    if (streq(s, "go") == 1 || streq(s, "golang") == 1) { return GO; }
    if (streq(s, "typescript") == 1 || streq(s, "ts") == 1) { return TYPESCRIPT; }
    if (streq(s, "shell") == 1 || streq(s, "sh") == 1 || streq(s, "bash") == 1) { return SHELL; }
    if (streq(s, "zig") == 1) { return ZIG; }
    if (streq(s, "asm_x86_64") == 1 || streq(s, "x86_64") == 1 || streq(s, "x86") == 1) { return ASM_X86_64; }
    if (streq(s, "asm_aarch64") == 1 || streq(s, "aarch64") == 1 || streq(s, "arm64") == 1) { return ASM_AARCH64; }
    if (streq(s, "openqasm") == 1 || streq(s, "qasm") == 1) { return OPENQASM; }
    if (streq(s, "cyrius") == 1 || streq(s, "cyr") == 1) { return CYRIUS; }
    return 0 - 1;
}

# Build filename for a language: stem.extension
fn lang_filename(lang) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, lang_stem(lang));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, lang_extension(lang));
    return str_builder_build(sb);
}

# ================================================================
# Concept — enriched data type
# ================================================================
# Layout: { id, title, topic, description, tags, best_practices,
#            gotchas, perf_notes, examples }
# 9 fields x 8 bytes = 72 bytes

fn concept_new() {
    var c = alloc(72);
    store64(c, 0);       # id: Str
    store64(c + 8, 0);   # title: Str
    store64(c + 16, 0);  # topic: Str
    store64(c + 24, 0);  # description: Str
    store64(c + 32, 0);  # tags: vec of Str
    store64(c + 40, 0);  # best_practices: vec of ptrs
    store64(c + 48, 0);  # gotchas: vec of ptrs
    store64(c + 56, 0);  # perf_notes: vec of ptrs
    store64(c + 64, 0);  # examples: vec of ptrs (indexed by lang)
    return c;
}

fn concept_id(c) { return load64(c); }
fn concept_title(c) { return load64(c + 8); }
fn concept_topic(c) { return load64(c + 16); }
fn concept_desc(c) { return load64(c + 24); }
fn concept_tags(c) { return load64(c + 32); }
fn concept_best_practices(c) { return load64(c + 40); }
fn concept_gotchas(c) { return load64(c + 48); }
fn concept_perf_notes(c) { return load64(c + 56); }
fn concept_examples(c) { return load64(c + 64); }

# ================================================================
# BestPractice: { title, explanation, language }
# ================================================================

fn bp_new(title, explanation, lang) {
    var bp = alloc(24);
    store64(bp, title);
    store64(bp + 8, explanation);
    store64(bp + 16, lang);
    return bp;
}

fn bp_title(bp) { return load64(bp); }
fn bp_explanation(bp) { return load64(bp + 8); }
fn bp_language(bp) { return load64(bp + 16); }

# ================================================================
# Gotcha: { title, explanation, bad_example, good_example, language }
# ================================================================

fn gotcha_new(title, explanation, bad, good, lang) {
    var g = alloc(40);
    store64(g, title);
    store64(g + 8, explanation);
    store64(g + 16, bad);
    store64(g + 24, good);
    store64(g + 32, lang);
    return g;
}

fn gotcha_title(g) { return load64(g); }
fn gotcha_explanation(g) { return load64(g + 8); }
fn gotcha_bad(g) { return load64(g + 16); }
fn gotcha_good(g) { return load64(g + 24); }
fn gotcha_language(g) { return load64(g + 32); }

# ================================================================
# PerformanceNote: { title, explanation, evidence, language }
# ================================================================

fn perf_new(title, explanation, evidence, lang) {
    var p = alloc(32);
    store64(p, title);
    store64(p + 8, explanation);
    store64(p + 16, evidence);
    store64(p + 24, lang);
    return p;
}

fn perf_title(p) { return load64(p); }
fn perf_explanation(p) { return load64(p + 8); }
fn perf_evidence(p) { return load64(p + 16); }
fn perf_language(p) { return load64(p + 24); }

# ================================================================
# Example: { language_id, code, explanation, source_path }
# ================================================================

fn example_new(lang, code, explanation, path) {
    var e = alloc(32);
    store64(e, lang);
    store64(e + 8, code);
    store64(e + 16, explanation);
    store64(e + 24, path);
    return e;
}

fn example_lang(e) { return load64(e); }
fn example_code(e) { return load64(e + 8); }
fn example_explanation(e) { return load64(e + 16); }
fn example_path(e) { return load64(e + 24); }

# ================================================================
# Registry — indexed concept store
# ================================================================

var _reg_entries = 0;   # vec of concept ptrs (live registry)
var _reg_index = 0;     # hashmap: id -> concept ptr (live registry)
var _content_dir = 0;   # Str path to content/

# Hot-reload state (P0B-4) — populated by inotify_init_watches
# at serve start, drained per request, swapped on change.
var _inotify_fd = 0 - 1;        # -1 sentinel — disabled until init
var _reload_pending = 0;        # set by inotify_drain when events present
var _reload_count = 0;          # successful reload counter (for sakshi)
var _reload_failures = 0;       # failed reload counter
var _reg_entries_next = 0;      # staging registry — built then swapped
var _reg_index_next = 0;
var _inotify_buf[8192];         # static drain buffer (one-shot read)

fn reg_init() {
    _reg_entries = vec_new();
    _reg_index = map_new();
    _content_dir = str_from("content");
    return 0;
}

# Convert Str to null-terminated C string (for hashmap keys)
fn to_cstr(s) {
    if (s == 0) { return ""; }
    var len = str_len(s);
    var buf = alloc(len + 1);
    memcpy(buf, str_data(s), len);
    store8(buf + len, 0);
    return buf;
}

fn reg_add(concept) {
    vec_push(_reg_entries, concept);
    var id = concept_id(concept);
    if (id != 0) {
        var cid = to_cstr(id);
        map_set(_reg_index, cid, concept);
        sakshi_debug(cid, strlen(cid));
    }
    return 0;
}

fn reg_get(id) {
    return map_get(_reg_index, id);
}

fn reg_count() {
    return vec_len(_reg_entries);
}

fn reg_list() {
    return _reg_entries;
}

# ================================================================
# Extract explanation from leading comments
# ================================================================

fn extract_explanation(code, prefix) {
    var sb = str_builder_new();
    var data = str_data(code);
    var slen = str_len(code);
    var plen = strlen(prefix);
    var pos = 0;
    var line_count = 0;
    var in_header = 1;

    while (pos < slen && in_header == 1) {
        # Find end of line
        var lstart = pos;
        while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
        var lend = pos;
        if (pos < slen) { pos = pos + 1; }

        # Skip shebang
        if (line_count == 0 && lend - lstart >= 2) {
            if (load8(data + lstart) == 35 && load8(data + lstart + 1) == 33) {
                line_count = line_count + 1;
                continue;
            }
        }

        # Trim leading whitespace
        var tstart = lstart;
        while (tstart < lend && load8(data + tstart) == 32) { tstart = tstart + 1; }
        var tlen = lend - tstart;

        # Empty line in header — preserve as blank
        if (tlen == 0) {
            if (line_count > 0) {
                str_builder_add_cstr(sb, "\n");
            }
            line_count = line_count + 1;
            continue;
        }

        # Check for comment prefix
        if (tlen >= plen && memeq(data + tstart, prefix, plen) == 1) {
            # Strip prefix and optional leading space
            var cstart = tstart + plen;
            if (cstart < lend && load8(data + cstart) == 32) { cstart = cstart + 1; }
            if (line_count > 0) { str_builder_add_cstr(sb, "\n"); }
            str_builder_add(sb, str_new(data + cstart, lend - cstart));
            line_count = line_count + 1;
        } else {
            in_header = 0;
        }
    }
    return str_builder_build(sb);
}

# ================================================================
# Loader — parse concept.toml + discover language files
# ================================================================

fn load_concept(topic_dir) {
    var toml_path = path_join(topic_dir, str_from("concept.toml"));
    if (file_exists(str_data(toml_path)) == 0) { return 0; }

    # Read then parse manually — lib/toml.cyr toml_parse_file uses
    # var buf[N] (static data, not stack) so consecutive calls clobber
    # each other's Str backing memory. Heap-alloc per call to keep
    # parsed Str values alive across topics. (Tracked: stdlib gotcha.)
    var _toml_buf = alloc(262144);
    var _toml_n = file_read_all(str_data(toml_path), _toml_buf, 262144);
    if (_toml_n <= 0) { return 0; }
    var sections = toml_parse(str_new(_toml_buf, _toml_n));
    if (vec_len(sections) == 0) { return 0; }

    var concept = concept_new();

    # Parse top-level fields
    var top = vec_get(sections, 0);
    var pairs = toml_section_pairs(top);

    var id = toml_get(pairs, "id");
    var title = toml_get(pairs, "title");
    var topic = toml_get(pairs, "topic");
    var desc = toml_get(pairs, "description");

    store64(concept, id);
    store64(concept + 8, title);
    store64(concept + 16, topic);
    store64(concept + 24, desc);

    # Parse tags (comma-separated in TOML array — toml.cyr gives us the raw value)
    var tags_raw = toml_get(pairs, "tags");
    var tags = vec_new();
    if (tags_raw != 0) {
        # Tags come as ["tag1", "tag2"] — parse the bracket content
        var td = str_data(tags_raw);
        var tl = str_len(tags_raw);
        var ti = 0;
        while (ti < tl) {
            var tc = load8(td + ti);
            if (tc == 34) {
                # Opening quote — find closing
                ti = ti + 1;
                var ts = ti;
                while (ti < tl && load8(td + ti) != 34) { ti = ti + 1; }
                vec_push(tags, str_new(td + ts, ti - ts));
                if (ti < tl) { ti = ti + 1; }
            } else {
                ti = ti + 1;
            }
        }
    }
    store64(concept + 32, tags);

    # Parse [[best_practices]]
    var bps = vec_new();
    var bp_sections = toml_get_sections(sections, "best_practices");
    var bi = 0;
    while (bi < vec_len(bp_sections)) {
        var bsec = vec_get(bp_sections, bi);
        var bpairs = toml_section_pairs(bsec);
        var bt = toml_get(bpairs, "title");
        var be = toml_get(bpairs, "explanation");
        var bl = toml_get(bpairs, "language");
        vec_push(bps, bp_new(bt, be, bl));
        bi = bi + 1;
    }
    store64(concept + 40, bps);

    # Parse [[gotchas]]
    var gotchas = vec_new();
    var g_sections = toml_get_sections(sections, "gotchas");
    var gi = 0;
    while (gi < vec_len(g_sections)) {
        var gsec = vec_get(g_sections, gi);
        var gpairs = toml_section_pairs(gsec);
        var gt = toml_get(gpairs, "title");
        var ge = toml_get(gpairs, "explanation");
        var gb = toml_get(gpairs, "bad_example");
        var gg = toml_get(gpairs, "good_example");
        var gl = toml_get(gpairs, "language");
        vec_push(gotchas, gotcha_new(gt, ge, gb, gg, gl));
        gi = gi + 1;
    }
    store64(concept + 48, gotchas);

    # Parse [[performance_notes]]
    var pnotes = vec_new();
    var p_sections = toml_get_sections(sections, "performance_notes");
    var pi = 0;
    while (pi < vec_len(p_sections)) {
        var psec = vec_get(p_sections, pi);
        var ppairs = toml_section_pairs(psec);
        var pt = toml_get(ppairs, "title");
        var pe = toml_get(ppairs, "explanation");
        var pv = toml_get(ppairs, "evidence");
        var pl = toml_get(ppairs, "language");
        vec_push(pnotes, perf_new(pt, pe, pv, pl));
        pi = pi + 1;
    }
    store64(concept + 56, pnotes);

    # Discover language implementation files
    var examples = vec_new();
    var li = 0;
    while (li < LANG_COUNT) {
        var fname = lang_filename(li);
        var fpath = path_join(topic_dir, fname);
        if (file_exists(str_data(fpath)) == 1) {
            # Read file contents
            var buf = alloc(65536);
            var n = file_read_all(str_data(fpath), buf, 65535);
            if (n > 0) {
                var code = str_new(buf, n);
                var explanation = extract_explanation(code, lang_comment(li));
                var rel_path = path_join(concept_id(concept), fname);
                vec_push(examples, example_new(li, code, explanation, rel_path));
            }
        }
        li = li + 1;
    }
    store64(concept + 64, examples);

    return concept;
}

# Load all concepts from content directory
fn load_all() {
    sakshi_span_enter("load_all", 8);
    var dirs = dir_list(_content_dir);
    var ndirs = vec_len(dirs);
    var i = 0;
    while (i < ndirs) {
        var dname = vec_get(dirs, i);
        var dpath = path_join(_content_dir, dname);
        if (is_dir(dpath) == 1) {
            var concept = load_concept(dpath);
            if (concept != 0) {
                reg_add(concept);
            }
        }
        i = i + 1;
    }
    sakshi_span_exit();
    return reg_count();
}

# ================================================================
# Hot-reload (P0B-4) — inotify watch + atomic registry swap
# ================================================================
# Single-threaded vidya means swap = two pointer assignments, no
# barrier needed. Drain runs at the top of every handle_request;
# reload runs inline on the request thread when drain finds events.
# All-or-nothing: a partial-reload failure (one bad concept.toml)
# leaves the live registry untouched.
#
# Bump-allocator note: each reload doubles registry memory, which
# never frees. Acceptable for a local dev tool reloaded a handful
# of times per session; document for long-running deployments.

# IN_NONBLOCK + watch mask constants — referenced numerically because
# the cyrius stdlib's InotifyEvent enum is in syscalls_x86_64_linux
# (peer module, not directly visible here without per-arch wiring).
# Mask = IN_MODIFY|IN_CLOSE_WRITE|IN_MOVED_FROM|IN_MOVED_TO|IN_CREATE|IN_DELETE
#      = 2|8|64|128|256|512 = 970
fn _hot_reload_mask() { return 970; }
fn _hot_reload_in_nonblock() { return 2048; }

# Open inotify fd in non-blocking mode and add watches on content/
# root + every topic subdir. Idempotent: closes any prior fd first.
# Called once at serve start (cmd_serve) and again after each
# successful reload (so newly-added topic dirs get watched).
fn inotify_init_watches() {
    if (_inotify_fd >= 0) {
        sys_close(_inotify_fd);
        _inotify_fd = 0 - 1;
    }
    # syscall(294) = SYS_inotify_init1 on x86_64 + aarch64.
    var fd = syscall(294, _hot_reload_in_nonblock());
    if (fd < 0) {
        sakshi_warn("inotify_init1 failed; hot-reload disabled", 41);
        return 0;
    }
    _inotify_fd = fd;
    var mask = _hot_reload_mask();
    var croot = to_cstr(_content_dir);
    sys_inotify_add_watch(fd, croot, mask);

    var dirs = dir_list(_content_dir);
    var n = vec_len(dirs);
    var watched = 0;
    var i = 0;
    while (i < n) {
        var dn = vec_get(dirs, i);
        var dp = path_join(_content_dir, dn);
        if (is_dir(dp) == 1) {
            # Only watch topic dirs (same filter as build_next_registry).
            # Skips content/cyrius/ and any non-topic subdirs so edits to
            # field notes don't trigger pointless reloads.
            var tp = path_join(dp, str_from("concept.toml"));
            if (file_exists(str_data(tp)) == 1) {
                var cdp = to_cstr(dp);
                sys_inotify_add_watch(fd, cdp, mask);
                watched = watched + 1;
            }
        }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "inotify watching ");
    str_builder_add_int(sb, watched + 1);
    str_builder_add_cstr(sb, " dirs (root + ");
    str_builder_add_int(sb, watched);
    str_builder_add_cstr(sb, " topics)");
    var line = str_builder_build(sb);
    sakshi_info(str_data(line), str_len(line));
    return 0;
}

# Drain pending inotify events. Non-blocking; returns immediately on
# EAGAIN. Sets _reload_pending = 1 if any bytes were read.
fn inotify_drain() {
    if (_inotify_fd < 0) { return 0; }
    var got = sys_read(_inotify_fd, &_inotify_buf, 8192);
    while (got > 0) {
        _reload_pending = 1;
        got = sys_read(_inotify_fd, &_inotify_buf, 8192);
    }
    return 0;
}

# Build a fresh registry into _reg_entries_next + _reg_index_next.
# All-or-nothing: returns 1 on full success, 0 on first concept-load
# failure (live registry untouched in either case — the caller
# swaps only on success).
fn build_next_registry() {
    _reg_entries_next = vec_new();
    _reg_index_next = map_new();
    var dirs = dir_list(_content_dir);
    var n = vec_len(dirs);
    var i = 0;
    while (i < n) {
        var dn = vec_get(dirs, i);
        var dp = path_join(_content_dir, dn);
        if (is_dir(dp) == 1) {
            # Match load_all's filter: a directory without
            # concept.toml is not a topic, skip silently. Only
            # treat "concept.toml present but load failed" as
            # a hard reload failure.
            var tp = path_join(dp, str_from("concept.toml"));
            if (file_exists(str_data(tp)) == 1) {
                var c = load_concept(dp);
                if (c == 0) {
                    # Malformed concept.toml mid-reload. Leak the
                    # partial _reg_entries_next; live registry in
                    # _reg_entries / _reg_index is unaffected.
                    return 0;
                }
                vec_push(_reg_entries_next, c);
                var id = concept_id(c);
                if (id != 0) {
                    map_set(_reg_index_next, to_cstr(id), c);
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

# Atomic swap — two pointer assignments under the single accept
# thread. The next request reads the new pair; older response
# allocations referencing the old vec/map stay valid for as long as
# anything still points at them (vec/map are heap-resident, never
# freed by the bump allocator).
fn swap_registry() {
    _reg_entries = _reg_entries_next;
    _reg_index = _reg_index_next;
    _reg_entries_next = 0;
    _reg_index_next = 0;
    return 0;
}

# Orchestrator: build, swap on success, log timing + outcome.
# Re-installs inotify watches after a successful swap so that
# newly-added topic dirs get covered.
fn do_reload() {
    var t0 = _sk_now_ns();
    var ok = build_next_registry();
    if (ok != 1) {
        _reload_failures = _reload_failures + 1;
        var sb1 = str_builder_new();
        str_builder_add_cstr(sb1, "reload aborted: a concept failed to load (failure #");
        str_builder_add_int(sb1, _reload_failures);
        str_builder_add_cstr(sb1, "); live registry untouched");
        var line1 = str_builder_build(sb1);
        sakshi_warn(str_data(line1), str_len(line1));
        _reload_pending = 0;
        return 0;
    }
    swap_registry();
    inotify_init_watches();
    _reload_count = _reload_count + 1;
    var dt = _sk_now_ns() - t0;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "reload OK: ");
    str_builder_add_int(sb, vec_len(_reg_entries));
    str_builder_add_cstr(sb, " topics in ");
    str_builder_add_int(sb, dt);
    str_builder_add_cstr(sb, "ns (reload #");
    str_builder_add_int(sb, _reload_count);
    str_builder_add_cstr(sb, ")");
    var line = str_builder_build(sb);
    sakshi_info(str_data(line), str_len(line));
    _reload_pending = 0;
    return 0;
}

# ================================================================
# Search — full-text across id, title, description, tags
# ================================================================

# Substring search on C strings (null-terminated)
fn cstr_contains(haystack, needle) {
    if (haystack == 0 || needle == 0) { return 0; }
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var i = 0;
    while (i <= hlen - nlen) {
        if (memeq(haystack + i, needle, nlen) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ASCII case fold for one byte: A-Z (65-90) -> a-z (97-122).
# Every other byte passes through untouched, so UTF-8 continuation
# bytes (>= 0x80) are never mangled — folding is ASCII-only by design.
# Non-ASCII queries stay byte-exact, which is the older behavior.
fn ascii_fold(b) {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

# ASCII-fold a C string into a fresh buffer. Called once per query,
# not once per field.
fn cstr_lower(c) {
    if (c == 0) { return ""; }
    var len = strlen(c);
    var buf = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(buf + i, ascii_fold(load8(c + i)));
        i = i + 1;
    }
    store8(buf + len, 0);
    return buf;
}

# Case-insensitive substring match of an already-folded query against a
# Str's raw bytes. `folded` must be lowercased by the caller (see
# cstr_lower) — folding it per field would repeat the same work.
#
# Scans str_data/str_len directly rather than materializing a
# null-terminated copy. That drops the alloc the old str_has made for
# every field of every concept on every query — serve() paid 4x77 of
# them per request against a bump allocator that never frees. It is
# also what makes tag search safe without a terminator: tag Strs point
# into the raw TOML buffer, which is exactly what the removed
# "pending Str null-termination fix" deferral was waiting on.
#
# The leading-byte check keeps the inner loop off all but the few
# positions that can actually start a match.
fn str_has_ci(s, folded) {
    if (s == 0) { return 0; }
    var hd = str_data(s);
    var hlen = str_len(s);
    var nlen = strlen(folded);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var f0 = load8(folded);
    var last = hlen - nlen;
    var i = 0;
    while (i <= last) {
        if (ascii_fold(load8(hd + i)) == f0) {
            var j = 1;
            while (j < nlen && ascii_fold(load8(hd + i + j)) == load8(folded + j)) {
                j = j + 1;
            }
            if (j == nlen) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Case-insensitive substring match across id, title, description, tags.
# Matching is ASCII-case-insensitive: `tcp`, `TCP`, and `Tcp` are the
# same query. This was previously a byte-exact scan, and the tag
# branch was commented out entirely.
fn search(query) {
    var results = vec_new();
    var folded = cstr_lower(query);
    var entries = reg_list();
    var count = vec_len(entries);
    var i = 0;
    while (i < count) {
        var c = vec_get(entries, i);
        var found = 0;

        # Check id
        if (found == 0) { if (str_has_ci(concept_id(c), folded) == 1) { found = 1; } }
        # Check title
        if (found == 0) { if (str_has_ci(concept_title(c), folded) == 1) { found = 1; } }
        # Check description
        if (found == 0) { if (str_has_ci(concept_desc(c), folded) == 1) { found = 1; } }
        # Check tags — content-format.md documents these as "Search tags"
        if (found == 0) {
            var tags = concept_tags(c);
            if (tags != 0) {
                var tcount = vec_len(tags);
                var ti = 0;
                while (ti < tcount) {
                    if (str_has_ci(vec_get(tags, ti), folded) == 1) {
                        found = 1;
                        ti = tcount;
                    } else {
                        ti = ti + 1;
                    }
                }
            }
        }
        if (found == 1) { vec_push(results, c); }
        i = i + 1;
    }
    return results;
}

# ================================================================
# Compare — side-by-side cross-language view
# ================================================================

fn get_example(concept, lang) {
    var examples = concept_examples(concept);
    if (examples == 0) { return 0; }
    var count = vec_len(examples);
    var i = 0;
    while (i < count) {
        var ex = vec_get(examples, i);
        if (example_lang(ex) == lang) { return ex; }
        i = i + 1;
    }
    return 0;
}

fn cmd_compare(topic_id, lang1_str, lang2_str) {
    var concept = reg_get(topic_id);
    if (concept == 0) {
        sys_write(STDERR_FD, "error: topic not found: ", 24);
        println(topic_id);
        return 1;
    }
    var l1 = lang_parse(lang1_str);
    var l2 = lang_parse(lang2_str);
    if (l1 < 0) {
        sys_write(STDERR_FD, "error: unknown language: ", 25);
        println(lang1_str);
        return 1;
    }
    if (l2 < 0) {
        sys_write(STDERR_FD, "error: unknown language: ", 25);
        println(lang2_str);
        return 1;
    }

    println("=== Compare ===");
    syscall(1, 1, "Topic: ", 7);
    var title = concept_title(concept);
    if (title != 0) { str_println(title); }
    else { println(topic_id); }

    var ex1 = get_example(concept, l1);
    var ex2 = get_example(concept, l2);

    # Print lang1
    syscall(1, 1, "\n--- ", 5);
    syscall(1, 1, lang_name(l1), strlen(lang_name(l1)));
    println(" ---");
    if (ex1 != 0) {
        var expl = example_explanation(ex1);
        if (expl != 0 && str_len(expl) > 0) { str_println(expl); println(""); }
        var path = example_path(ex1);
        if (path != 0) { syscall(1, 1, "  file: ", 8); str_println(path); }
    } else {
        println("  (no implementation)");
    }

    # Print lang2
    syscall(1, 1, "\n--- ", 5);
    syscall(1, 1, lang_name(l2), strlen(lang_name(l2)));
    println(" ---");
    if (ex2 != 0) {
        var expl2 = example_explanation(ex2);
        if (expl2 != 0 && str_len(expl2) > 0) { str_println(expl2); println(""); }
        var path2 = example_path(ex2);
        if (path2 != 0) { syscall(1, 1, "  file: ", 8); str_println(path2); }
    } else {
        println("  (no implementation)");
    }

    return 0;
}

# ================================================================
# Code rendering — vyakarana token integration (added 2.7.0)
# ================================================================
#
# Vidya does not currently render source code anywhere; the
# `info`/`compare` surfaces return metadata + file paths only.
# Wiring vyakarana is therefore additive — a `code` CLI command
# and a `/code/{topic}/{lang}` HTTP route, sharing one tokenize
# helper.
#
# `lang_stem(l)` ("rust", "python", "asm_x86_64", "cyrius", …)
# already matches the names vyakarana grammars are registered
# under. The one mismatch is OpenQASM (vyakarana ships no qasm
# grammar in 2.2.1); `has_grammar()` short-circuits that case
# so we still return the source body, just with no tokens.
#
# 2.7.1: migrated from 1.x `tokenize_source(src, lang)` to the
# 2.x streaming API (`tokenize_stream_new` / `_feed` / `_finish`
# / `_free`) per vyakarana ADR 0017. Same observable output;
# the dance is captured at each call site.

# ANSI SGR opener for a vyakarana kind name. Empty string for
# kinds that should render in the terminal default. Reset with
# "\x1b[0m" after each token.
fn ansi_open_for_kind(kname) {
    if (streq(kname, "keyword") == 1)      { return "\x1b[34;1m"; }   # bright blue
    if (streq(kname, "string") == 1)       { return "\x1b[32m"; }     # green
    if (streq(kname, "number") == 1)       { return "\x1b[36m"; }     # cyan
    if (streq(kname, "comment") == 1)      { return "\x1b[2m"; }      # dim
    if (streq(kname, "operator") == 1)     { return "\x1b[35m"; }     # magenta
    if (streq(kname, "preprocessor") == 1) { return "\x1b[33m"; }     # yellow
    if (streq(kname, "error") == 1)        { return "\x1b[41;97m"; }  # red bg, white fg
    return "";
}

# Read example source for (concept, lang) into a freshly null-
# terminated cstr. Returns 0 if the example is missing.
fn read_example_cstr(concept, lang) {
    var ex = get_example(concept, lang);
    if (ex == 0) { return 0; }
    var code = example_code(ex);
    if (code == 0) { return 0; }
    return to_cstr(code);
}

# CLI: `vidya code <topic> <lang>`
fn cmd_code(topic_id, lang_str) {
    var concept = reg_get(topic_id);
    if (concept == 0) {
        sys_write(STDERR_FD, "error: topic not found: ", 24);
        println(topic_id);
        return 1;
    }
    var l = lang_parse(lang_str);
    if (l < 0) {
        sys_write(STDERR_FD, "error: unknown language: ", 25);
        println(lang_str);
        return 1;
    }
    var src = read_example_cstr(concept, l);
    if (src == 0) {
        println("(no implementation in this language)");
        return 1;
    }
    var stem = lang_stem(l);
    var src_len = strlen(src);

    # No vyakarana grammar (e.g. openqasm in 2.2.1) — print plain.
    if (has_grammar(stem) == 0) {
        sys_write(1, src, src_len);
        if (src_len > 0 && load8(src + src_len - 1) != 10) { println(""); }
        return 0;
    }

    # vyakarana 2.x streaming API (ADR 0017): new → feed → finish → free.
    var stream = tokenize_stream_new(stem);
    if (stream == 0) {
        sys_write(1, src, src_len);
        if (src_len > 0 && load8(src + src_len - 1) != 10) { println(""); }
        return 0;
    }
    var tb = tokenbuf_new();
    tokenize_stream_feed(stream, src, src_len);
    tokenize_stream_finish(stream, tb);
    tokenize_stream_free(stream);

    var n = tokenbuf_count(tb);
    var i = 0;
    while (i < n) {
        var k  = tokenbuf_kind(tb, i);
        var s  = tokenbuf_start(tb, i);
        var lt = tokenbuf_len(tb, i);
        var open = ansi_open_for_kind(kind_name(k));
        var olen = strlen(open);
        if (olen > 0) { sys_write(1, open, olen); }
        sys_write(1, src + s, lt);
        if (olen > 0) { sys_write(1, "\x1b[0m", 4); }
        i = i + 1;
    }
    if (src_len > 0 && load8(src + src_len - 1) != 10) { println(""); }
    return 0;
}

# ================================================================
# Validate — compile/run examples
# ================================================================
#
# DIAGNOSTIC surface, not the gate. `scripts/validate-content.sh` is what
# CI runs and what a release blocks on; this subcommand mirrors its
# commands so the two agree, and prints that reminder in its summary.
#
# Post-2.8.1 fix — this reported 462 false FAILs of 847 on a box with
# every toolchain installed. Three independent bugs in the old
# hand-rolled fork/exec, all fixed here:
#   1. `sys_execve(..., 0)` handed the child an EMPTY environment. sh
#      synthesises a default PATH for its own lookups but exports
#      nothing, so: rustc (rustup, ~/.cargo/bin) was not on the default
#      PATH, gcc could not exec cc1, go had no GOCACHE/HOME, zig had no
#      cache dir, npx had no HOME, and the cyrius template's $HOME
#      expanded to "". Every failure message was an unset-env symptom.
#   2. `var sh_argv[4]` / `var status_buf[1]` — `var buf[N]` reserves N
#      BYTES, so a 4-pointer argv needs 32 and a wait status needs 4.
#      Both under-reserved and scribbled over neighbouring stack slots
#      (same class as the cyrius stdlib's own v5.11.60 _exec3 fix).
#   3. the asm templates ended `... ; rm -f {out}.o`, so `sh` exited with
#      rm's status — a failing assembly example reported PASS.
# Exec now runs through the stdlib's `exec_cmd` (lib/process.cyr), which
# sizes its buffers correctly and forwards /proc/self/environ to the
# child; temp-file cleanup moved out of the templates into validate_one.

var VALIDATE_SKIP = 0 - 1;      # no example on disk / no command template
var VALIDATE_NO_TOOL = 0 - 2;   # language toolchain not installed

# Toolchain probe cache, one slot per Lang: 0 = unprobed, 1 = present,
# 2 = missing. `var buf[N]` is N BYTES — LANG_COUNT × 8 B.
var _tool_probe[88];

# Shell command that exits 0 iff this language's toolchain is installed.
# A missing toolchain is a SKIP, not a FAIL — same contract as
# scripts/validate-content.sh, which counts them separately.
fn validate_probe(lang) {
    if (lang == RUST) { return "command -v rustc >/dev/null 2>&1"; }
    if (lang == PYTHON) { return "command -v python3 >/dev/null 2>&1"; }
    if (lang == C_LANG) { return "command -v gcc >/dev/null 2>&1"; }
    if (lang == GO) { return "command -v go >/dev/null 2>&1"; }
    if (lang == TYPESCRIPT) { return "command -v npx >/dev/null 2>&1"; }
    if (lang == SHELL) { return "command -v bash >/dev/null 2>&1"; }
    if (lang == ZIG) { return "command -v zig >/dev/null 2>&1"; }
    if (lang == ASM_X86_64) { return "command -v as >/dev/null 2>&1 && command -v ld >/dev/null 2>&1"; }
    # binutils ships as+ld together, so probing the assembler covers the
    # linker; qemu is the part that is separately packaged.
    if (lang == ASM_AARCH64) {
        return "command -v aarch64-linux-gnu-as >/dev/null 2>&1 && command -v qemu-aarch64 >/dev/null 2>&1";
    }
    if (lang == OPENQASM) { return "python3 -c \"import qiskit\" >/dev/null 2>&1"; }
    if (lang == CYRIUS) { return "command -v cyrius >/dev/null 2>&1"; }
    return 0;
}

# Probe once per language per process, then serve from the cache.
fn toolchain_present(lang) {
    var slot = &_tool_probe + lang * 8;
    var cached = load64(slot);
    if (cached == 1) { return 1; }
    if (cached == 2) { return 0; }
    var probe = validate_probe(lang);
    if (probe == 0) { store64(slot, 2); return 0; }
    if (exec_cmd(probe) == 0) { store64(slot, 1); return 1; }
    store64(slot, 2);
    return 0;
}

# Command template. {file} = example path, {out} = scratch binary,
# {content} = content root. Kept in lockstep with the per-language
# commands in scripts/validate-content.sh — no cleanup verbs here, the
# caller unlinks {out} and {out}.o so a trailing `rm` can never mask a
# non-zero exit status.
fn validate_command(lang) {
    # Additive --test pass for files carrying test blocks — see the matching
    # comment in scripts/validate-content.sh. Everything behind #[cfg(test)]
    # is otherwise never compiled.
    if (lang == RUST) {
        return "rustc --edition 2024 {file} -o {out} && {out} && if grep -qE '#\\[test\\]|#\\[cfg\\(test\\)\\]' {file}; then rustc --edition 2024 --test {file} -o {out}_t && {out}_t --test-threads=1; fi";
    }
    if (lang == PYTHON) { return "python3 {file}"; }
    if (lang == C_LANG) { return "gcc -std=c23 -Wall -Werror {file} -o {out} -lm -lpthread && {out}"; }
    if (lang == GO) { return "go run {file}"; }
    if (lang == TYPESCRIPT) { return "npx tsx {file}"; }
    if (lang == SHELL) { return "bash {file}"; }
    if (lang == ZIG) { return "zig build-exe {file} -femit-bin={out} && {out}"; }
    if (lang == ASM_X86_64) { return "as --64 {file} -o {out}.o && ld {out}.o -o {out} && {out}"; }
    if (lang == ASM_AARCH64) {
        return "aarch64-linux-gnu-as {file} -o {out}.o && aarch64-linux-gnu-ld {out}.o -o {out} && qemu-aarch64 {out}";
    }
    if (lang == OPENQASM) {
        return "python3 -c \"from qiskit import qasm2; qasm2.load('{file}', include_path=['{content}'])\"";
    }
    if (lang == CYRIUS) { return "cyrius run {file}"; }
    return 0;
}

fn validate_one(concept, lang) {
    var ex = get_example(concept, lang);
    if (ex == 0) { return VALIDATE_SKIP; }

    var path = example_path(ex);
    if (path == 0) { return VALIDATE_SKIP; }

    var cmd_template = validate_command(lang);
    if (cmd_template == 0) { return VALIDATE_SKIP; }
    if (toolchain_present(lang) == 0) { return VALIDATE_NO_TOOL; }

    # Build file path: content_dir / relative_path
    var file_path = path_join(_content_dir, path);

    # Build output path
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/vidya_test_");
    str_builder_add(sb, concept_id(concept));
    str_builder_add_cstr(sb, "_");
    str_builder_add_cstr(sb, lang_stem(lang));
    var out_path = str_builder_build(sb);

    # ... and the object file the two assembly templates emit next to it
    var sbo = str_builder_new();
    str_builder_add(sbo, out_path);
    str_builder_add_cstr(sbo, ".o");
    var obj_path = str_builder_build(sbo);

    # Substitute {file}, {out} and {content} in the template
    var cmd = str_replace_all(str_from(cmd_template), str_from("{file}"), file_path);
    cmd = str_replace_all(cmd, str_from("{out}"), out_path);
    cmd = str_replace_all(cmd, str_from("{content}"), _content_dir);

    # exec_cmd: /bin/sh -c with the parent's environment forwarded.
    var rc = exec_cmd(str_data(cmd));

    # Clean up
    sys_unlink(str_data(out_path));
    sys_unlink(str_data(obj_path));

    # exec_cmd returns -1 for fork failure or a signal-killed child
    # (SIGSEGV/SIGABRT are ordinary outcomes for a broken C or asm
    # example) — those are failures, and must not alias the skip
    # sentinel.
    if (rc < 0) { return 1; }
    return rc;
}

fn cmd_validate(topic_filter) {
    var pass = 0;
    var fail = 0;
    var skip = 0;
    var entries = reg_list();
    var count = vec_len(entries);
    var i = 0;

    println("=== Validate ===");

    while (i < count) {
        var c = vec_get(entries, i);
        var id = concept_id(c);

        # Filter by topic if specified
        if (topic_filter != 0) {
            if (str_eq(id, str_from(topic_filter)) == 0) {
                i = i + 1;
                continue;
            }
        }

        var examples = concept_examples(c);
        if (examples != 0) {
            var ei = 0;
            while (ei < vec_len(examples)) {
                var ex = vec_get(examples, ei);
                var lang = example_lang(ex);
                var r = validate_one(c, lang);
                if (r == VALIDATE_SKIP) {
                    skip = skip + 1;
                }
                elif (r == VALIDATE_NO_TOOL) {
                    skip = skip + 1;
                    syscall(1, 1, "  SKIP: ", 8);
                    str_print(id);
                    syscall(1, 1, "/", 1);
                    syscall(1, 1, lang_name(lang), strlen(lang_name(lang)));
                    println(" (toolchain not installed)");
                }
                elif (r == 0) {
                    pass = pass + 1;
                    syscall(1, 1, "  PASS: ", 8);
                    str_print(id);
                    syscall(1, 1, "/", 1);
                    println(lang_name(lang));
                } else {
                    fail = fail + 1;
                    syscall(1, 1, "  FAIL: ", 8);
                    str_print(id);
                    syscall(1, 1, "/", 1);
                    println(lang_name(lang));
                }
                ei = ei + 1;
            }
        }
        i = i + 1;
    }

    println("");
    fmt_int(pass);
    syscall(1, 1, " passed, ", 9);
    fmt_int(fail);
    syscall(1, 1, " failed, ", 9);
    fmt_int(skip);
    println(" skipped");
    println("note: authoritative content gate is scripts/validate-content.sh");
    return fail;
}

# ================================================================
# JSON emission helpers
# ================================================================
# Every user- and content-derived string goes out through
# sandhi_json_escape. It returns a *fully quoted* JSON string literal
# (it emits its own surrounding quotes), so callers must not wrap the
# result in quotes of their own.
#
# Skipping this is a structure-injection hole, not a cosmetic one:
# sandhi percent-decodes query params before we ever see them
# (sandhi_server_get_param_a -> sandhi_server_url_decode_a), so a
# request for /search?q=a%22b arrives as a raw `"` and closes the
# string early. A crafted query yields a *parseable* document with
# attacker-chosen keys and a duplicated count/results pair.

# Static enum literals (lang_name / lang_extension / lang_stem /
# kind_name) are still emitted with bare quotes: they are compile-time
# constants with no escapable byte in them, and routing them through
# the escaper would allocate once per element on /list and /gaps (the
# serve-path bump allocator never resets between requests).
#
# cstr variant — input must be NUL-terminated (query params, static
# literals). 0 renders as an empty JSON string.
fn json_add_cstr(sb, c) {
    if (c == 0) { return str_builder_add_cstr(sb, "\"\""); }
    return str_builder_add_cstr(sb, sandhi_json_escape(c));
}

# Str variant — a Str is a borrowed (data, len) pair and is NOT
# guaranteed NUL-terminated (toml_get hands back slices into the file
# buffer; see the tags note in `search`), so bridge through to_cstr
# before escaping. 0 renders as an empty JSON string.
fn json_add_str(sb, s) {
    return json_add_cstr(sb, to_cstr(s));
}

# vec_len with a null-vec guard.
#
# NB: `v != 0 && vec_len(v)` does NOT work as a count — cyrius `&&`
# yields 0/1, so every count collapses to a boolean. That is exactly
# how /info/{topic} came to report best_practices/gotchas/
# performance_notes as 1 for every topic (2.8.1 fix). The CLI path
# gets it right because it uses the `&&` as a *guard*
# (`bps != 0 && vec_len(bps) > 0`), never as the value.
fn vec_count(v) {
    if (v == 0) { return 0; }
    return vec_len(v);
}

# ================================================================
# JSON builders for each endpoint
# ================================================================

fn json_stats_response() {
    var entries = reg_list();
    var total = vec_len(entries);
    var total_examples = 0;
    var complete = 0;
    var i = 0;
    while (i < total) {
        var c = vec_get(entries, i);
        var examples = concept_examples(c);
        var nex = 0;
        if (examples != 0) { nex = vec_len(examples); }
        total_examples = total_examples + nex;
        if (nex >= LANG_COUNT) { complete = complete + 1; }
        i = i + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"topics\":");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, ",\"complete\":");
    str_builder_add_int(sb, complete);
    str_builder_add_cstr(sb, ",\"examples\":");
    str_builder_add_int(sb, total_examples);
    str_builder_add_cstr(sb, ",\"languages\":");
    str_builder_add_int(sb, LANG_COUNT);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn json_list_response() {
    var entries = reg_list();
    var total = vec_len(entries);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < total) {
        var c = vec_get(entries, i);
        var id = concept_id(c);
        var topic = concept_topic(c);
        var examples = concept_examples(c);
        var nex = 0;
        if (examples != 0) { nex = vec_len(examples); }
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"id\":");
        json_add_str(sb, id);
        str_builder_add_cstr(sb, ",\"topic\":");
        json_add_str(sb, topic);
        str_builder_add_cstr(sb, ",\"languages\":");
        str_builder_add_int(sb, nex);
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

fn json_info_response(topic_id) {
    var concept = reg_get(topic_id);
    if (concept == 0) { return 0; }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"id\":");
    json_add_str(sb, concept_id(concept));
    str_builder_add_cstr(sb, ",\"title\":");
    json_add_str(sb, concept_title(concept));
    str_builder_add_cstr(sb, ",\"topic\":");
    json_add_str(sb, concept_topic(concept));
    str_builder_add_cstr(sb, ",\"description\":");
    json_add_str(sb, concept_desc(concept));

    # Tags
    str_builder_add_cstr(sb, ",\"tags\":[");
    var tags = concept_tags(concept);
    if (tags != 0) {
        var ti = 0;
        while (ti < vec_len(tags)) {
            if (ti > 0) { str_builder_add_cstr(sb, ","); }
            json_add_str(sb, vec_get(tags, ti));
            ti = ti + 1;
        }
    }

    # Languages
    str_builder_add_cstr(sb, "],\"languages\":[");
    var examples = concept_examples(concept);
    if (examples != 0) {
        var ei = 0;
        while (ei < vec_len(examples)) {
            var ex = vec_get(examples, ei);
            if (ei > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            str_builder_add_cstr(sb, lang_name(example_lang(ex)));
            str_builder_add_cstr(sb, "\"");
            ei = ei + 1;
        }
    }

    # Best practices count, gotchas count, perf notes count
    var bps = concept_best_practices(concept);
    var gotchas = concept_gotchas(concept);
    var pnotes = concept_perf_notes(concept);
    str_builder_add_cstr(sb, "],\"best_practices\":");
    str_builder_add_int(sb, vec_count(bps));
    str_builder_add_cstr(sb, ",\"gotchas\":");
    str_builder_add_int(sb, vec_count(gotchas));
    str_builder_add_cstr(sb, ",\"performance_notes\":");
    str_builder_add_int(sb, vec_count(pnotes));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn json_search_response(query) {
    var results = search(query);
    var count = vec_len(results);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"query\":");
    json_add_cstr(sb, query);
    str_builder_add_cstr(sb, ",\"count\":");
    str_builder_add_int(sb, count);
    str_builder_add_cstr(sb, ",\"results\":[");
    var i = 0;
    while (i < count) {
        var c = vec_get(results, i);
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"id\":");
        json_add_str(sb, concept_id(c));
        str_builder_add_cstr(sb, ",\"description\":");
        json_add_str(sb, concept_desc(c));
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

fn json_languages_response() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var li = 0;
    while (li < LANG_COUNT) {
        if (li > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"name\":\"");
        str_builder_add_cstr(sb, lang_name(li));
        str_builder_add_cstr(sb, "\",\"extension\":\"");
        str_builder_add_cstr(sb, lang_extension(li));
        str_builder_add_cstr(sb, "\"}");
        li = li + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

fn json_compare_response(topic_id, lang1_str, lang2_str) {
    # Returns 0 if topic not found; sentinel -1 if either language is unknown.
    # Caller distinguishes these to emit 404 vs 400.
    var concept = reg_get(topic_id);
    if (concept == 0) { return 0; }
    var l1 = lang_parse(lang1_str);
    var l2 = lang_parse(lang2_str);
    if (l1 < 0) { return 0 - 1; }
    if (l2 < 0) { return 0 - 1; }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"topic\":");
    json_add_str(sb, concept_id(concept));
    str_builder_add_cstr(sb, ",\"title\":");
    json_add_str(sb, concept_title(concept));
    str_builder_add_cstr(sb, ",");

    # left
    str_builder_add_cstr(sb, "\"left\":{\"language\":\"");
    str_builder_add_cstr(sb, lang_name(l1));
    str_builder_add_cstr(sb, "\",");
    var ex1 = get_example(concept, l1);
    if (ex1 != 0) {
        str_builder_add_cstr(sb, "\"present\":true,\"path\":");
        json_add_str(sb, example_path(ex1));
    } else {
        str_builder_add_cstr(sb, "\"present\":false");
    }
    str_builder_add_cstr(sb, "},");

    # right
    str_builder_add_cstr(sb, "\"right\":{\"language\":\"");
    str_builder_add_cstr(sb, lang_name(l2));
    str_builder_add_cstr(sb, "\",");
    var ex2 = get_example(concept, l2);
    if (ex2 != 0) {
        str_builder_add_cstr(sb, "\"present\":true,\"path\":");
        json_add_str(sb, example_path(ex2));
    } else {
        str_builder_add_cstr(sb, "\"present\":false");
    }
    str_builder_add_cstr(sb, "}}");

    return str_builder_build(sb);
}

fn json_code_response(topic_id, lang_str) {
    var concept = reg_get(topic_id);
    if (concept == 0) { return 0; }
    var l = lang_parse(lang_str);
    if (l < 0) { return 0 - 1; }
    var ex = get_example(concept, l);
    if (ex == 0) { return 0; }

    var src = read_example_cstr(concept, l);
    if (src == 0) { return 0; }
    var stem = lang_stem(l);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"topic\":");
    json_add_str(sb, concept_id(concept));
    str_builder_add_cstr(sb, ",\"language\":");
    json_add_cstr(sb, stem);
    str_builder_add_cstr(sb, ",\"path\":");
    json_add_str(sb, example_path(ex));
    str_builder_add_cstr(sb, ",\"source\":");
    # sandhi_json_escape returns a fully-quoted JSON string literal.
    str_builder_add_cstr(sb, sandhi_json_escape(src));
    str_builder_add_cstr(sb, ",\"tokens\":[");

    if (has_grammar(stem) == 1) {
        var stream = tokenize_stream_new(stem);
        if (stream != 0) {
            var tb = tokenbuf_new();
            tokenize_stream_feed(stream, src, strlen(src));
            tokenize_stream_finish(stream, tb);
            tokenize_stream_free(stream);
            var n = tokenbuf_count(tb);
            var i = 0;
            while (i < n) {
                if (i > 0) { str_builder_add_cstr(sb, ","); }
                var k  = tokenbuf_kind(tb, i);
                var s  = tokenbuf_start(tb, i);
                var lt = tokenbuf_len(tb, i);
                str_builder_add_cstr(sb, "{\"kind\":\"");
                str_builder_add_cstr(sb, kind_name(k));
                str_builder_add_cstr(sb, "\",\"start\":");
                str_builder_add_int(sb, s);
                str_builder_add_cstr(sb, ",\"len\":");
                str_builder_add_int(sb, lt);
                str_builder_add_cstr(sb, "}");
                i = i + 1;
            }
        }
    }

    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

fn json_gaps_response() {
    var entries = reg_list();
    var total = vec_len(entries);
    var total_missing = 0;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"topics\":");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, ",\"languages\":");
    str_builder_add_int(sb, LANG_COUNT);
    str_builder_add_cstr(sb, ",\"gaps\":[");

    var first_gap = 1;
    var i = 0;
    while (i < total) {
        var c = vec_get(entries, i);
        var examples = concept_examples(c);
        var nex = 0;
        if (examples != 0) { nex = vec_len(examples); }

        if (nex < LANG_COUNT) {
            if (first_gap == 0) { str_builder_add_cstr(sb, ","); }
            first_gap = 0;
            str_builder_add_cstr(sb, "{\"id\":");
            json_add_str(sb, concept_id(c));
            str_builder_add_cstr(sb, ",\"covered\":");
            str_builder_add_int(sb, nex);
            str_builder_add_cstr(sb, ",\"of\":");
            str_builder_add_int(sb, LANG_COUNT);
            str_builder_add_cstr(sb, ",\"missing\":[");

            var first_lang = 1;
            var li = 0;
            while (li < LANG_COUNT) {
                var found = 0;
                if (examples != 0) {
                    var ei = 0;
                    while (ei < vec_len(examples)) {
                        if (example_lang(vec_get(examples, ei)) == li) { found = 1; }
                        ei = ei + 1;
                    }
                }
                if (found == 0) {
                    if (first_lang == 0) { str_builder_add_cstr(sb, ","); }
                    first_lang = 0;
                    str_builder_add_cstr(sb, "\"");
                    str_builder_add_cstr(sb, lang_name(li));
                    str_builder_add_cstr(sb, "\"");
                    total_missing = total_missing + 1;
                }
                li = li + 1;
            }
            str_builder_add_cstr(sb, "]}");
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"total_missing\":");
    str_builder_add_int(sb, total_missing);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}
