# Testing — Cyrius reference (runnable)
# Patterns: assert, assert_eq, assert_neq, assert_gt, assert_summary

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

fn add(a, b) { return a + b; }

# Every assertion below checks a value the code under test computed. An
# assert on two literals (`assert(1 == 1)`, `assert_eq(0, 0)`) can never fail,
# so it tests nothing.
fn test_assertions() {
    assert(add(1, 1) == 2, "assert on a computed comparison");
    assert_eq(add(2, 3), 5, "add");
    assert_neq(add(1, 1), 3, "neq");
    assert_gt(add(10, 5), 10, "gt");
    return 0;
}

fn test_comparisons_in_args() {
    var a = add(40, 2);
    # Comparisons work in function call arguments
    assert(a == 42, "comp in arg");
    assert(a > 0, "gt in arg");
    assert(a != 0, "neq in arg");
    return 0;
}

fn test_edge_cases() {
    assert_eq(add(0, 0), 0, "zero + zero");
    assert_eq(add(0 - 1, 0 - 1), 0 - 2, "negative operands");
    assert_eq(add(0 - 7, 7), 0, "inverse operands cancel");
    assert_gt(add(1, 0), 0, "identity keeps sign");
    assert_neq(add(0, 1), 0, "adding one changes zero");
    return 0;
}

fn main() {
    alloc_init();
    test_assertions();
    test_comparisons_in_args();
    test_edge_cases();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
