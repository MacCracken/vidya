# Vidya — Binary Formats in Cyrius
#
# PATTERN-FOCUSED: documents the ELF64 executable format through
# Cyrius's own output, and checks it against the running binary
# (/proc/self/exe) rather than against literals.
#
# The bootstrap shape (the seed and the early cc2 compiler) was the
# simplest valid Linux executable: a flat ELF, no dynamic linking, no
# relocations, no section headers:
#   Bytes 0-63:   ELF header (64 bytes)
#   Bytes 64-119: Program header (56 bytes, one RWX PT_LOAD)
#   Bytes 120+:   Machine code + data      (entry = BASE + 120)
#
# Today's compiler, cycc (6.7.18), still emits a static ET_EXEC with no
# dynamic linking, but with TWO PT_LOADs — code R+X and data R+W (W^X by
# default since v6.3.12; CYRIUS_WX=0 opts back into one RWE segment) —
# so the entry is BASE + 64 + 2*56 = 0x4000B0, plus a small section
# header table (5 entries) for tools. The kernel reads only the ELF
# header and the program headers.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"
include "lib/syscalls.cyr"

# The running program's own first 256 bytes: ELF header + program headers.
var self_hdr: u8[256];
var self_hdr_len = 0;

# Read /proc/self/exe's header once. Returns 1 on success, 0 on failure.
fn read_self_header() {
    if (self_hdr_len > 0) { return 1; }
    var fd = syscall(SYS_OPEN, "/proc/self/exe", 0, 0);
    if (fd < 0) { return 0; }
    var n = syscall(SYS_READ, fd, &self_hdr, 256);
    syscall(SYS_CLOSE, fd);
    if (n < 64) { return 0; }
    self_hdr_len = n;
    return 1;
}

# ================================================================
# Binary Layout — the bootstrap (seed / cc2) shape
# ================================================================
# The bootstrap output is the simplest valid ELF:
#   ehdr (64B) + phdr (56B) + code (NB) + data (MB)
# All in one PT_LOAD segment. No gaps, no alignment padding.
# (cycc's current two-segment layout is checked from /proc/self/exe below.)

fn test_binary_layout() {
    var ehdr_size = 64;
    var phdr_size = 56;
    var header_total = ehdr_size + phdr_size;
    assert_eq(header_total, 120, "header overhead = 120 bytes");

    # Code starts at offset 120
    var code_start = header_total;
    assert_eq(code_start, 120, "code starts at byte 120");

    # Data (string literals, variables) follows code
    # For a seed binary with 79 bytes of code+data:
    var seed_code_data = 79;
    var seed_total = header_total + seed_code_data;
    assert_eq(seed_total, 199, "seed binary = 199 bytes");

    # For stage1a with constant-folded output:
    # mov rdi, result (7B) + push rdi (1B) + 16 bytes template = 24B code
    # But code is padded to 24B (3 qwords) for alignment
    var stage1a_code = 24;
    var stage1a_total = header_total + stage1a_code;
    assert_eq(stage1a_total, 144, "stage1a output = 144 bytes");
    return 0;
}

# ================================================================
# ELF Header — 64 bytes, read back from the running binary
# ================================================================
# Field offsets (ELF64): e_ident[16], e_type @16, e_machine @18,
# e_entry @24, e_phoff @32, e_ehsize @52, e_phentsize @54, e_phnum @56,
# e_shnum @60.

fn test_elf_header_constants() {
    assert_eq(read_self_header(), 1, "read /proc/self/exe");
    var h = &self_hdr;
    # Magic: \x7fELF
    assert_eq(load8(h + 0), 0x7F, "magic 0x7F");
    assert_eq(load8(h + 1), 0x45, "magic 'E'");
    assert_eq(load8(h + 2), 0x4C, "magic 'L'");
    assert_eq(load8(h + 3), 0x46, "magic 'F'");
    assert_eq(load8(h + 4), 2, "EI_CLASS = ELFCLASS64");
    assert_eq(load8(h + 5), 1, "EI_DATA = ELFDATA2LSB (little-endian)");
    assert_eq(load16(h + 16), 2, "e_type = ET_EXEC (not PIE, not shared)");
    assert_eq(load16(h + 18), 62, "e_machine = EM_X86_64 (0x3E)");
    assert_eq(load16(h + 52), 64, "e_ehsize = 64");
    assert_eq(load16(h + 54), 56, "e_phentsize = 56");
    assert_eq(load64(h + 32), 64, "e_phoff = 64: program headers follow the ELF header");
    # The first instruction sits right after the program headers:
    # entry = BASE + 64 + e_phnum * 56 (0x4000B0 for cycc's two headers;
    # it was BASE + 120 = 0x400078 for the one-header bootstrap shape).
    var phnum = load16(h + 56);
    assert_eq(load64(h + 24), 0x400000 + 64 + phnum * 56, "e_entry = BASE + headers");
    assert(load16(h + 60) > 0, "cycc emits a section header table (e_shnum > 0)");
    return 0;
}

# ================================================================
# Program Headers — 56 bytes each
# ================================================================
# The bootstrap shape used ONE PT_LOAD for everything, flags R+W+X (7).
# cycc splits code (R+X) from data (R+W), so no page is both writable
# and executable (W^X). Phdr field offsets: p_type @0, p_flags @4,
# p_offset @8, p_vaddr @16, p_filesz @32, p_memsz @40, p_align @48.

fn test_program_header_constants() {
    assert_eq(read_self_header(), 1, "read /proc/self/exe");
    var h = &self_hdr;
    var phnum = load16(h + 56);
    assert_eq(phnum, 2, "cycc: two PT_LOADs (code, data)");
    assert(64 + phnum * 56 <= self_hdr_len, "both program headers were read");
    var code = h + 64;
    var data = h + 64 + 56;
    var pf_r = 4;
    var pf_w = 2;
    var pf_x = 1;
    assert_eq(load32(code), 1, "phdr 0 is PT_LOAD");
    assert_eq(load32(code + 4), pf_r + pf_x, "code segment R+X (no W)");
    assert_eq(load32(data), 1, "phdr 1 is PT_LOAD");
    assert_eq(load32(data + 4), pf_r + pf_w, "data segment R+W (no X): W^X");
    assert_eq(load64(code + 8), 0, "code p_offset = 0 (the headers are mapped too)");
    assert_eq(load64(code + 16), 0x400000, "code p_vaddr = 0x400000 (static base)");
    assert_eq(load64(code + 48), 0x1000, "p_align = 4 KB page");
    # p_memsz may exceed p_filesz: the excess is zero-filled (variables).
    assert(load64(data + 40) >= load64(data + 32), "data p_memsz >= p_filesz");
    return 0;
}

# ================================================================
# Sections — optional for the kernel
# ================================================================
# Section headers are for the linker and debugger, not the kernel. The
# bootstrap shape set e_shoff = e_shnum = 0 and still ran; cycc emits a
# small table (checked above) so tools like readelf and gdb can see it.

fn test_no_sections() {
    # What a static executable does not need for a static bootstrap binary:
    # .symtab  — no symbols to look up
    # .strtab  — no symbol names
    # .shstrtab — no section names
    # .rel.*   — no relocations (all addresses are absolute)
    # .dynamic — no shared libraries
    # .interp  — no dynamic linker

    # Each section header is 64 bytes. A typical binary has ~20:
    var shdr_size = 64;
    var typical_count = 20;
    var savings = shdr_size * typical_count;
    assert_eq(savings, 1280, "saved 1280 bytes vs typical binary");
    return 0;
}

# ================================================================
# No Dynamic Linking — static is simplest
# ================================================================
# Dynamic linking adds complexity:
#   PT_INTERP — path to ld-linux-x86-64.so.2
#   PT_DYNAMIC — DT_NEEDED, DT_STRTAB, DT_SYMTAB entries
#   GOT/PLT — indirection for external symbols
#   .dynstr, .dynsym — dynamic symbol tables
#
# Cyrius avoids all of this. Every symbol is resolved at compile time.
# Every address is absolute. The binary is self-contained.

fn test_no_dynamic_linking() {
    # PT_INTERP = 3 (dynamic linker path segment)
    # PT_DYNAMIC = 2 (dynamic linking info segment)
    # Neither appears in the running binary's program headers.
    var pt_interp = 3;
    var pt_dynamic = 2;
    assert_eq(read_self_header(), 1, "read /proc/self/exe");
    var phnum = load16(&self_hdr + 56);
    var dyn_seen = 0;
    var i = 0;
    while (i < phnum) {
        var t = load32(&self_hdr + 64 + i * 56);
        if (t == pt_interp) { dyn_seen = 1; }
        if (t == pt_dynamic) { dyn_seen = 1; }
        i = i + 1;
    }
    assert_eq(dyn_seen, 0, "no PT_INTERP / PT_DYNAMIC: statically linked");

    # Dynamic binary program header count: typically 5+
    # PT_PHDR + PT_INTERP + PT_LOAD(code) + PT_LOAD(data) + PT_DYNAMIC
    var dynamic_phnum = 5;
    assert(dynamic_phnum > phnum, "dynamic has more segments");

    # Each additional program header = 56 bytes overhead:
    # 3 more than cycc's 2 (4 more than the bootstrap's 1).
    assert_eq((dynamic_phnum - phnum) * 56, 168, "dynamic adds 168 bytes of phdrs over cycc's");
    return 0;
}

# ================================================================
# No Relocations — absolute addressing
# ================================================================
# Cyrius emits absolute addresses (BASE + offset) at compile time.
# No relocation entries needed. No fixup pass at load time.
# This works because:
#   1. The binary is always loaded at BASE_ADDR (not PIE)
#   2. All function addresses are known during compilation
#   3. All data addresses are known after code emission

fn test_absolute_addressing() {
    # Bootstrap shape: code starts right after the one 56-byte phdr.
    var base = 0x400000;
    var code_start = base + 120;

    # Function at code offset 200:
    var func_offset = 200;
    var func_addr = code_start + func_offset;
    assert_eq(func_addr, 0x400078 + 200, "absolute function address");

    # Data after code (say code is 500 bytes, padded to 504 = 63 qwords):
    var code_size = 500;
    var code_padded = ((code_size + 7) / 8) * 8;
    assert_eq(code_padded, 504, "padded to qword boundary");

    var data_start = code_start + code_padded;
    # Variable 0 at data_start, variable 1 at data_start + 8, etc.
    var var0_addr = data_start;
    var var1_addr = data_start + 8;
    assert_eq(var1_addr - var0_addr, 8, "variables are 8 bytes apart");

    # All of these addresses are constants baked into the machine code.
    # No GOT, no PLT, no relocation table.
    return 0;
}

# ================================================================
# Template as Constant Data — the bootstrap compiler's trick
# ================================================================
# The bootstrap compiler stored its 120-byte ELF template (one-phdr
# shape) as 15 qwords of constant data.
# To emit a binary: memcpy the template, patch p_filesz and p_memsz,
# then append code and data.

fn test_template_optimization() {
    # Template: 120 bytes = 15 qwords
    var template_bytes = 120;
    var template_qwords = template_bytes / 8;
    assert_eq(template_qwords, 15, "15 qwords");

    # Fields that need patching (byte offsets from start):
    # p_filesz at offset 96 (ehdr 64 + phdr field at 32)
    # p_memsz  at offset 104 (ehdr 64 + phdr field at 40)
    var filesz_byte = 64 + 32;
    var memsz_byte = 64 + 40;
    assert_eq(filesz_byte, 96, "p_filesz at byte 96");
    assert_eq(memsz_byte, 104, "p_memsz at byte 104");

    # These are in qword 12 and qword 13 of the template
    var filesz_qword = filesz_byte / 8;
    var memsz_qword = memsz_byte / 8;
    assert_eq(filesz_qword, 12, "p_filesz in qword 12");
    assert_eq(memsz_qword, 13, "p_memsz in qword 13");

    # Patching is a single MOV per field:
    # mov [output + 96], total_file_size
    # mov [output + 104], total_mem_size
    return 0;
}

# ================================================================
# Minimal Binary Sizes — comparison
# ================================================================

fn test_size_comparison() {
    var headers = 120;

    # exit(0): xor edi,edi (2B) + mov eax,60 (5B) + syscall (2B)
    var exit_code = 2 + 5 + 2;
    assert_eq(exit_code, 9, "exit(0) = 9 bytes");
    var exit_binary = headers + exit_code;
    assert_eq(exit_binary, 129, "exit binary = 129 bytes");

    # exit(42): mov rdi,42 (7B) + mov rax,60 (7B) + syscall (2B)
    # The 7-byte mov is REX.W C7 /0 with a sign-extended imm32; the imm64
    # form (REX.W B8+r) would be 10 bytes each.
    var exit42_code = 7 + 7 + 2;
    assert_eq(exit42_code, 16, "exit(42) = 16 bytes (imm32 sign-extended movs)");

    # Cyrius seed: Hello, Cyrius! (write + exit)
    var seed = 199;
    var seed_code = seed - headers;
    assert_eq(seed_code, 79, "seed = 79 bytes code+data");

    # stage1a constant output: always 144 bytes
    var stage1a = 144;
    var stage1a_code = stage1a - headers;
    assert_eq(stage1a_code, 24, "stage1a output = 24 bytes code");

    # C hello (static, stripped): ~800KB
    # That's 6200x larger than the exit binary
    var c_static = 800000;
    var ratio = c_static / exit_binary;
    assert(ratio > 6000, "C static is >6000x larger");
    return 0;
}

# ================================================================
# Apple Silicon Mach-O ARM64 — v5.3.x learnings
# ================================================================
# Cyrius on Apple Silicon targets Mach-O arm64 executables via
# CYRIUS_MACHO_ARM=1. The kernel has strict requirements and the
# BSD raw-SVC interface has subtle conventions that differ from
# Linux. These facts are baked into EMITMACHO_ARM64 + ESYSCALL +
# ESYSXLAT as of v5.3.1 / v5.3.6 / v5.3.13.

fn test_mach_o_header_constants() {
    # FEEDFACF — 64-bit Mach-O magic (little-endian stored, bytes
    # at file offset 0..3 read CF FA ED FE).
    var magic = 0xFEEDFACF;
    assert_eq(magic, 4277009103, "Mach-O 64-bit magic");

    # CPU_TYPE_ARM64 in mach_header_64.cputype.
    var cputype_arm64 = 0x0100000C;
    assert_eq(cputype_arm64, 16777228, "CPU_TYPE_ARM64");

    # Required flags for Apple Silicon: MH_NOUNDEFS(1) | MH_DYLDLINK(4) |
    # MH_TWOLEVEL(0x80) | MH_PIE(0x00200000) = 0x00200085.
    var flags_required = 0x00200085;
    assert_eq(flags_required, 2097285, "required mach_header flags");

    # Apple Silicon enforces 16 KB pages, not 4 KB.
    var page_size = 16384;
    assert_eq(page_size, 0x4000, "Apple Silicon page size");
    return 0;
}

fn test_pie_relative_addressing() {
    # PIE mandatory on Apple Silicon → absolute addressing via
    # MOVZ/MOVK breaks under ASLR slide. EMITMACHO_ARM64 emits
    # adrp+add pairs: adrp xN, <page>; add xN, xN, #<lo12>.
    # Page-diff is in units of 4 KB (ARM's choice, independent of
    # kernel page size).
    var adrp_base = 0x90000000;
    var adrp_mask = 0x9F00001F;
    assert_eq(adrp_base, 2415919104, "ADRP base encoding");
    assert_eq(adrp_mask, 2667577375, "ADRP imm patch mask");

    var add_base = 0x91000000;
    var add_mask = 0xFFC003FF;
    assert_eq(add_base, 2432696320, "ADD imm base");
    assert_eq(add_mask, 4290774015, "ADD imm12 patch mask");
    return 0;
}

fn test_bsd_syscall_error_convention() {
    # BSD raw SVC on macOS signals errors via the CPU carry flag —
    # on error: carry=1, x0 = errno (small positive). On success:
    # carry=0, x0 = return value. Linux uses -errno in x0.
    #
    # Cyrius's ESYSCALL appends `csneg x0, x0, x0, cc` after
    # `svc #0x80` under _TARGET_MACHO==2. Negates x0 on carry-set
    # (error) so x0 = -errno, matching Linux. Higher-level
    # `if (fd < 0)` checks then work identically on both platforms.
    var csneg_encoding = 0xDA803400;
    assert_eq(csneg_encoding, 3665835008, "csneg x0,x0,x0,cc");
    return 0;
}

fn test_bsd_svc_whitelist() {
    # Raw `svc #0x80` works on Apple Silicon for a whitelist of BSD
    # syscalls when the binary has LC_LOAD_DYLIB libSystem.B.dylib
    # in its load graph. No __stubs, no __got, no chained fixups
    # needed for this whitelist.
    #
    # Linux x86 → BSD translation (baked into ESYSXLAT):
    #   read  0→3   write 1→4   open 2→5   close 3→6
    #   mmap  9→197 mprotect 10→74 munmap 11→73 exit 60→1
    # x16 (not x8) holds the syscall number for BSD.

    # mmap flags DIFFER between platforms:
    #   Linux: MAP_PRIVATE(2) | MAP_ANONYMOUS(0x20) = 0x22 = 34
    #   macOS: MAP_PRIVATE(2) | MAP_ANON(0x1000)    = 0x1002 = 4098
    # Cross-platform code tries 0x22, falls back to 0x1002 on
    # negative return (v5.3.13 PP_IFDEF_PASS fix).
    var linux_anon_flags = 0x22;
    var macos_anon_flags = 0x1002;
    assert_eq(linux_anon_flags, 34, "Linux MAP_PRIVATE|MAP_ANONYMOUS");
    assert_eq(macos_anon_flags, 4098, "macOS MAP_PRIVATE|MAP_ANON");
    return 0;
}

fn test_mach_o_segment_layout() {
    # Multi-page __TEXT (v5.3.6+): __TEXT spans (1 + ceil((cp+spos)/16384))
    # pages. __DATA appears only when totvar > 0, placed right after __TEXT.
    # __LINKEDIT follows.
    var pagezero_size = 72;
    var linkedit_size = 72;
    var data_seg_size = 152;
    assert_eq(pagezero_size, 72, "__PAGEZERO LC");
    assert_eq(linkedit_size, 72, "__LINKEDIT LC");
    assert_eq(data_seg_size, 152, "__DATA LC (72 + 1 section)");

    # TEXT_VMADDR fixed at 0x100000000 — first 4 GB is __PAGEZERO.
    var text_vmaddr = 0x100000000;
    assert_eq(text_vmaddr, 4294967296, "__TEXT vmaddr after __PAGEZERO");
    return 0;
}

fn main() {
    alloc_init();
    test_binary_layout();
    test_elf_header_constants();
    test_program_header_constants();
    test_no_sections();
    test_no_dynamic_linking();
    test_absolute_addressing();
    test_template_optimization();
    test_size_comparison();
    test_mach_o_header_constants();
    test_pie_relative_addressing();
    test_bsd_syscall_error_convention();
    test_bsd_svc_whitelist();
    test_mach_o_segment_layout();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
