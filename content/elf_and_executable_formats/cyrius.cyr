# Vidya — ELF and Executable Formats in Cyrius
#
# The ELF64 layout, checked against a real binary: this program reads
# the first 176 bytes of its own executable (/proc/self/exe) and asserts
# the fields. cycc (Cyrius 6.7.18) emits a static, W^X ET_EXEC:
#   - ELF magic: 0x7f 'E' 'L' 'F'
#   - 64-byte ELF header, then two 56-byte program headers
#   - two PT_LOADs: code R+X at 0x400000, data R+W (since v6.3.12;
#     CYRIUS_WX=0 opts back into one RWX segment)
#   - entry point = BASE_ADDR + 64 + 2 * 56 = 0x4000B0, right after the
#     program headers
#   - a section header table (5 sections) — the kernel ignores it
#   - segment alignment: 0x1000 (4KB page)
# The historical cc2 / seed shape — ONE RWX PT_LOAD, entry 0x400078,
# no section headers, a 120-byte constant template — is noted below as
# the minimal ELF; it is not what the compiler emits today.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"
include "lib/io.cyr"

# The running binary's ELF header + both program headers (64 + 2 * 56).
var elf_hdr: u8[176];
var elf_hdr_len = 0;
fn hdr_u8(off)  { return load8(&elf_hdr + off); }
fn hdr_u16(off) { return load16(&elf_hdr + off); }
fn hdr_u32(off) { return load32(&elf_hdr + off); }
fn hdr_u64(off) { return load64(&elf_hdr + off); }

# ================================================================
# ELF Magic — the first 4 bytes of every ELF binary
# ================================================================
# 0x7f 'E' 'L' 'F' — identifies the file as ELF format.
# The kernel checks these 4 bytes before doing anything else.

fn test_elf_magic() {
    # file_read_all returns a negative errno on failure — check it before
    # trusting a single byte of the buffer.
    elf_hdr_len = file_read_all("/proc/self/exe", &elf_hdr, 176);
    assert_eq(elf_hdr_len, 176, "read 176 header bytes of /proc/self/exe");
    assert_eq(hdr_u8(0), 0x7F, "magic[0] = 0x7F");
    assert_eq(hdr_u8(1), 0x45, "magic[1] = 'E'");
    assert_eq(hdr_u8(2), 0x4C, "magic[2] = 'L'");
    assert_eq(hdr_u8(3), 0x46, "magic[3] = 'F'");
    # As a 32-bit little-endian load: 0x464C457F
    assert_eq(hdr_u32(0), 0x464C457F, "ELF magic as LE u32");
    return 0;
}

# ================================================================
# ELF Header Layout — 64 bytes
# ================================================================
# Field offsets are fixed by the ELF64 spec; each assert below loads the
# field at its offset from this program's own header.

fn test_elf_header_layout() {
    # Total ELF64 header size
    assert_eq(hdr_u16(52), 64, "e_ehsize (offset 52) = 64: ELF64 header is 64 bytes");

    # e_ident: 16 bytes at offset 0

    # Within e_ident:
    # [0:4]  = magic (\x7fELF)
    # [4]    = class (2 = 64-bit)
    # [5]    = data (1 = little-endian)
    # [6]    = version (1 = current)
    # [7]    = OS/ABI (0 = SYSV)
    # [8:16] = padding (zeros)
    assert_eq(hdr_u8(4), 2, "EI_CLASS = ELFCLASS64 (2)");
    assert_eq(hdr_u8(5), 1, "EI_DATA = ELFDATA2LSB (1, little-endian)");
    assert_eq(hdr_u8(6), 1, "EI_VERSION = EV_CURRENT (1)");

    # Field offsets (byte position within the 64-byte header):
    #   e_type 16 (u16)  e_machine 18 (u16)  e_version 20 (u32)
    #   e_entry 24 (u64) e_phoff 32 (u64)    e_shoff 40 (u64)
    #   e_flags 48 (u32) e_ehsize 52         e_phentsize 54   e_phnum 56
    #   e_shentsize 58   e_shnum 60          e_shstrndx 62 (each u16)
    assert_eq(hdr_u16(16), 2, "e_type = ET_EXEC (2)");
    assert_eq(hdr_u16(18), 62, "e_machine = EM_X86_64 (62 = 0x3E)");
    assert_eq(hdr_u32(20), 1, "e_version = 1");
    assert_eq(hdr_u64(32), 64, "e_phoff = 64: program headers follow the ELF header");
    return 0;
}

# ================================================================
# Program Header Layout — 56 bytes
# ================================================================
# cycc emits two PT_LOADs (W^X): code R+X, then data R+W. (cc2 and the
# seed emitted one R+W+X segment for the whole file.)

fn test_program_header_layout() {
    assert_eq(hdr_u16(54), 56, "e_phentsize = 56: ELF64 program header is 56 bytes");
    assert_eq(hdr_u16(56), 2, "e_phnum = 2 (code + data, W^X)");

    # Field offsets within each 56-byte program header:
    #   p_type 0 (u32)  p_flags 4 (u32)  p_offset 8   p_vaddr 16
    #   p_paddr 24      p_filesz 32      p_memsz 40   p_align 48 (u64)
    # Flags: PF_R = 4, PF_W = 2, PF_X = 1.
    var ph0 = 64;
    var ph1 = 64 + 56;
    assert_eq(hdr_u32(ph0), 1, "phdr[0].p_type = PT_LOAD (1)");
    assert_eq(hdr_u32(ph0 + 4), 4 + 1, "phdr[0].p_flags = R+X (5): code");
    assert_eq(hdr_u32(ph1), 1, "phdr[1].p_type = PT_LOAD (1)");
    assert_eq(hdr_u32(ph1 + 4), 4 + 2, "phdr[1].p_flags = R+W (6): data");
    assert(hdr_u64(ph0 + 40) >= hdr_u64(ph0 + 32), "p_memsz >= p_filesz");
    return 0;
}

# ================================================================
# Entry Point Calculation
# ================================================================
# Entry point = base_addr + ehdr_size + e_phnum * phdr_size
# Code starts immediately after the headers (no alignment gap).
# cycc: 0x400000 + 64 + 2 * 56 = 0x4000B0. (cc2's one-phdr layout gave
# 0x400000 + 120 = 0x400078.)

fn test_entry_point() {
    var base_addr = hdr_u64(64 + 16);          # phdr[0].p_vaddr
    assert_eq(base_addr, 0x400000, "code segment loads at 0x400000");
    var header_total = hdr_u16(52) + hdr_u16(56) * hdr_u16(54);
    assert_eq(header_total, 176, "ehdr + 2 phdrs = 176 bytes");

    var entry = hdr_u64(24);
    assert_eq(entry, base_addr + header_total, "e_entry = base + 176 (code right after the headers)");
    assert_eq(entry, 0x4000B0, "entry point = 0x4000B0");

    # The entry point must be inside the code PT_LOAD.
    assert(entry < base_addr + hdr_u64(64 + 40), "entry < code segment end");
    return 0;
}

# ================================================================
# Segment Alignment
# ================================================================
# p_align must be a power of 2. The kernel requires:
#   p_vaddr % p_align == p_offset % p_align
# Checked below for both of this binary's PT_LOADs.

fn test_segment_alignment() {
    var ph = 64;
    var k = 0;
    while (k < 2) {
        var align = hdr_u64(ph + 48);
        assert_eq(align, 0x1000, "p_align = 4096 (one page)");
        # Alignment check: vaddr % align == offset % align
        assert_eq(hdr_u64(ph + 16) % align, hdr_u64(ph + 8) % align,
                  "p_vaddr % p_align == p_offset % p_align");
        ph = ph + 56;
        k = k + 1;
    }
    # 0x400000 = 4194304 = 1024 * 4096 (exactly 1024 pages)
    assert_eq(hdr_u64(64 + 16) / 0x1000, 1024, "base addr = 1024 pages");
    return 0;
}

# ================================================================
# Minimal Binary Size — the historical cc2 / seed shape
# ================================================================
# The smallest valid ELF (what cc2 and the seed emitted; cycc adds a
# second PT_LOAD and section headers):
#   64 bytes: ELF header
#   56 bytes: 1 program header (PT_LOAD)
#   N  bytes: machine code
#   M  bytes: data (string literals, variables)
#
# No section headers (saves 64 bytes per section).
# No symbol table. No string table. No relocations.

fn test_minimal_binary() {
    var ehdr = 64;
    var phdr = 56;
    var headers = ehdr + phdr;
    assert_eq(headers, 120, "header overhead = 120 bytes");

    # exit(42) code: mov rdi,42 (7B) + mov rax,60 (7B) + syscall (2B) = 16 bytes
    var exit_code_size = 7 + 7 + 2;
    assert_eq(exit_code_size, 16, "exit(42) is 16 bytes of code");

    var minimal_binary = headers + exit_code_size;
    assert_eq(minimal_binary, 136, "minimal exit binary = 136 bytes");

    # Cyrius seed "Hello, Cyrius!" binary:
    # 120 headers + 79 code/data = 199 bytes
    var seed_size = 199;
    var seed_code = seed_size - headers;
    assert_eq(seed_code, 79, "seed code+data = 79 bytes");

    # Compare to C hello world:
    # gcc -static: ~800KB (4000x larger than seed)
    # gcc dynamic: ~16KB (80x larger)
    var ratio_static = 800000 / seed_size;
    assert(ratio_static > 4000, "static C is >4000x larger");
    return 0;
}

# ================================================================
# Section Headers — optional to the loader
# ================================================================
# Section headers are 64 bytes each. A typical gcc binary has ~20.
# The kernel ignores them entirely; cc2 omitted them (e_shoff =
# e_shnum = 0). cycc emits a small table (5 sections) for tools.

fn test_no_section_headers() {
    assert_eq(hdr_u16(58), 64, "e_shentsize = 64: section header is 64 bytes");
    assert(hdr_u16(60) > 0, "cycc emits a section header table (e_shnum > 0)");
    assert(hdr_u64(40) > 0, "e_shoff points past the segments");
    assert(hdr_u16(62) < hdr_u16(60), "e_shstrndx names one of the sections");
    # 20 sections would cost 20 * 64 = 1280 bytes; the loader needs none.
    return 0;
}

# ================================================================
# ELF Template — the historical cc2 constant header
# ================================================================
# cc2 stored its 120-byte header (ehdr + ONE phdr) as a constant
# template and patched only p_filesz / p_memsz per binary; e_entry was
# constant because code always started at offset 120.

fn test_elf_template() {
    # The template is 120 bytes = 15 qwords
    var template_size = 120;
    var qwords = template_size / 8;
    assert_eq(qwords, 15, "template = 15 qwords");

    # Fields cc2 patched per binary:
    # p_filesz (at phdr offset 32 = absolute offset 64+32 = 96): total file size
    # p_memsz  (at phdr offset 40 = absolute offset 64+40 = 104): total memory size
    var filesz_offset = 64 + 32;
    var memsz_offset = 64 + 40;
    assert_eq(filesz_offset, 96, "p_filesz at byte 96");
    assert_eq(memsz_offset, 104, "p_memsz at byte 104");

    # Fields cc2's template never changed:
    # e_entry = 0x400078 (always code at offset 120)
    # e_phoff = 64 (always after ELF header)
    # p_type = PT_LOAD (always)
    # p_flags = 5 or 7 (R+X or R+W+X)
    # p_vaddr = 0x400000 (always)
    # p_align = 0x1000 (always)

    # In this binary the first phdr sits at the same place (byte 64), so
    # its p_filesz / p_memsz are at those same absolute offsets.
    assert(hdr_u64(filesz_offset) > 0, "p_filesz (byte 96) is the code segment's size");
    assert_eq(hdr_u64(memsz_offset), hdr_u64(filesz_offset), "code segment: p_memsz == p_filesz");
    return 0;
}

fn main() {
    alloc_init();
    test_elf_magic();
    test_elf_header_layout();
    test_program_header_layout();
    test_entry_point();
    test_segment_alignment();
    test_minimal_binary();
    test_no_section_headers();
    test_elf_template();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
