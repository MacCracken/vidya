# Error Handling — Cyrius reference (runnable)
# Patterns: error codes, Result, Option, unwrap_or

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"
include "lib/tagged.cyr"

# Error code pattern: negative = error, positive = success
fn divide(a, b) {
    if (b == 0) { return 0 - 1; }
    return a / b;
}

# Result pattern: packed (v1.5.3+) or heap-based tagged union
# Packed: Ok(v) returns v directly, Err(v) sets bit 63. Zero alloc on Ok path.
# Heap: Ok(v)/Err(v) alloc 16 bytes via tagged_new (legacy, still works).
# API is identical: is_ok(r), is_err_result(r), payload(r)
fn safe_divide(a, b) {
    if (b == 0) { return Err(1); }
    return Ok(a / b);
}

fn test_error_codes() {
    assert_eq(divide(10, 2), 5, "div ok");
    assert_eq(divide(10, 0), 0 - 1, "div by zero");
    return 0;
}

fn test_result() {
    # A Result is a (tag, payload) PAIR since v6.6.0 — `var t, v = f();` is the
    # only form that binds both. A single `var r = f();` silently keeps the TAG
    # and drops the payload, so the value is lost with no diagnostic.
    var t1, v1 = safe_divide(42, 2);
    assert(is_ok(t1) == 1, "result ok");
    assert_eq(result_unwrap(t1, v1), 21, "unwrap ok");

    var t2, v2 = safe_divide(42, 0);
    assert(is_err_result(t2) == 1, "result err");
    assert_eq(result_unwrap_or(t2, v2, 99), 99, "unwrap_or");
    return 0;
}

fn test_option() {
    # `Some(v)` carries a payload, so it binds as a PAIR. `None()` is nullary —
    # tag only, no payload register — so a single `var` is correct there and is
    # the one case where a lone binding is not a bug.
    var st, sv = Some(42);
    var nt = None();
    assert(is_some(st) == 1, "is_some");
    assert(is_none(nt) == 1, "is_none");
    assert_eq(unwrap(st, sv), 42, "unwrap some");
    # None has no payload to pass, so any value does; unwrap_or returns the fallback.
    assert_eq(unwrap_or(nt, 0, 99), 99, "unwrap_or none");
    return 0;
}

fn main() {
    alloc_init();
    test_error_codes();
    test_result();
    test_option();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
