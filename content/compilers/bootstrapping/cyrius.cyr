# Vidya — Compiler Bootstrapping in Cyrius
#
# Cyrius IS a bootstrapping compiler. This documents the patterns,
# not reimplements them. See github.com/MacCracken/cyrius for the real thing.
#
# Bootstrap chain (Cyrius 6.7.18, cyrius/bootstrap/bootstrap.sh):
#   seed bootstrap/asm (29,024 B, a committed x86_64 assembler binary —
#   the root of trust) assembles bootstrap/cybs.cyr → build/cybs
#   (23,551 B, the bootstrap compiler); cybs builds the full compiler,
#   build/cycc (2,929,832 B). Closure check: cybs assembled by the
#   cybs-built assembler must cmp-equal the cybs the seed assembled.
# Self-hosting proof: cycc compiles its own source, and the output must
#   be byte-identical to the cycc that produced it.
#
# Key concepts: seed trust, multi-stage, byte-identical verification,
# cross-compilation (x86 cycc → cycc_aarch64 → cycc-native-aarch64)
#
# Sizes at 6.7.18 (cyrius docs/development/state.md): cycc 2,929,832 B
# (x86_64), cycc_aarch64 2,737,832 B, cycc-native-aarch64 3,155,368 B.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

# ================================================================
# Bootstrap Chain — the Cyrius architecture
# ================================================================

# Stage sizes in bytes (Cyrius 6.7.18)
var SEED_BYTES = 29024;        # bootstrap/asm — the committed seed assembler
var CYBS_BYTES = 23551;        # build/cybs — bootstrap compiler the seed assembles
var CYCC_BYTES = 2929832;      # build/cycc — the full compiler
var CYCC_ARM_BYTES = 2737832;  # build/cycc_aarch64 — x86-hosted, emits aarch64

# Each stage compiles the next. The seed is the root of trust.
# Thompson's "Reflections on Trusting Trust" (1984): if the seed is
# compromised, every generation inherits the compromise.
#
# Each stage only has to be good enough to build the next: the seed
# only assembles cybs, cybs only has to compile cycc's source. Keeping
# each step's job narrow is what keeps the root small enough to audit.

fn test_chain_properties() {
    # Capability grows along the chain; size does not have to: the seed
    # (an assembler) is LARGER than the bootstrap compiler it assembles.
    assert(SEED_BYTES > CYBS_BYTES, "seed is not the smallest stage");
    assert(CYBS_BYTES < CYCC_BYTES, "cybs < cycc");
    assert(SEED_BYTES < CYCC_BYTES, "seed < cycc");

    # The seed must be small enough for a human to audit
    assert(SEED_BYTES < 50 * 1024, "seed is auditable (<50KB)");

    # Cross-compiler is similar size to native (same frontend, different backend)
    assert(CYCC_ARM_BYTES > CYCC_BYTES / 2, "cross-compiler is substantial");
    return 0;
}

# ================================================================
# Two-Pass Assembly — the seed pattern
# ================================================================
# Pass 1: scan instructions, collect label → offset map
# Pass 2: emit bytes with resolved addresses
#
# Why two passes? Forward jumps reference labels not yet seen.
# Pass 1 records where each label lands. Pass 2 uses that map.
#
# Instruction sizes (x86_64):
#   MOV r64, imm64  = 10 bytes (REX.W + opcode + 8-byte immediate)
#   ADD r64, r64    = 3 bytes  (REX.W + opcode + ModR/M)
#   JMP rel32       = 5 bytes  (opcode + 4-byte relative offset)
#   HLT             = 1 byte

var INST_SIZE_MOV = 10;
var INST_SIZE_ADD = 3;
var INST_SIZE_JMP = 5;
var INST_SIZE_HLT = 1;

fn test_instruction_sizes() {
    # A minimal program: MOV + MOV + ADD + JMP + HLT
    var total = INST_SIZE_MOV + INST_SIZE_MOV + INST_SIZE_ADD + INST_SIZE_JMP + INST_SIZE_HLT;
    assert_eq(total, 29, "minimal program is 29 bytes");

    # JMP relative offset = target - (current + 5)
    # Backward jump to offset 0 from offset 23: 0 - (23+5) = -28
    var jmp_offset = 0 - (23 + 5);
    assert_eq(jmp_offset, 0 - 28, "backward jump offset");
    return 0;
}

# ================================================================
# Self-Hosting Verification
# ================================================================
# The gold standard: compile the compiler with itself, compare outputs.
#   cat src/main.cyr | ./build/cycc > /tmp/c1 && chmod +x /tmp/c1
#   cat src/main.cyr | /tmp/c1 > /tmp/c2 && chmod +x /tmp/c2
#   cmp -s /tmp/c1 /tmp/c2    # must be byte-identical
#
# If c1 != c2, the compiler is not a fixed point — it doesn't
# faithfully reproduce itself. This catches codegen bugs.
#
# For heap-layout changes that may shift offsets, use a three-step or
# four-step bootstrap: chain from the prior released binary through
# several self-compile iterations until the output stabilizes. The
# final iteration must be byte-identical to its predecessor.

# A simulated compile: the output should be a pure function of the
# source. `embed_time` = 1 models a compiler that stamps the build time
# into its output (a __DATE__-style timestamp).
fn sim_compile(src, build_time, embed_time) {
    var out = src * 31 + 7;                  # stand-in for codegen
    if (embed_time == 1) { out = out + build_time; }
    return out;
}

fn test_self_hosting_properties() {
    # The fixed point is c1 == c2, where c1 = cycc(S) and c2 = c1(S): the
    # SAME source rebuilt by the NEW binary, at a different time. (It is
    # not f(f(x)) == f(x); the source is never compiled twice over.)
    var src = 0xDEAD;
    assert_eq(sim_compile(src, 1000, 0), sim_compile(src, 2000, 0),
              "deterministic compiler: a rebuild is byte-identical");

    # Non-deterministic compilation breaks self-hosting
    # (timestamps, ASLR, random padding — all must be eliminated)
    assert(sim_compile(src, 1000, 1) != sim_compile(src, 2000, 1),
           "an embedded build timestamp breaks the fixed point");
    return 0;
}

# ================================================================
# Cross-Compilation Chain
# ================================================================
# x86 cycc → cycc_aarch64 (cross-compiler, runs on x86, emits ARM)
# cycc_aarch64 → cycc-native-aarch64 (native, runs on ARM, emits ARM)
# Verification: cycc-native-aarch64 compiles itself → byte-identical
#
# This proves the cross-compiler is correct: it produces a native
# compiler that can reproduce itself on the target architecture.

# A chain is runnable only if each stage runs where the previous stage's
# output runs: host[i] == target[i - 1].
fn chain_runnable(hosts, targets, n) {
    var i = 1;
    while (i < n) {
        if (load64(hosts + i * 8) != load64(targets + (i - 1) * 8)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn test_cross_compilation() {
    var ARCH_X86 = 0;
    var ARCH_AARCH64 = 1;
    # cycc (x86→x86), cycc_aarch64 (x86→arm), cycc-native-aarch64 (arm→arm)
    var hosts: i64[3];
    var targets: i64[3];
    hosts[0] = ARCH_X86;     targets[0] = ARCH_X86;
    hosts[1] = ARCH_X86;     targets[1] = ARCH_AARCH64;
    hosts[2] = ARCH_AARCH64; targets[2] = ARCH_AARCH64;
    assert_eq(chain_runnable(&hosts, &targets, 3), 1, "x86 → cross → native chain runs");
    assert(hosts[1] != targets[1], "stage 1 is a cross-compiler");
    # Drop the cross step: an aarch64-hosted stage right after an x86-only one cannot run.
    hosts[1] = ARCH_AARCH64;
    assert_eq(chain_runnable(&hosts, &targets, 3), 0, "a stage whose host was never produced breaks the chain");
    return 0;
}

fn main() {
    alloc_init();
    test_chain_properties();
    test_instruction_sizes();
    test_self_hosting_properties();
    test_cross_compilation();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
