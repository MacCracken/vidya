# Cyrius Type System — runnable reference

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }
enum Color { RED; GREEN; BLUE; }
enum ErrCode { EOK = 0; ENOTFOUND = 44; }
fn ident<T>(x: T) { return x; }

fn main() {
    alloc_init();
    # i64 is the core type, and an `: i64` annotation changes no code. Other
    # annotations do: i8..u32 are stored at their width, f64/f32 make `+` a
    # float add, `*T` steps sizeof(T), a struct type is checked on copies.
    var x = 42;
    var y: i64 = 42;
    assert_eq(x, 42, "var");
    assert_eq(y, 42, "typed");
    var narrow: u8 = 300;           # stored at its width: 300 & 0xFF
    assert_eq(narrow, 44, "u8 wraps to its width");

    # Typed pointers — `var buf: i64[2]` is 2 i64 slots (16 bytes). A bare
    # fn-local `var buf[8]` would be 8 BYTES, and the +8 store would overflow.
    var buf: i64[2];
    store64(&buf, 10);
    store64(&buf + 8, 20);
    var p: *i64 = &buf;
    assert_eq(*(p + 0), 10, "ptr[0]");
    assert_eq(*(p + 1), 20, "ptr[1]");

    # Structs are values: a literal builds one, `.field` reads and writes it.
    var q = Pt { 10, 20 };
    assert_eq(q.x + q.y, 30, "struct");
    q.x = 42;
    assert_eq(q.x, 42, "field set");
    # A `p: *Pt` parameter reads `p.x` the same way. Each untyped field is
    # one 8-byte slot, so sizeof(Pt) is 16.
    assert_eq(sizeof(Pt), 16, "sizeof(Pt)");

    # Enums
    assert_eq(RED, 0, "enum auto");
    assert_eq(ENOTFOUND, 44, "enum val");

    # Generics — T is inferred from the argument and each instance is typed
    # by it (an f64 argument gets an f64 instance).
    assert_eq(ident(42), 42, "generic fn");

    # Floating point — an untyped var holds the IEEE 754 bits, so these
    # calls use the explicit f64_* builtins; a `var a: f64` makes `+` float.
    var a = f64_from(10);
    var b = f64_from(3);
    var c = f64_div(a, b);
    assert_eq(f64_to(c), 3, "f64 div trunc");
    var d = f64_mul(f64_from(6), f64_from(7));
    assert_eq(f64_to(d), 42, "f64 mul");
    assert_eq(f64_lt(f64_from(1), f64_from(2)), 1, "f64 lt");
    assert_eq(f64_gt(f64_from(2), f64_from(1)), 1, "f64 gt");
    assert_eq(f64_eq(f64_from(5), f64_from(5)), 1, "f64 eq");

    # Float literals
    var pi = 3.14;
    var two = f64_from(2);
    assert_eq(f64_to(f64_mul(pi, two)), 6, "float lit");

    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
