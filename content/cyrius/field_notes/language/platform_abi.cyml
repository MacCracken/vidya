# v6.7.12: +8 entries — sys_sigprocmask_works_on_macos_per_thread_v6712, xflock_on_windows_waits_and_answers_minus_11_v6712,
# getpwuid_zero_on_macos_is_root_since_6_7_12, windows_native_tls_trusts_what_the_chain_engine_trusts_minus_fetching_v6712,
# windows_symlink_long_paths_v6712, x86_64_epoll_event_is_packed_and_the_stride_is_the_layout_v6712,
