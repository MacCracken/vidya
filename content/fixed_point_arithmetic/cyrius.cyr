# Fixed-Point Arithmetic — Cyrius reference (runnable)
# 16.16 fixed-point: integer bits in upper 48, fraction in lower 16.
# Patterns: multiply, divide, overflow-safe mul, sine table, arithmetic shift.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

# --- Constants ---

var FX_SHIFT = 16;
var FX_ONE = 65536;          # 1.0 in 16.16
var FX_HALF = 32768;         # 0.5 in 16.16

# --- Core operations ---

fn fx_from_int(n) {
    return n << FX_SHIFT;
}

fn fx_to_int(v) {
    # Truncate toward zero
    if (v < 0) {
        return 0 - ((0 - v) >> FX_SHIFT);
    }
    return v >> FX_SHIFT;
}

fn fx_to_int_round(v) {
    # Round to nearest integer
    if (v < 0) {
        return 0 - ((0 - v + FX_HALF) >> FX_SHIFT);
    }
    return (v + FX_HALF) >> FX_SHIFT;
}

fn fx_mul(a, b) {
    # Standard multiply: (a * b) >>> 16
    # WARNING: overflows if |a| * |b| > 2^63
    #
    # >>> not >>. In Cyrius `>>` is LOGICAL (zero-fills) and `>>>` is
    # ARITHMETIC (sign-extends) — the opposite of C/Java, and the reason
    # this multiply spells the shift `>>>`. The product of two Q16.16 values is
    # signed, so a zero-filling shift turns every negative result into a
    # huge positive one: fx_mul(-3.0, 2.5) returned 281474976219136
    # instead of -491520. This is the exact defect the field note in
    # content/cyrius/ records as the DOOM black-screen bug.
    return (a * b) >>> FX_SHIFT;
}

fn fx_mul_safe(a, b) {
    # Overflow-safe multiply: pre-shift both inputs
    # Trades 8 bits of precision for overflow resistance
    return asr(a, 8) * asr(b, 8);
}

fn fx_div(a, b) {
    # Fixed-point divide: (a << 16) / b
    # Caller must ensure b != 0
    if (b == 0) { return 0; }
    return (a << FX_SHIFT) / b;
}

fn asr(v, n) {
    # Signed shift that rounds toward ZERO (-1 -> 0), keeping fixed-point
    # rounding symmetric. `>>>` is the true arithmetic shift, which floors
    # (-1 >>> 1 == -1); plain `>>` is logical and would zero-fill.
    if (v < 0) {
        return 0 - ((0 - v) >> n);
    }
    return v >> n;
}

# --- Sine table (quarter-wave, 257 entries: 0 .. π/2 INCLUSIVE) ---
# 257, not 256: the mirrors below read index 512 - a and 1024 - a, which
# reach 256 (= π/2) exactly. A 256-entry table has no π/2 endpoint and
# forces an off-by-one mirror (511 - a), putting half the circle one step
# out of phase.

var _sin_table: i64[257];
var _sin_init_done = 0;

fn sin_table_init() {
    # Bhaskara I approximation: sin(x) ≈ 16x(π-x) / (5π²-4x(π-x)),
    # max error ≈ 0.0016. Here π = 32768 units, so x = i * 64 walks
    # [0, π/2] inclusive as i goes 0..256; the result is scaled by FX_ONE.
    var pi = 32768;
    var i = 0;
    while (i <= 256) {
        var x = i * 64;
        var t = x * (pi - x);
        _sin_table[i] = (16 * t * FX_ONE) / (5 * pi * pi - 4 * t);
        i = i + 1;
    }
    _sin_init_done = 1;
}

fn sin_lookup(angle) {
    if (_sin_init_done == 0) { sin_table_init(); }
    # angle: 0-1023 where 1024 = full circle
    angle = angle & 1023;

    if (angle < 256) {
        # First quadrant: direct lookup
        return load64(&_sin_table + angle * 8);
    }
    if (angle < 512) {
        # Second quadrant: mirror, sin(π - x) = sin(x)
        return load64(&_sin_table + (512 - angle) * 8);
    }
    if (angle < 768) {
        # Third quadrant: negate first quadrant
        return 0 - load64(&_sin_table + (angle - 512) * 8);
    }
    # Fourth quadrant: negate mirror, sin(2π - x) = -sin(x)
    return 0 - load64(&_sin_table + (1024 - angle) * 8);
}

fn cos_lookup(angle) {
    return sin_lookup(angle + 256);
}

# --- Tests ---

fn test_fx_from_int() {
    assert_eq(fx_from_int(1), 65536, "1.0 == 65536");
    assert_eq(fx_from_int(10), 655360, "10.0 == 655360");
    assert_eq(fx_from_int(0), 0, "0.0 == 0");
    return 0;
}

fn test_fx_mul() {
    # 3.0 * 2.5 = 7.5
    var a = fx_from_int(3);             # 196608
    var b = 163840;                      # 2.5 in 16.16
    var result = fx_mul(a, b);
    assert_eq(result, 491520, "3.0 * 2.5 == 7.5 (491520)");

    # 1.0 * 1.0 = 1.0
    assert_eq(fx_mul(FX_ONE, FX_ONE), FX_ONE, "1.0 * 1.0 == 1.0");

    # 0.5 * 0.5 = 0.25
    var quarter = fx_mul(FX_HALF, FX_HALF);
    assert_eq(quarter, 16384, "0.5 * 0.5 == 0.25 (16384)");

    # NEGATIVE operands. Every case above is positive, and a zero-filling
    # shift is indistinguishable from an arithmetic one when the product is
    # positive — so a suite that never multiplies a negative cannot detect
    # the wrong shift operator at all. These three are the detection gap.
    assert_eq(fx_mul(0 - a, b), 0 - 491520, "-3.0 * 2.5 == -7.5");
    assert_eq(fx_mul(a, 0 - b), 0 - 491520, "3.0 * -2.5 == -7.5");
    assert_eq(fx_mul(0 - a, 0 - b), 491520, "-3.0 * -2.5 == +7.5");
    return 0;
}

fn test_fx_mul_safe() {
    # 1000.0 * 1000.0 — the raw product needs 52 bits, which would overflow
    # a 32-bit (or Q16.16-in-i32) multiply. Check the VALUE, not just the sign.
    var a = fx_from_int(1000);
    var b = fx_from_int(1000);
    var result = fx_mul_safe(a, b);
    assert_eq(result, fx_from_int(1000000), "safe mul of 1000.0*1000.0 == 1e6");
    return 0;
}

fn test_fx_div() {
    # 10.0 / 4.0 = 2.5
    var a = fx_from_int(10);
    var b = fx_from_int(4);
    var result = fx_div(a, b);
    assert_eq(result, 163840, "10.0 / 4.0 == 2.5 (163840)");

    # Division by zero returns 0
    assert_eq(fx_div(FX_ONE, 0), 0, "div by zero returns 0");
    return 0;
}

fn test_asr() {
    # asr keeps the sign and rounds toward zero
    assert_eq(asr(-256, 1), -128, "asr(-256, 1) == -128");
    assert_eq(asr(256, 1), 128, "asr(256, 1) == 128");
    assert_eq(asr(-1, 1), 0, "asr(-1, 1) == 0 (rounds toward zero)");
    assert_eq(-1 >>> 1, -1, "-1 >>> 1 == -1 (true arithmetic shift floors)");
    assert_eq(asr(0, 4), 0, "asr(0, 4) == 0");
    return 0;
}

fn test_sin_lookup() {
    sin_table_init();
    # sin(0) = 0
    assert_eq(sin_lookup(0), 0, "sin(0) == 0");

    # sin(256) ≈ 1.0 (peak of sine wave)
    var peak = sin_lookup(256);
    assert(peak > 60000, "sin(256) near 1.0");

    # sin(512) = 0 (half circle)
    assert_eq(sin_lookup(512), 0, "sin(512) == 0");

    # sin(768) ≈ -1.0
    var trough = sin_lookup(768);
    assert(trough < -60000, "sin(768) near -1.0");

    # cos(0) = sin(256) ≈ 1.0
    assert(cos_lookup(0) > 60000, "cos(0) near 1.0");

    # Mid-quadrant values: sin(45°) = 0.70711 -> 46341 in 16.16.
    var s45 = sin_lookup(128);
    assert(s45 > 46000, "sin(128) ~ 0.7071 (lower)");
    assert(s45 < 46700, "sin(128) ~ 0.7071 (upper)");
    # Mirror identities hold exactly, one step from the quadrant edges.
    assert_eq(sin_lookup(511), sin_lookup(1), "sin(pi - x) == sin(x)");
    assert_eq(sin_lookup(1023), 0 - sin_lookup(1), "sin(2pi - x) == -sin(x)");
    return 0;
}

fn test_roundtrip() {
    # Convert int → fixed → int should be identity
    var i = 0;
    while (i < 100) {
        var fx = fx_from_int(i);
        var back = fx_to_int(fx);
        assert_eq(back, i, "roundtrip");
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    test_fx_from_int();
    test_fx_mul();
    test_fx_mul_safe();
    test_fx_div();
    test_asr();
    test_sin_lookup();
    test_roundtrip();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
