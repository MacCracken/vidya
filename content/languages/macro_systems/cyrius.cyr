# Macro Systems — Cyrius reference (runnable)
#
# Cyrius has no macro system in the Rust sense: no macro_rules!, no
# procedural macros over token trees, no hygiene. What it does have:
#   1. #define NAME(a, b) ... — C-style function-like TEXT macros (main
#      source file only, at most 16 — cyrius-guide "Preprocessor limits")
#   2. const / enum — compile-time constants (`const` since 6.7.2)
#   3. #ifdef / #if / #elif / #endif — conditional compilation
#   4. #derive(accessors) / #derive(Serialize) — compiler-generated fns
#   5. Operator overloading — `a + b` on a struct dispatches to T_add
#   6. include — textual inclusion, include-once by spelling
#
# A function-like #define is textual substitution, exactly like C's:
# parenthesise every parameter and the whole body.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

# ================================================================
# include: textual file inclusion
# ================================================================
# include "path" pastes the file contents at that point — ONCE: a second
# include of the same spelling is skipped (include-once by spelling), so
# no header guards are needed. This file includes lib/string.cyr twice.
#
# Common pattern:
#   include "lib/string.cyr"   — standard library
#   include "lib/alloc.cyr"    — bump allocator
#   include "lib/assert.cyr"   — test assertions
#
# Each lib file defines functions that become globally visible, unless
# the file declares `private` (then only its `public` items are). A
# same-named fn is a `duplicate fn` warning and the LAST definition wins
# for every caller — which is why the gate treats it as a failure.

include "lib/string.cyr"           # second include: skipped, not redefined

# ================================================================
# enum: compile-time constants
# ================================================================
# Enums (and, since 6.7.2, `const NAME = expr;`) are compile-time
# constants. They take zero global variable slots and are resolved at
# compile time.

enum MacroConst {
    MAX_ITEMS = 100;
    VERSION = 178;
    FEATURE_LOGGING = 1;
}

fn test_constants() {
    assert_eq(MAX_ITEMS, 100, "enum constant");
    assert_eq(VERSION, 178, "version constant");
    assert_eq(FEATURE_LOGGING, 1, "feature flag");
    return 0;
}

# ================================================================
# Operator overloading as implicit dispatch
# ================================================================
# Cyrius allows operator overloading on structs. The compiler
# dispatches + to StructName_add, == to StructName_eq, etc.
# This is not a macro — it's implicit method dispatch by the compiler.
#
# Supported operators:
#   +  dispatches to StructName_add(self, other)
#   -  dispatches to StructName_sub(self, other)
#   *  dispatches to StructName_mul(self, other)
#   /  dispatches to StructName_div(self, other)

struct Vec2 { x; y; }

fn Vec2_add(a: Vec2, b: Vec2): Vec2 {
    var r: Vec2 = Vec2 { a.x + b.x, a.y + b.y };
    return r;
}

fn test_operator_overload() {
    var a = Vec2 { 1, 2 };
    var b = Vec2 { 3, 4 };
    var c = a + b;              # the compiler calls Vec2_add(a, b)
    assert_eq(c.x, 4, "vec2 add x");
    assert_eq(c.y, 6, "vec2 add y");
    return 0;
}

# ================================================================
# Function-like #define: textual substitution
# ================================================================
#define SQUARE(x) ((x) * (x))

fn test_function_like_macro() {
    assert_eq(SQUARE(7), 49, "SQUARE(7)");
    # The parentheses in the body are what make this 9, not 2 + 1*2 + 1 = 5.
    assert_eq(SQUARE(2 + 1), 9, "SQUARE(2 + 1) with a parenthesised body");
    return 0;
}

# ================================================================
# Code generation via convention (no macros needed)
# ================================================================
# Where Rust uses macros for code generation, Cyrius uses:
#   1. Functions — extract repeated patterns into functions
#   2. Vtable pattern — dynamic dispatch via function pointers
#   3. include — share code between files by textual inclusion
#   4. Naming conventions — StructName_method for methods
#
# Example: a "constructor + accessors" is just functions following
# the naming convention — written by hand below, or generated by the
# compiler with #derive(accessors) (Endpoint further down).

fn Config_new(host, port) {
    var cfg = alloc(16);
    store64(cfg, host);
    store64(cfg + 8, port);
    return cfg;
}

fn Config_host(cfg) { return load64(cfg); }
fn Config_port(cfg) { return load64(cfg + 8); }

fn test_convention_codegen() {
    var cfg = Config_new(8080, 443);
    assert_eq(Config_host(cfg), 8080, "cfg host");
    assert_eq(Config_port(cfg), 443, "cfg port");
    return 0;
}

# The same accessors, generated: #derive(accessors) emits
# Endpoint_host / Endpoint_set_host / Endpoint_port / Endpoint_set_port.
#derive(accessors)
struct Endpoint { host; port; }

fn test_derive_accessors() {
    var ep = alloc(16);
    Endpoint_set_host(ep, 8080);
    Endpoint_set_port(ep, 443);
    assert_eq(Endpoint_host(ep), 8080, "derived getter host");
    assert_eq(Endpoint_port(ep), 443, "derived getter port");
    return 0;
}

# ================================================================
# Comparison: what Cyrius does NOT have
# ================================================================
#   - No declarative macros (no macro_rules! equivalent)
#   - No procedural macros (no AST manipulation; #derive is built in)
#   - No hygiene (a #define body is pasted as text)
#   - No variadic macros (but fns may be variadic, `fn f(n, ...)`, and
#     take defaults / named arguments since 6.7.7)
#   - No token pasting (no ## operator)
#   - No stringify (no # operator)
#
# The tradeoff: simpler compiler, simpler mental model.
# The cost: more boilerplate, naming discipline required.

fn main() {
    alloc_init();
    test_constants();
    test_operator_overload();
    test_function_like_macro();
    test_convention_codegen();
    test_derive_accessors();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
