# Module Systems — Cyrius reference (runnable)
#
# Cyrius's module system is small and mostly textual:
#   1. include — paste file contents at the inclusion point, include-once
#      by spelling (a repeated include of the same path is skipped)
#   2. `private` / `public` — a file that declares `private` exposes only
#      its `public` items; calling a private fn from another file is a
#      compile error ("'helper' is private to its file")
#   3. `mod m;` + `use m.f;` — fns after `mod m;` are named m_f, and
#      `use m.f;` binds the bare name f to it
#   4. cyrius deps — [deps.NAME] git tags in cyrius.cyml, resolved into
#      lib/ and pinned by SHA in cyrius.lock
#   5. Name collision avoidance — Module_ / _ prefixes by convention
#
# There is no namespace per file: without `private`, every name is
# global, so naming discipline still matters.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

# ================================================================
# include: textual inclusion (no module boundary)
# ================================================================
# `include "path"` reads the file and inserts its contents.
# What it does and does not do:
#   - Include-once: a second `include` of the same spelling is skipped
#     (this file includes lib/str.cyr twice; "./a.cyr" and "a.cyr" are
#     two spellings)
#   - No namespace isolation (all names are global unless `private`)
#   - No selective import (you get everything in the file)
#   - Paths resolve against the build's working directory; `cyrius build`
#     adds the entry file's directory (#@incdir, v6.5.7)
#
# Compare to Rust:
#   include "lib/string.cyr"   ≈  use crate::string::*;
#   (textual, not semantic; privacy is per file, opt-in)
#
# Order does NOT limit calls: a fn may call one defined later in the
# file or in a later include (test_forward_call below).

include "lib/str.cyr"              # repeated spelling: skipped

# ================================================================
# Vendored lib/ pattern
# ================================================================
# The standard "library" is a set of .cyr files in lib/:
#   lib/string.cyr  — C-string + memory ops (strlen, streq, memcpy, memset)
#   lib/str.cyr     — the Str type (str_from, str_len, str_eq, ...)
#   lib/fmt.cyr     — formatted output (fmt_int, fmt_hex, fmt_sprintf)
#   lib/alloc.cyr   — bump allocator (alloc, alloc_reset)
#   lib/assert.cyr  — test assertions (assert, assert_eq)
#   lib/vec.cyr     — dynamic array (vec_new, vec_push, vec_get)
#   lib/tagged.cyr  — tagged unions (Ok, Err, Some, None)
#
# Each project vendors these files into its own lib/: `cyrius lib sync`
# copies the [deps] stdlib subset from the pinned toolchain, and
# `cyrius deps` resolves [deps.NAME] git dependencies at their tags.
# cyrius.lock pins every vendored file by hash, so a build is
# self-contained and reproducible.

fn test_lib_available() {
    # Verify standard lib functions are available via include
    var s = "hello";
    assert_eq(strlen(s), 5, "strlen from lib/string.cyr");

    var buf = alloc(8);
    store64(buf, 42);
    assert_eq(load64(buf), 42, "alloc from lib/alloc.cyr");
    return 0;
}

# ================================================================
# Name collision avoidance: _ prefix convention
# ================================================================
# In a file without `private`, all names are global, so collisions are
# the programmer's responsibility. Convention:
#   _helper      — internal (by convention; `private` enforces it)
#   ModuleName_func — namespaced to a logical module
#   LIB_CONSTANT — library-level constant
#
# This is like C's naming convention: prefix everything.

# "Private" helper — underscore prefix signals internal use
fn _config_validate(port) {
    if (port < 1) { return 0; }
    if (port > 65535) { return 0; }
    return 1;
}

# "Public" API — no prefix needed for the main module
fn config_new(host, port) {
    if (_config_validate(port) == 0) { return 0; }
    var cfg = alloc(16);
    store64(cfg, host);
    store64(cfg + 8, port);
    return cfg;
}

fn config_host(cfg) { return load64(cfg); }
fn config_port(cfg) { return load64(cfg + 8); }

fn test_namespace_convention() {
    var cfg = config_new("localhost", 8080);
    assert(cfg != 0, "config created");
    assert(streq(config_host(cfg), "localhost") == 1, "cfg host");
    assert_eq(config_port(cfg), 8080, "cfg port");

    # Invalid port returns null (0)
    var bad = config_new("host", 0 - 1);
    assert_eq(bad, 0, "invalid port rejected");
    return 0;
}

# ================================================================
# Multi-file simulation: separate "modules"
# ================================================================
# In a real Cyrius project, these would be separate files:
#   math_utils.cyr   — included first
#   string_utils.cyr — included second
#   main.cyr         — includes both, uses their functions
#
# Order matters: math_utils functions must be defined before
# string_utils if string_utils calls them.

# --- math_utils "module" ---
fn math_abs(x) {
    if (x < 0) { return 0 - x; }
    return x;
}

fn math_max(a, b) {
    if (a > b) { return a; }
    return b;
}

fn math_clamp(x, lo, hi) {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

# --- logger "module" ---
var _log_count = 0;
var _log_min_level = 0;

fn logger_init(min_level) {
    _log_count = 0;
    _log_min_level = min_level;
    return 0;
}

fn logger_log(level, msg) {
    if (level >= _log_min_level) {
        _log_count = _log_count + 1;
    }
    return 0;
}

fn logger_count() {
    return _log_count;
}

# A call to a fn defined further down the file compiles: fns are known
# before bodies are compiled, so definition order is not call order.
fn test_forward_call() {
    assert_eq(defined_below(4), 40, "forward call to a later fn");
    return 0;
}

fn test_multi_module() {
    # Math module
    assert_eq(math_abs(0 - 42), 42, "abs negative");
    assert_eq(math_abs(42), 42, "abs positive");
    assert_eq(math_max(3, 7), 7, "max");
    assert_eq(math_clamp(15, 0, 10), 10, "clamp high");
    assert_eq(math_clamp(0 - 5, 0, 10), 0, "clamp low");

    # Logger module
    logger_init(2);  # min level = WARN
    logger_log(0, "debug");   # ignored
    logger_log(1, "info");    # ignored
    logger_log(2, "warn");    # logged
    logger_log(3, "error");   # logged
    assert_eq(logger_count(), 2, "logger filtered");
    return 0;
}

# ================================================================
# What Cyrius does NOT have (vs Rust)
# ================================================================
#   - Visibility is per FILE (`private` / `public`), not pub(crate) /
#     pub(super) per item path
#   - `mod m;` prefixes names; it does not nest or open a scope
#   - `use m.f;` aliases one fn; there is no glob import or re-export
#   - No crate boundary — a dependency is a vendored file in lib/
#
# The tradeoff: a tiny module system.
# The cost: outside `private` files, naming discipline is the
# encapsulation tool.

var MOD_USE_RESULT = 0;

fn test_mod_use() {
    assert_eq(geo_area(3, 4), 12, "fn after `mod geo;` is geo_area");
    assert_eq(MOD_USE_RESULT, 12, "`use geo.area;` binds the bare name");
    return 0;
}

fn main() {
    alloc_init();
    test_lib_available();
    test_namespace_convention();
    test_forward_call();
    test_multi_module();
    test_mod_use();
    return assert_summary();
}

fn defined_below(x) { return x * 10; }

# `mod geo;` names every fn after it geo_*; keep it last.
mod geo;
fn area(w, h) { return w * h; }
use geo.area;
MOD_USE_RESULT = area(3, 4);
var exit_code = main();
syscall(60, exit_code);
