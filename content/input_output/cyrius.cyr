# Input/Output — Cyrius reference (runnable)
# Patterns: file I/O, read/write, file_exists

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"

fn test_write_read() {
    var path = "/tmp/cyr_io_test";
    var msg = "hello cyrius";
    # file_write_all returns len, or a negative errno (a short write is an error).
    assert_eq(file_write_all(path, msg, 12), 12, "wrote 12 bytes");

    # TRAP: file_read_all's third argument must be the CAPACITY OF THE BUFFER:
    # it reads until EOF or until it has that many bytes, whichever comes
    # first. Passing a number larger than the buffer is an overflow waiting
    # for a bigger file: `var rbuf[16]` is 16 bytes (fn-local bare arrays are
    # byte-sized), so a 128 here smashes 112 bytes of neighbouring frame the
    # moment the file grows past 16. Always pass the declared size — and a
    # return equal to it may mean the file was LONGER (truncated read).
    var rbuf[16];
    var n = file_read_all(path, &rbuf, 16);
    assert_eq(n, 12, "read len");
    assert(memeq(&rbuf, msg, 12) == 1, "read data");

    # cleanup
    syscall(87, path);
    return 0;
}

fn test_file_exists() {
    var path2 = "/tmp/cyr_io_exist";
    assert_eq(file_write_all(path2, "x", 1), 1, "wrote marker file");
    assert(file_exists(path2) == 1, "exists yes");
    syscall(87, path2);
    assert(file_exists(path2) == 0, "exists no");
    return 0;
}

fn test_open_flags() {
    assert_eq(O_RDONLY, 0, "O_RDONLY");
    assert_eq(O_WRONLY, 1, "O_WRONLY");
    assert_eq(O_CREAT, 64, "O_CREAT");
    return 0;
}

# === Network sockets (lib/net.cyr) ===
# These return a Result (a tag, value PAIR since 6.6.0): bind both halves and
# check the tag. `result_unwrap(tcp_socket())` is a compile error
# ('result_unwrap' expects 2 arguments, got 1).
# var st, sfd = tcp_socket();
# if (is_err_result(st) == 1) { return 1; }
# sock_reuse(sfd);
# var bt, bv = sock_bind(sfd, INADDR_ANY(), 8080);
# var lt, lv = sock_listen(sfd, 16);
# var at, cfd = sock_accept(sfd);
# var wt, wn = sock_send(cfd, "hello\n", 6);
# sock_close(cfd);
# sock_close(sfd);

# === Filesystem walker (lib/fs.cyr) ===
# var files = dir_list(str_from("."));        — list directory
# var all = vec_new();
# dir_walk(str_from("src"), all);             — recursive walk
# var cyrs = find_files(str_from("."), ".cyr"); — find by extension
# var base = path_basename(str_from("/usr/bin/cc2")); — "cc2"
# var dir = path_dirname(str_from("/usr/bin/cc2"));   — "/usr/bin"

# === Process management (lib/process.cyr) — each returns a Result pair ===
# var rt, status = run("/usr/bin/ls", "-la", 0);           — run + wait
# var pt, pid = spawn("/usr/bin/sleep", "1", 0);           — background
# var wt, code = wait_pid(pid);                            — wait for specific pid
# var buf = alloc(4096);
# var ct, n = run_capture("/usr/bin/uname", "-a", 0, buf, 4096);

fn main() {
    alloc_init();
    test_write_read();
    test_file_exists();
    test_open_flags();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
