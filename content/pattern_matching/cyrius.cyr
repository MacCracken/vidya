# Pattern Matching — Cyrius reference (runnable)
# Patterns: switch, if/elif, tagged union matching, comparisons as values

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"
include "lib/tagged.cyr"

enum Op { OP_ADD = 0; OP_SUB = 1; OP_MUL = 2; }

fn calc(op, a, b) {
    switch (op) {
        case 0: return a + b;
        case 1: return a - b;
        case 2: return a * b;
        default: return 0;
    }
    return 0;
}

fn classify(x) {
    if (x < 0) { return 0 - 1; }
    elif (x == 0) { return 0; }
    elif (x < 10) { return 1; }
    else { return 2; }
    return 0;
}

fn test_switch() {
    assert_eq(calc(OP_ADD, 3, 4), 7, "add");
    assert_eq(calc(OP_SUB, 10, 3), 7, "sub");
    assert_eq(calc(OP_MUL, 5, 6), 30, "mul");
    assert_eq(calc(99, 1, 2), 0, "default");
    return 0;
}

fn test_elif() {
    assert_eq(classify(0 - 5), 0 - 1, "negative");
    assert_eq(classify(0), 0, "zero");
    assert_eq(classify(5), 1, "small");
    assert_eq(classify(50), 2, "large");
    return 0;
}

fn test_tagged_match() {
    # Matching on the value form: the TAG selects the arm, the PAYLOAD is already
    # in hand as the second binding. `payload()` was RETIRED at v6.6.0 — there is
    # nothing to call, because destructuring already gave you the value.
    var rt, rv = Ok(42);
    var val = 0;
    if (is_ok(rt) == 1) { val = result_unwrap(rt, rv); }
    assert_eq(val, 42, "ok match");

    var et, ev = Err(7);
    var code = 0;
    if (is_err_result(et) == 1) { code = ev; }
    assert_eq(code, 7, "err match");
    return 0;
}

fn test_option_match() {
    # `Some(v)` binds as a pair; `None()` is nullary, so a lone binding is correct
    # there and only there. `unwrap_or` now takes (tag, value, fallback).
    var st, sv = Some(99);
    var nt = None();
    assert_eq(unwrap_or(st, sv, 0), 99, "some or");
    assert_eq(unwrap_or(nt, 0, 0), 0, "none or");
    return 0;
}

fn test_comp_values() {
    # Comparisons are values: exactly 1 when true, 0 when false — usable
    # as function arguments and in arithmetic.
    var x = 42;
    assert_eq(x > 10, 1, "comp gt is 1");
    assert_eq(x == 41, 0, "false comparison is 0");
    assert_eq((x != 2) + (x < 0), 1, "comparisons add as 0/1");
    return 0;
}

# Match expression — cleaner syntax than switch
#
# Renamed from `classify` to `classify_match`. Two functions with the same
# name in one file compile with only a `duplicate fn` warning, and since
# 6.6.20 EVERY call binds to the LAST definition — so test_elif's calls to
# classify() would silently run this body instead and fail. (Before 6.6.20
# binding was positional: a call got whichever body preceded it.)
fn classify_match(n) {
    match n {
        0 => { return 0; }
        1 => { return 10; }
        42 => { return 42; }
        _ => { return 99; }
    }
    return 0;
}

fn test_match() {
    assert_eq(classify_match(0), 0, "match 0");
    assert_eq(classify_match(42), 42, "match 42");
    assert_eq(classify_match(7), 99, "match default");
    return 0;
}

# For-in range loops
fn test_for_in() {
    var sum = 0;
    for i in 0..5 {
        sum = sum + i;
    }
    assert_eq(sum, 10, "for-in 0..5");

    var count = 0;
    for j in 1..4 {
        count = count + 1;
    }
    assert_eq(count, 3, "for-in count");
    return 0;
}

fn main() {
    alloc_init();
    test_switch();
    test_elif();
    test_tagged_match();
    test_option_match();
    test_comp_values();
    test_match();
    test_for_in();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
