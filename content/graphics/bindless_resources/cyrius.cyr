# Vidya — Bindless Resources — Cyrius reference (runnable)
#
# In-memory descriptor table — the "one global table per frame" pattern
# from concept.toml's first BP. Each table slot stores a u64 descriptor
# (an opaque resource handle, e.g. a GPU virtual address). Slot 0 is
# reserved as the null sentinel (matching the page_management gotcha).
# Free list is a stack — freed slot stores the next-freed slot ID; head
# in a global. O(1) alloc / O(1) free with no external data structure.
#
# A handle is (generation << 8) | slot, never the raw slot index. Freeing
# a slot bumps its generation, so a handle kept after free_handle no longer
# matches and is rejected instead of silently reading whatever descriptor
# reuses the slot (concept.toml: "an invalid handle detects the generation
# mismatch rather than reading a freed slot"). A double free is rejected
# the same way, so the free list can never point at itself.
#
# Tests:
#   1. Sequential alloc returns increasing slots (1, 2, 3, ...).
#   2. Slot 0 is never returned (null-sentinel reserved).
#   3. Lookup returns the descriptor written at allocation time.
#   4. Update (rebind) replaces the descriptor without changing the handle.
#   5. Free + alloc reuses the slot (free list LIFO) under a NEW handle;
#      the stale handle reads 0, cannot update, and cannot be freed twice.
#   6. Capacity exhaustion returns 0 (the null sentinel = "no slot").

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

var TABLE_CAP = 64;
var SLOT_BYTES = 8;             # one i64 per descriptor

# Descriptor table: TABLE_CAP i64 slots (64 * 8 = 512 bytes). Slot 0 reserved.
var table: i64[64];
var next_id = 1;                # bump pointer; slot 0 reserved
var free_head = 0;              # 0 = empty free list
var free_links: i64[64];        # parallel array; freed slot stores next-free slot
var slot_gen: i64[64];          # current generation of each slot
var slot_live: i64[64];         # 1 = slot holds a live allocation

fn table_init() {
    memset(&table, 0, TABLE_CAP * SLOT_BYTES);
    memset(&free_links, 0, TABLE_CAP * SLOT_BYTES);
    memset(&slot_live, 0, TABLE_CAP * SLOT_BYTES);
    var i = 0;
    while (i < TABLE_CAP) { slot_gen[i] = 1; i = i + 1; }
    next_id = 1;
    free_head = 0;
    return 0;
}

fn make_handle(slot) { return (slot_gen[slot] << 8) | slot; }

# handle → slot, or 0 if the handle is null, out of range, freed or stale.
fn handle_slot(h) {
    var slot = h & 0xFF;
    if (slot == 0) { return 0; }
    if (slot >= TABLE_CAP) { return 0; }
    if (slot_live[slot] != 1) { return 0; }
    if ((h >> 8) != slot_gen[slot]) { return 0; }
    return slot;
}

# alloc_handle(descriptor) — returns a handle, or 0 if exhausted.
fn alloc_handle(desc) {
    var slot = 0;
    if (free_head != 0) {
        slot = free_head;
        free_head = load64(&free_links + slot * 8);
    } else {
        if (next_id >= TABLE_CAP) {
            return 0;             # exhausted
        }
        slot = next_id;
        next_id = next_id + 1;
    }
    slot_live[slot] = 1;
    store64(&table + slot * 8, desc);
    return make_handle(slot);
}

# update_handle(handle, descriptor) — replaces descriptor at slot.
fn update_handle(h, desc) {
    var slot = handle_slot(h);
    if (slot == 0) { return 0; }
    store64(&table + slot * 8, desc);
    return 1;
}

fn lookup_handle(h) {
    var slot = handle_slot(h);
    if (slot == 0) { return 0; }
    return load64(&table + slot * 8);
}

fn free_handle(h) {
    var slot = handle_slot(h);
    if (slot == 0) { return 0; }      # stale handle or double free
    slot_live[slot] = 0;
    slot_gen[slot] = slot_gen[slot] + 1;
    store64(&free_links + slot * 8, free_head);
    free_head = slot;
    store64(&table + slot * 8, 0);
    return 1;
}

fn main() {
    alloc_init();
    table_init();

    test_group("bindless_resources");

    # --- Test 1: sequential alloc returns increasing slots starting at 1 ---
    var id1 = alloc_handle(0x1111111111111111);
    var id2 = alloc_handle(0x2222222222222222);
    var id3 = alloc_handle(0x3333333333333333);
    assert_eq(id1 & 0xFF, 1, "first alloc = slot 1");
    assert_eq(id2 & 0xFF, 2, "second alloc = slot 2");
    assert_eq(id3 & 0xFF, 3, "third alloc = slot 3");

    # --- Test 2: slot 0 is reserved (lookup_handle(0) returns 0) ---
    assert_eq(lookup_handle(0), 0, "slot 0 reserved");

    # --- Test 3: lookup returns the descriptor ---
    assert_eq(lookup_handle(id1), 0x1111111111111111, "lookup id1");
    assert_eq(lookup_handle(id2), 0x2222222222222222, "lookup id2");
    assert_eq(lookup_handle(id3), 0x3333333333333333, "lookup id3");

    # --- Test 4: update replaces descriptor without changing the handle ---
    var ok = update_handle(id2, 0xAAAAAAAAAAAAAAAA);
    assert_eq(ok, 1, "update_handle returns 1 on success");
    assert_eq(lookup_handle(id2), 0xAAAAAAAAAAAAAAAA, "id2 holds new desc");
    assert_eq(lookup_handle(id1), 0x1111111111111111, "id1 unchanged");
    assert_eq(lookup_handle(id3), 0x3333333333333333, "id3 unchanged");

    # --- Test 5: free + alloc reuses the slot under a new generation ---
    assert_eq(free_handle(id2), 1, "free id2");
    assert_eq(lookup_handle(id2), 0, "freed handle reads as 0");
    var id4 = alloc_handle(0x4444444444444444);
    assert_eq(id4 & 0xFF, id2 & 0xFF, "alloc reuses the freed slot (LIFO)");
    assert_neq(id4, id2, "reused slot gets a new handle (generation bumped)");
    assert_eq(lookup_handle(id4), 0x4444444444444444, "reused slot has new desc");
    assert_eq(lookup_handle(id2), 0, "stale handle does NOT see the new descriptor");
    assert_eq(update_handle(id2, 0x5555), 0, "stale handle cannot rebind");
    assert_eq(free_handle(id2), 0, "double free rejected");
    assert_eq(lookup_handle(id4), 0x4444444444444444, "live handle unharmed by stale ops");

    # --- Test 6: exhaustion returns 0 ---
    table_init();
    var allocated = 0;
    var i = 1;
    while (i < TABLE_CAP) {
        if (alloc_handle(i) == 0) { break; }
        allocated = allocated + 1;
        i = i + 1;
    }
    assert_eq(allocated, TABLE_CAP - 1, "slots 1..63 all allocate");
    var overflow = alloc_handle(0xDEADBEEF);
    assert_eq(overflow, 0, "exhausted table returns 0");

    return assert_summary();
}

var r = main();
syscall(SYS_EXIT, r);
