# State Machines — Cyrius reference (runnable)
# Finite state machines with enum dispatch, committed states, timers,
# transition validation, and hierarchical game/player state.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

# --- Player state enum ---
# (Enums are kept to one line here for compactness; multi-line enum and
# struct bodies parse just as well.)
enum PlayerState { PS_IDLE = 0; PS_RUN = 1; PS_SHOOT = 2; PS_DUNK = 3; PS_PASS = 4; PS_STEAL = 5; PS_BLOCK = 6; PS_FALL = 7; PS_REBOUND = 8; }

# --- Game state enum ---
enum GameState { GS_MENU = 0; GS_SELECT = 1; GS_TIPOFF = 2; GS_PLAYING = 3; GS_HALFTIME = 4; GS_OVERTIME = 5; GS_GAMEOVER = 6; GS_ATTRACT = 7; }

# --- Input enum ---
enum Input { INPUT_NONE = 0; INPUT_MOVE = 1; INPUT_SHOOT = 2; INPUT_PASS = 3; INPUT_STEAL = 4; }

# --- Committed state durations (frames at 60fps) ---
var SHOOT_FRAMES = 30;    # 0.5s
var DUNK_FRAMES = 45;     # 0.75s
var FALL_FRAMES = 20;     # 0.33s

# --- Player state machine ---

struct Player { state; prev_state; timer; }

fn player_new() {
    # TRAP: the obvious body here is
    #     var p = Player { PS_IDLE, PS_IDLE, 0 }; return &p;
    # and it compiles clean. It is the C bug: `p` lives in this function's
    # stack frame, so `&p` dangles the moment we return, and the next call
    # reuses that stack and silently overwrites the Player (measured: an
    # escaped &local read 4242, then 0 after one unrelated call). Heap the
    # storage so each call owns its own object, or return the struct by
    # value (`var t: Player = Player { .. }; return t;`). (Tests below still
    # build `var p = Player { … }` inline in their own scope, which is fine —
    # one object, one owner.)
    var p = alloc(24);              # 3 fields * 8 bytes
    if (p == 0) { return 0; }
    store64(p, PS_IDLE);
    store64(p + 8, PS_IDLE);
    store64(p + 16, 0);
    return p;
}

fn is_committed(state) {
    if (state == PS_SHOOT) { return 1; }
    if (state == PS_DUNK) { return 1; }
    if (state == PS_FALL) { return 1; }
    return 0;
}

fn player_transition(p, input) {
    var ptr: *i64 = p;
    var state = *ptr;
    var timer = *(ptr + 2);

    # Reject input during committed states with active timer
    if (is_committed(state) == 1) {
        if (timer > 0) {
            return state;
        }
    }

    # Save previous state for transition detection
    *(ptr + 1) = state;

    # Dispatch on input
    if (input == INPUT_MOVE) {
        *ptr = PS_RUN;
        return PS_RUN;
    }
    if (input == INPUT_SHOOT) {
        *ptr = PS_SHOOT;
        *(ptr + 2) = SHOOT_FRAMES;
        return PS_SHOOT;
    }
    if (input == INPUT_PASS) {
        *ptr = PS_PASS;
        return PS_PASS;
    }
    if (input == INPUT_STEAL) {
        *ptr = PS_STEAL;
        return PS_STEAL;
    }

    # No valid input → idle
    *ptr = PS_IDLE;
    return PS_IDLE;
}

fn player_tick(p) {
    var ptr: *i64 = p;
    var timer = *(ptr + 2);

    if (timer > 0) {
        timer = timer - 1;
        *(ptr + 2) = timer;

        if (timer == 0) {
            # Committed state expired → return to idle
            *(ptr + 1) = *ptr;   # save prev_state
            *ptr = PS_IDLE;
        }
    }
}

fn player_did_transition(p) {
    var ptr: *i64 = p;
    if (*ptr != *(ptr + 1)) { return 1; }
    return 0;
}

# --- Tests ---

fn test_idle_to_run() {
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    player_transition(&p, INPUT_MOVE);

    var ptr: *i64 = &p;
    assert_eq(*ptr, PS_RUN, "idle -> run on move input");
    return 0;
}

fn test_shoot_committed() {
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    player_transition(&p, INPUT_SHOOT);

    var ptr: *i64 = &p;
    assert_eq(*ptr, PS_SHOOT, "entered shoot state");

    # Try to move during shoot — should be rejected
    player_transition(&p, INPUT_MOVE);
    assert_eq(*ptr, PS_SHOOT, "shoot rejects move input (committed)");

    # Try to pass during shoot — also rejected
    player_transition(&p, INPUT_PASS);
    assert_eq(*ptr, PS_SHOOT, "shoot rejects pass input (committed)");
    return 0;
}

fn test_timer_expiry() {
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    player_transition(&p, INPUT_SHOOT);

    # Tick through all frames
    var i = 0;
    while (i < SHOOT_FRAMES) {
        player_tick(&p);
        i = i + 1;
    }

    var ptr: *i64 = &p;
    assert_eq(*ptr, PS_IDLE, "shoot -> idle after timer expires");
    assert_eq(*(ptr + 2), 0, "timer is zero after expiry");
    return 0;
}

fn test_dunk_committed() {
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    var ptr: *i64 = &p;

    # Manually set dunk state (normally set by game logic, not input)
    *ptr = PS_DUNK;
    *(ptr + 2) = DUNK_FRAMES;

    # Input during dunk — rejected
    player_transition(&p, INPUT_MOVE);
    assert_eq(*ptr, PS_DUNK, "dunk rejects input for 45 frames");

    # Tick to completion
    var i = 0;
    while (i < DUNK_FRAMES) {
        player_tick(&p);
        i = i + 1;
    }
    assert_eq(*ptr, PS_IDLE, "dunk -> idle after 45 frames");
    return 0;
}

fn test_transition_detection() {
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    var ptr: *i64 = &p;

    # Initial state: no transition
    assert_eq(player_did_transition(&p), 0, "no transition initially");

    # Transition to run
    player_transition(&p, INPUT_MOVE);
    assert_eq(player_did_transition(&p), 1, "idle->run is a transition");
    assert_eq(*(ptr + 1), PS_IDLE, "prev_state is idle");

    # Same input again: prev_state updates to RUN
    player_transition(&p, INPUT_MOVE);
    assert_eq(player_did_transition(&p), 0, "run->run is not a transition");
    return 0;
}

# --- Game state machine: an explicit transition table ---
# Only the listed edges are legal; anything else is rejected and the
# state is unchanged (transition validation).
fn game_can_transition(from, to) {
    if (from == GS_MENU) {
        if (to == GS_SELECT) { return 1; }
        if (to == GS_ATTRACT) { return 1; }
    }
    if (from == GS_ATTRACT) { if (to == GS_MENU) { return 1; } }
    if (from == GS_SELECT) { if (to == GS_TIPOFF) { return 1; } }
    if (from == GS_TIPOFF) { if (to == GS_PLAYING) { return 1; } }
    if (from == GS_PLAYING) {
        if (to == GS_HALFTIME) { return 1; }
        if (to == GS_OVERTIME) { return 1; }
        if (to == GS_GAMEOVER) { return 1; }
    }
    if (from == GS_HALFTIME) { if (to == GS_PLAYING) { return 1; } }
    if (from == GS_OVERTIME) { if (to == GS_GAMEOVER) { return 1; } }
    if (from == GS_GAMEOVER) { if (to == GS_MENU) { return 1; } }
    return 0;
}

# Returns the new state, or `cur` unchanged if the edge is illegal.
fn game_transition(cur, to) {
    if (game_can_transition(cur, to) == 1) { return to; }
    return cur;
}

fn test_game_state_progression() {
    var game = GS_MENU;

    # Menu -> Select -> Tipoff -> Playing -> Halftime -> Playing -> Gameover
    game = game_transition(game, GS_SELECT);
    assert_eq(game, GS_SELECT, "menu -> select");
    game = game_transition(game, GS_TIPOFF);
    assert_eq(game, GS_TIPOFF, "select -> tipoff");
    game = game_transition(game, GS_PLAYING);
    assert_eq(game, GS_PLAYING, "tipoff -> playing");
    game = game_transition(game, GS_HALFTIME);
    assert_eq(game, GS_HALFTIME, "playing -> halftime");
    game = game_transition(game, GS_PLAYING);
    assert_eq(game, GS_PLAYING, "halftime -> playing (2nd half)");
    game = game_transition(game, GS_GAMEOVER);
    assert_eq(game, GS_GAMEOVER, "playing -> gameover");

    # Illegal edges are rejected and leave the state alone.
    assert_eq(game_transition(GS_MENU, GS_PLAYING), GS_MENU, "menu -/-> playing (skips select/tipoff)");
    assert_eq(game_transition(GS_GAMEOVER, GS_HALFTIME), GS_GAMEOVER, "gameover -/-> halftime");
    assert_eq(game_transition(GS_HALFTIME, GS_GAMEOVER), GS_HALFTIME, "halftime -/-> gameover");
    return 0;
}

fn test_committed_then_free() {
    # After a committed state expires, the player should accept input again
    var p = Player { PS_IDLE, PS_IDLE, 0 };
    player_transition(&p, INPUT_SHOOT);

    # Tick through shoot
    var i = 0;
    while (i < SHOOT_FRAMES) {
        player_tick(&p);
        i = i + 1;
    }

    # Now should accept move
    player_transition(&p, INPUT_MOVE);
    var ptr: *i64 = &p;
    assert_eq(*ptr, PS_RUN, "accepts input after committed state expires");
    return 0;
}

fn main() {
    alloc_init();
    test_idle_to_run();
    test_shoot_committed();
    test_timer_expiry();
    test_dunk_committed();
    test_transition_detection();
    test_game_state_progression();
    test_committed_then_free();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
