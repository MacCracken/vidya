# Build artifacts
/target/
rust-old/target/
*.rlib

# Compiled binaries. `build/vidya` was TRACKED through 2.8.0 — a 14.6 MB blob
# over 20 revisions, which release.yml's `git archive HEAD` then packed into
# every checksummed *-src.tar.gz (the tarball zugot's recipe pins). A 2.8.1
# source tarball would otherwise ship a stale executable 5.7x larger than the
# one that tag actually builds. No sibling AGNOS repo tracks its binary.
# NOTE: this rule alone does not untrack it — run `git rm --cached build/vidya`.
build/
!build/.gitkeep

# Cyrius lib/ and lockfile are build artifacts. Mirrors sit's convention.
# Rehydrate with `cyrius lib sync` (stdlib, from the cyrius.cyml pin) then
# `cyrius deps` (the [deps.<name>] git deps). NOT `cyrius update` — under
# wrapper/pin drift that pulls the wrapper's version, not the pinned one.
lib/
cyrius.lock

# Agent worktrees + local session state. Matches sit / sandhi / hoosh /
# sakshi, none of which track anything under .claude/. Without this, a
# `git add -A` from the repo root commits each live worktree directory as
# a 160000 gitlink pointing at a branch that gets deleted with the session
# — which is exactly what happened at 519792e / 418248c.
.claude/

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Debugging
*.pdb
*.core
qemu_*.core
core.*
# core.* (core dumps) accidentally swallowed this real content file — re-include it.
!content/cyrius/language/core.cyml

# Coverage
lcov.info
tarpaulin-report.html
coverage/

# Benchmark output
criterion/

# Proptest persistence
proptest-regressions/

# cargo-vet downloads
supply-chain/.cache/

# Environment / secrets
.env
.env.*

# Python virtual environment
.venv/

# Python bytecode from validating content/*/python.py
__pycache__/
*.pyc
