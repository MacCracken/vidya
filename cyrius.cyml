[package]
name = "vidya"
version = "${file:VERSION}"
description = "vidya — programming reference library and queryable corpus"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/vidya"
language = "cyrius"
cyrius = "6.4.2"

[build]
entry = "src/main.cyr"
output = "build/vidya"

[deps]
# Transitive stdlib resolution doesn't follow through enum / constant
# references — sandhi pulls TLS_EARLY_DATA_*, fdlopen_*, base64_encode
# (via tls/ws shim transitives). All explicit until the cyrius
# transitive arc closes those follow-through gaps.
#
# cyrius 6.1.x consolidated the former standalone `json`, `toml`, and
# `base64` stdlib modules into the bundled `bayan` distlib module — the
# old per-module `lib/{json,toml,base64}.cyr` no longer ship, so a clean
# `cyrius lib sync` would 404 on them. Matches sit / hoosh.
#
# cyrius 6.2.x→6.4.x refolds grew sandhi's transitive surface: the TLS
# path (`lib/tls_native_lowlevel.cyr`) now calls `sha384_init_into` from
# `sigil` (which itself pulls `ct` + `keccak`), `fdlopen` calls
# `dynlib_auxv_get`/`dynlib_read_auxv` from `dynlib`, and sandhi's
# keep-alive path calls `clock_now_ns`/`clock_now_ms` from `chrono`.
# These follow-through refs aren't auto-resolved (the cyrius transitive
# arc doesn't chase enum/const/refold-added call sites), so `chrono`,
# `dynlib`, `sigil`, `ct`, `keccak` are listed explicitly — same stack
# sit vendors for its sandhi+TLS consumer. Kept minimal: `async_*` stays
# unreachable-undefined (vidya's `serve` is synchronous) and DCE-pruned.
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "hashmap",
    "io",
    "fs",
    "chrono",
    "tagged",
    "bayan",
    "ct",
    "keccak",
    "sigil",
    "fnptr",
    "args",
    "regex",
    "net",
    "dynlib",
    "tls",
    "fdlopen",
    "sandhi",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.4.4"
modules = ["dist/sakshi.cyr"]

# vyakarana 2.0.0 removed `tokenize_source` in favor of the
# streaming API (`tokenize_stream_new/feed/finish/free`).
# Migration recipe in vyakarana/docs/adr/0017-streaming-api.md.
[deps.vyakarana]
git = "https://github.com/MacCracken/vyakarana.git"
tag = "2.2.3"
modules = ["dist/vyakarana.cyr"]
