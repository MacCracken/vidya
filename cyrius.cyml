[package]
name = "vidya"
version = "${file:VERSION}"
description = "vidya — programming reference library and queryable corpus"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/vidya"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/vidya"

[deps]
# Transitive stdlib resolution doesn't follow through enum / constant
# references — sandhi pulls TLS_EARLY_DATA_*, fdlopen_*, base64_encode
# (via tls/ws shim transitives). All explicit until the cyrius
# transitive arc closes those follow-through gaps.
#
# cyrius 6.1.x consolidated the former standalone `json`, `toml`, and
# `base64` stdlib modules into the bundled `bayan` distlib module — the
# old per-module `lib/{json,toml,base64}.cyr` no longer ship, so a clean
# `cyrius lib sync` would 404 on them. Matches sit / hoosh.
#
# cyrius 6.2.x→6.4.x refolds grew sandhi's transitive surface: the TLS
# path (`lib/tls_native_lowlevel.cyr`) now calls `sha384_init_into` from
# `sigil` (which itself pulls `ct` + `keccak`), `fdlopen` calls
# `dynlib_auxv_get`/`dynlib_read_auxv` from `dynlib`, and sandhi's
# keep-alive path calls `clock_now_ns`/`clock_now_ms` from `chrono`.
# These follow-through refs aren't auto-resolved (the cyrius transitive
# arc doesn't chase enum/const/refold-added call sites), so `chrono`,
# `dynlib`, `sigil`, `ct`, `keccak` are listed explicitly — same stack
# sit vendors for its sandhi+TLS consumer. Kept minimal: `async_*` stays
# unreachable-undefined (vidya's `serve` is synchronous) and DCE-pruned.
#
# Re-measured at the 6.5.29 pin (2.8.1): the arc HAS caught up for three of
# those five. Dropping `ct`, `keccak`, `sigil` still vendors the same 62
# modules and still builds clean (binary 4,080 B smaller), so those three
# declarations are now redundant rather than load-bearing. `chrono` and
# `dynlib` remain hard requirements — removing either is a build error.
# The three are kept anyway, deliberately: an undeclared module of this
# class fails at RUNTIME, not at build time (sit's `random` module made
# `sit key generate` SIGILL exactly this way), and 4 KB is not worth the
# exposure to a future refold the arc misses. Revisit if the arc's
# follow-through is ever contractual rather than observed.
#
# ── 6.5.35 (2.8.4): the declared set is unchanged, the vendored set is not ──
# The whole 102-module snapshot is byte-identical 6.5.31 → 6.5.35 except
# three files, and only ONE of them — `bayan` — is declared here. It nearly
# TRIPLED (215,533 → 641,083 B) absorbing a PDF subsystem (`_pdfc_*` /
# `_pdfe_*` / `_pdff_*` / `_pdfg_*`, +368 fns). vidya touches bayan only for
# TOML + JSON, so every byte of that is unreachable — and cyrius does NOT
# run DCE by default, so it SHIPS: unreachable fns 2,546 → 2,931, and the
# binary 2,564,472 → 2,772,568 B (+208,096, +8.1%). Isolated by building the
# 6.5.35 compiler against the 6.5.31 lib: 2,548,088 B, i.e. band F's regalloc
# work made the binary 16,384 B SMALLER and the stdlib growth added 224,480
# on top. Accepted for 2.8.4 rather than worked around — `CYRIUS_DCE=1` is a
# build-wide behavior change, not a per-module opt-out, and the corpus loader
# is the hot path we would be experimenting on. Revisit if bayan grows again.
#
# `lib/` also went 62 → 63 files: `assert.cyr` is now vendored. It is not
# newly declared and neither `sakshi` nor `alloc` changed content — the
# transitive arc simply started chasing `sakshi`'s `panic()` and `alloc`'s
# `fail_after_n_allocs()` into it. Note what it is: a TEST assertion library,
# now linked into the shipped binary. Harmless (DCE-dead, and `panic` is a
# real fatal path) but worth knowing it is there.
#
# ── 6.6.20 (2.8.6): declared set unchanged, 59 of 65 vendored files moved ──
# A wide snapshot this time, not one module: every declared module except
# `ct` changed content 6.6.2 → 6.6.20 (folds: bayan 1.5.5 → 1.5.12, sandhi
# 1.9.16 → 1.10.8, sigil 3.12.16 → 3.13.10, sakshi 2.5.1 → 2.5.7). Biggest
# source growth: sigil +211,769 B, tls +51,743, bayan +42,110, process
# +35,709, net +35,493, io +34,300, sandhi +32,822. Binary 2,457,488 →
# 2,683,032 B (+225,544, +9.2%). Attributed with a synthetic CYRIUS_HOME
# (6.6.20 bin over the 6.6.2 lib): 2,449,288 B — the compiler made it 8,200 B
# SMALLER and the snapshot added 233,744 on top. Unreachable bytes
# 979,196 → 1,075,594; `CYRIUS_DCE=1` builds 1,605,784 B. Accepted for the
# same reason as 6.5.35's bayan growth.
#
# `lib/` went 65 → 73 files, all transitive: `async` (+ `_agnos`/`_macos`/
# `_win`, via sandhi), `random` + `sys` (via sigil), `tls_hostid` (via tls),
# `alloc_cx` + `poison` (via alloc). `assert.cyr` is gone again. Side effect:
# the five long-expected `undefined function` warnings (`random_bytes`,
# `async_*`) no longer fire — their definers are now vendored, DCE-dead.
#
# ⚠ At 6.6.20 the pin bump MUST be a clean rehydrate:
#   rm -rf lib cyrius.lock && cyrius lib sync && cyrius deps
# In place, `lib sync` refreshes only the declared subset and re-locks, then
# `cyrius deps` REFUSES 15 transitive leaves still holding 6.6.2 content
# ("cyrius.lock and the pinned stdlib snapshot DISAGREE"). `deps --relock`
# gets past it but keeps the orphaned 6.6.2 `assert.cyr` vendored and locked.
#
# ── 6.7.15 (2.9.0): the 6.7 language minor, no source change needed ──
# Declared set unchanged (25). Folds: bayan 1.5.12 → 1.9.0, sandhi 1.10.8 →
# 1.13.1, sigil 3.13.10 → 3.13.12, sakshi 2.5.7 → 2.5.10. `lib/` 73 → 75
# entries: `math.cyr` and a `unicode/` directory (casefold / categories /
# normalize tables, 353 KB of source), both pulled in by bayan 1.9.0. bayan
# is the growth again (+180,407 B source). Binary 2,683,032 → 2,820,176 B
# (+137,144, +5.1 %; 2,762,208 shipped after 2.9.0 right-sized two
# top-level arrays), split three ways with scratch builds: the 6.7.15
# compiler over the 6.6.20 lib is 2,674,840 B (−8,192), the 6.7.15 snapshot
# with vyakarana 2.4.3 is 2,897,752 (+222,912), and vyakarana 2.9.1 takes
# 77,576 back. Static data FELL 515,728 → 193,664 B (sigil's 256 KiB bank
# buffer is gone from .bss).
#
# ⚠ `lib/math.cyr` defines `gcd` / `lcm`, and `cyrius run` prepends this
# manifest's stdlib to every content example: content/fundamentals/algorithms/cyrius.cyr's
# own `fn gcd` became a duplicate-fn shadow, which the gate fails on. It
# now uses `gcd_euclid`. Any future stdlib addition can do the same to a content
# example that names a function the way the stdlib does.
#
# `cyrius lib sync` still copies `hashmap_fast.cyr` (a declared-subset
# sibling), but `cyrius deps` no longer resolves it, so every resolve prints
# "1 file in lib/ is outside the declared footprint". It is harmless: lib/ is
# gitignored and CI recreates the same state.
#
# ⚠ Never run two cyrius commands in this tree at once: every `cyrius run` /
# `build` re-resolves [deps.vyakarana] and moves lib/vyakarana.cyr out and
# back while it does. A `cyrius build` alongside validate-content.sh failed
# with "cannot hash lib/vyakarana.cyr (errno 2)". Still true at 6.7.18.
#
# ── 6.7.18 (2.9.1): declared set unchanged, one API rename ──
# Folds: bayan 1.9.0 → 1.11.1, sandhi 1.13.1 → 1.13.7, sigil 3.13.12 →
# 3.13.15; sakshi stays 2.5.10 (byte-identical). `lib/` stays 75 entries,
# the same file set: 39 files changed, 42 byte-identical. Source growth:
# bayan +81,966 B, sigil +45,117, sandhi +42,200, the TLS handshake files
# +22,909. Binary 2,762,208 → 2,937,144 B (+174,936, +6.3 %), split with
# scratch builds: the 6.7.18 compiler over the 6.7.15 lib is 2,762,208 B
# (compiler 0), the 6.7.18 snapshot with vyakarana 2.9.1 is 2,863,424
# (stdlib +101,216), and vyakarana 2.10.0 adds 73,720.
#
# bayan 1.11.0 deprecated the bare TOML lookups, so every call warns:
# `toml_get` → `bayan_toml_get_by_cstr`, `toml_get_sections` →
# `bayan_toml_get_sections_by_cstr` (35 call sites in src/ and tests/). The
# old names are one-line pass-throughs to the new ones, so behaviour is
# identical. Every key is a literal, so `_by_cstr` is right. `toml_parse` and
# `toml_section_pairs` are plain aliases, not deprecated. bayan 1.11.1's other
# changes (JSON duplicate-key, number and base64 refusals) cannot reach
# vidya, which parses only TOML.
#
# The migration guide says a hand-written include list needs lib/slice.cyr and
# lib/hashseed.cyr before lib/bayan.cyr, and lib/slice.cyr before
# lib/sandhi.cyr. vidya builds from this manifest's [deps] stdlib, which
# resolves them, so src/main.cyr's include lines did not need them.
#
# ── `sakshi` lives HERE as of 2.8.1, not in a `[deps.sakshi]` git block ──
# cyrius folded sakshi into the stdlib snapshot at 6.5.24 (`lib/sakshi.cyr`
# ships with the toolchain), making it a stdlib leaf. Through 2.8.0 vidya
# still declared it as a git dep at tag 2.4.4, which was actively wrong:
# `cyrius deps` overlays a git dep's resolution ON TOP of the folded
# snapshot on every build, so the 2.4.4 file *replaced* the toolchain's
# 2.4.10 — a silent DOWNGRADE that also emitted `duplicate fn
# 'sakshi_span_enter' / 'sakshi_span_exit' (last definition wins)`
# warnings, and pushed the stale copy at anything reaching vidya
# transitively. `deps --verify` can't catch it: the lock is written FROM
# DISK, so it records the hash of the downgraded file. sit hit this same
# trap and dropped its pin for exactly this reason (see sit's cyrius.cyml
# [deps] comment). ⚠ Do NOT re-add `[deps.sakshi]` — pinning sakshi means
# pinning the toolchain, and the `cyrius` pin in [package] is that lever.
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "hashmap",
    "io",
    "fs",
    # `process` — exec_cmd() for `vidya validate`. It was already
    # on disk as someone else's transitive; declared here because an
    # undeclared module is the class that fails at RUNTIME, not at build.
    "process",
    "chrono",
    "tagged",
    "bayan",
    "ct",
    "keccak",
    "sigil",
    "fnptr",
    "args",
    "regex",
    "net",
    "dynlib",
    "tls",
    "fdlopen",
    "sandhi",
    "sakshi",
]

# vyakarana 2.0.0 removed `tokenize_source` in favor of the
# streaming API (`tokenize_stream_new/feed/finish/free`).
# Migration recipe in vyakarana/docs/adr/0017-streaming-api.md.
#
# NOT folded into the cyrius stdlib snapshot (unlike sakshi), so it stays
# a git dep. 2.3.0 moved vyakarana's own pin 6.1.24 → 6.5.4 and re-cut its
# vendored lib/; 2.3.1–2.3.2 are tokenizer-correctness patches (TK_ERROR
# adjudication across 37 grammars) with no token-layout or public-API
# change — `code` highlighting gains accuracy, calls are unchanged.
#
# 2.3.2 → 2.4.0 at vidya 2.8.4. The MINOR is because streaming token
# BOUNDARIES change: 2.4.0 fixed five root causes that made a chunk-fed
# consumer disagree with a whole-buffer consumer on 13 of 20 corpus files.
# vidya is not one of those consumers — `render_code` in src/vidya_core.cyr
# feeds the entire file in a single `tokenize_stream_feed` and then calls
# `_finish`, which is the whole-buffer path 2.4.0 corrects the chunked path
# AGAINST. So the fixes are inert here by construction, and the public API
# (`tokenize_stream_new` / `_feed` / `_finish` / `_free`, `tokenbuf_*`,
# `kind_name`) is unchanged — no call-site edit.
#
# 2.4.0 → 2.4.3 at vidya 2.8.6 — the last tag on the 6.6.20 pin (2.5.0 moves
# to 6.7.9). 2.4.1 / 2.4.3 are its own toolchain bumps (6.6.2, 6.6.20) with
# no source change; 2.4.2 renames the private `_stream_grow` →
# `_vyk_stream_grow` (it collided with sankoch's — not vendored here). At
# 2.4.3 the bundle gains a `# Requires` block and its `.deps` sidecar names
# 4 leaves instead of 11, dropping `args` / `assert` / `fs` / `hashmap` —
# vidya declares the three it uses itself, so nothing was riding on it.
# Public API unchanged; `vidya code` output byte-identical across all 847
# examples.
#
# 2.4.3 → 2.9.1 at vidya 2.9.0. Every tag 2.5.1–2.9.1 pins cyrius 6.7.15,
# so this is the newest one on that pin. Public API unchanged (no call-site
# edit) through five minors, but TOKEN BOUNDARIES move on purpose: 2.6.0
# (shell `$N`, heredocs, mid-word `#`), 2.7.0 (`2.0` / `1e5` / `1_000` are
# one `number`, not `2` `.` `0`), 2.7.1 (12 grammars, e.g. `b"…"` is one
# string), 2.9.1 (markdown fences). So `vidya code` colours 287 of 847
# examples differently — all 77 OpenQASM files among them — with the plain
# text byte-identical in every one. 2.9.0 compacted the embedded grammars:
# the bundle is 38,978 B smaller as source, and vidya's binary 77,576 B
# smaller. 2.8.0's chunk-invariance work stays inert here (one
# `tokenize_stream_feed` per file).
#
# 2.9.1 → 2.10.0 at vidya 2.9.1, the newest tag. Every tag 2.9.2–2.10.0 pins
# cyrius 6.7.18. No token kind, `Token` layout or public-API change, so no
# call-site edit. 2.9.11 adds a document API (`tokenize_doc_*`, incremental
# retokenization) that vidya does not call. Two minors change `vidya code`
# colouring: 2.9.7's type suffixes (`0u64`, `1ULL`, `0j`, `0n` are one
# `number`) and 2.9.3's block comments (a TypeScript `/** … */` came back as
# operators; 26 of them in 7 files). Together they change 78 of 847 examples (rust 37,
# typescript 22, c 18, python 1), with the plain text byte-identical in every
# one. The bundle grew 362,193 → 473,365 B of source (+111,172) and vidya's
# binary by 73,720 B.
[deps.vyakarana]
git = "https://github.com/MacCracken/vyakarana.git"
tag = "2.10.0"
modules = ["dist/vyakarana.cyr"]
